# Database
DATABASE_URL="postgresql://ipnext:ipnext_secret@localhost:5432/ipnext"

# Splynx API
SPLYNX_API_URL=https://splynx.ipnext.com.ar
SPLYNX_API_KEY=your-api-key
SPLYNX_API_SECRET=your-api-secret

# Auth
JWT_SECRET=change-me-in-production
# SDD #6a security-hardening. PROD MUST set COOKIE_SECURE=true (cookie over HTTPS only).
# Decoupled from NODE_ENV (prod runs NODE_ENV=development).
COOKIE_SECURE=false
# Allowed CORS origin for the SPA (credentials enabled).
CORS_ORIGIN=http://localhost:5173

# Server
PORT=3000
NODE_ENV=development

# Prisma — set to true to enable query-level logging (default: off)
# Use this instead of relying on NODE_ENV since prod may run with NODE_ENV=development
PRISMA_LOG_QUERIES=false

# Gestión Real — read-only mirror sync (opt-in; leave disabled to keep current behavior)
GR_SYNC_ENABLED=false
GR_BASE_URL=https://api.gestionreal.com.ar/
GR_CUIT=
GR_SECRET=
GR_SYNC_INTERVAL_MS=180000
# estado codes to sync. Default (when unset) is the full universe: 1,2,3,4,6
# (1=Activo, 2=Deudor, 3=Inactivo, 4=Incobrable, 6=Baja). Override to narrow scope.
GR_SYNC_ESTADOS=1,2,3,4,6

# Gestión Real — debtor balance refresh
# Minutes before a debtor balance is considered stale; triggers on-demand refresh in GET /clients/:id
BALANCE_STALE_TTL_MINUTES=60
# Max ms for on-demand GR balance request before falling back to stored value
BALANCE_REFRESH_TIMEOUT_MS=4000
# Interval (ms) for the batch debtor balance refresh job (default: 1h)
GR_BALANCE_BATCH_INTERVAL_MS=3600000

# IClass Field Service integration (opt-in; on/off lives in the FeatureFlag table,
# these are just the upstream credentials used when the "iclass-integration" flag is ON)
ICLASS_BASE_URL=https://api-v2.iclass.com.br
ICLASS_USERNAME=
ICLASS_PASSWORD=
# IPNEXT third-party id (used to list nodes/microáreas)
ICLASS_THIRD_PARTY_ID=6808841

# IClass SEAM portal (closure-loop photo scraper; opt-in, photo URLs + signature)
ICLASS_PORTAL_BASE_URL=https://fs2.iclass.com.br
ICLASS_PORTAL_USER=
ICLASS_PORTAL_PASSWORD=

# Device-photo OCR (closure loop F4; opt-in). Local Ollama vision model.
ICLASS_OCR_ENABLED=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
OCR_MODEL=gemma3:12b
# Per-image inference timeout (ms). On a slow CPU model, raise it. Abort → soft-fail to manual review.
OCR_TIMEOUT_MS=120000

# AI installation audit (closure loop F6). Local Ollama vision model.
# El on/off NO vive en el env: lo controla el feature flag `iclass-audit`
# (default OFF, toggleable desde la UI). Estas vars solo configuran el modelo.
# (reusa OLLAMA_BASE_URL de arriba)
AUDIT_MODEL=qwen2.5vl:7b
AUDIT_TIMEOUT_MS=180000

# RouterOS API — PPPoE management (épico pppoe-service, Fase B). Mismo usuario para los 13
# routers; la IP/puerto salen del NasServer. Server-side: NUNCA al browser. Opt-in (no fail-fast).
ROUTER_API_USER=
ROUTER_API_PASSWORD=
