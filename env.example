# Database
DATABASE_URL="postgresql://ipnext:ipnext_secret@localhost:5432/ipnext"

# Splynx API
SPLYNX_API_URL=https://splynx.ipnext.com.ar
SPLYNX_API_KEY=your-api-key
SPLYNX_API_SECRET=your-api-secret

# Auth
JWT_SECRET=change-me-in-production
# SDD #6a security-hardening. PROD MUST set COOKIE_SECURE=true (cookie over HTTPS only).
# Decoupled from NODE_ENV (prod runs NODE_ENV=development).
COOKIE_SECURE=false
# Allowed CORS origin for the SPA (credentials enabled).
CORS_ORIGIN=http://localhost:5173

# Server
PORT=3000
NODE_ENV=development

# Prisma — set to true to enable query-level logging (default: off)
# Use this instead of relying on NODE_ENV since prod may run with NODE_ENV=development
PRISMA_LOG_QUERIES=false

# Gestión Real — read-only mirror sync (opt-in; leave disabled to keep current behavior)
GR_SYNC_ENABLED=false
GR_BASE_URL=https://api.gestionreal.com.ar/
GR_CUIT=
GR_SECRET=
GR_SYNC_INTERVAL_MS=180000
# estado codes to sync. Default (when unset) is the full universe: 1,2,3,4,6
# (1=Activo, 2=Deudor, 3=Inactivo, 4=Incobrable, 6=Baja). Override to narrow scope.
GR_SYNC_ESTADOS=1,2,3,4,6

# Gestión Real — debtor balance refresh
# Minutes before a debtor balance is considered stale; triggers on-demand refresh in GET /clients/:id
BALANCE_STALE_TTL_MINUTES=60
# Max ms for on-demand GR balance request before falling back to stored value
BALANCE_REFRESH_TIMEOUT_MS=4000
# Interval (ms) for the batch debtor balance refresh job (default: 1h)
GR_BALANCE_BATCH_INTERVAL_MS=3600000

# IClass Field Service integration (opt-in; on/off lives in the FeatureFlag table,
# these are just the upstream credentials used when the "iclass-integration" flag is ON)
ICLASS_BASE_URL=https://api-v2.iclass.com.br
ICLASS_USERNAME=
ICLASS_PASSWORD=
# IPNEXT third-party id (used to list nodes/microáreas)
ICLASS_THIRD_PARTY_ID=6808841

# IClass SEAM portal (closure-loop photo scraper; opt-in, photo URLs + signature)
ICLASS_PORTAL_BASE_URL=https://fs2.iclass.com.br
ICLASS_PORTAL_USER=
ICLASS_PORTAL_PASSWORD=

# Device-photo OCR (closure loop F4; opt-in). Local Ollama vision model.
ICLASS_OCR_ENABLED=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
OCR_MODEL=gemma3:12b
# Per-image inference timeout (ms). On a slow CPU model, raise it. Abort → soft-fail to manual review.
OCR_TIMEOUT_MS=120000

# AI installation audit (closure loop F6). Local Ollama vision model.
# El on/off NO vive en el env: lo controla el feature flag `iclass-audit`
# (default OFF, toggleable desde la UI). Estas vars solo configuran el modelo.
# (reusa OLLAMA_BASE_URL de arriba)
AUDIT_MODEL=qwen2.5vl:7b
AUDIT_TIMEOUT_MS=180000

# RouterOS API — PPPoE management (épico pppoe-service, Fase B). Mismo usuario para los 13
# routers; la IP/puerto salen del NasServer. Server-side: NUNCA al browser. Opt-in (no fail-fast).
ROUTER_API_USER=
ROUTER_API_PASSWORD=
# Fase C (cortes): profile de reducción para deudores. Default IP-REDUCCION (ya existe en los routers).
ROUTER_REDUCED_PROFILE=IP-REDUCCION
# Fase C (corte masivo): throttle entre ops del mismo router (ms) + routers en paralelo. Conservador por default.
ROUTER_BULK_THROTTLE_MS=300
ROUTER_BULK_CONCURRENCY=8

# PPPoE ingest — exclusión de usernames placeholder del RADIUS (usuarios internos del ISP).
# Comma-separated list de patrones regex (case-insensitive). Default: ^accesosur\d+$
# Para deshabilitar la exclusión: dejar vacío.
PPPOE_INGEST_EXCLUDE_PATTERN=^accesosur\d+$

# airOS SSH — detección de equipos del cliente via inspección SSH de antenas Ubiquiti airOS.
# Opt-in: si no se configuran, la inspección retorna warnings (best-effort). NO exponer en el browser.
# AIROS_SSH_USER: usuario SSH de las antenas (default: ubnt)
AIROS_SSH_USER=ubnt
# AIROS_SSH_PASSWORDS: contraseñas a probar en orden (comma-separated). Vacío = prueba solo 'ubnt'.
# En producción, cargar desde secretos del servidor. NUNCA commitear contraseñas reales.
AIROS_SSH_PASSWORDS=

# RADIUS auth ingest (radpostauth) — frescura del scheduler de errores de auth.
# Opt-in/best-effort: NUNCA tumba el boot. Default 60000 (1 min), mínimo de seguridad 15000 (15s)
# para no martillar al orchestrator. Inválido/ausente → default; por debajo del mínimo → se clampa al mínimo.
RADIUS_AUTH_INGEST_INTERVAL_MS=60000

# PPPoE auto-move watcher (pppoe-move-nas W2 / D-W2.5) — el ON/OFF real vive en el feature flag
# 'pppoe-auto-move' (tabla FeatureFlag, default OFF, toggleable desde la Config UI sin deploy);
# estas envs solo CALIBRAN el tick. Parse seguro en todas: inválida/vacía → default, JAMÁS
# tumban el boot.
# Intervalo del tick (ms). Default 120000 (2 min), piso 15s, techo 24h.
AUTO_MOVE_INTERVAL_MS=120000
# Circuit breaker: más mismatches que esto en UN tick → tick ABORTADO entero sin mover nada
# (huele a error de inventario: NAS duplicado / nasIpAddress mal editada). Default 25.
AUTO_MOVE_ABORT_THRESHOLD=25
# Cap de moves por tick: a lo sumo N moves; el resto queda deferred para el próximo tick. Default 10.
AUTO_MOVE_MAX_MOVES_PER_TICK=10
# Cooldown anti-revert (ms): si el último evento 'moved' del username (cualquier trigger) es más
# nuevo que esto, el watcher NO mueve (evita deshacer un move manual recién hecho). Default 600000 (10 min).
AUTO_MOVE_COOLDOWN_MS=600000
# Freshness de la sesión ganadora (ms): sin actividad más reciente que esto NO se actúa →
# outcome skipped_stale_session (el wire de /sessions no trae acctupdatetime; se usa startedAt).
# Default 259200000 (72h), piso 1h.
AUTO_MOVE_SESSION_FRESHNESS_MS=259200000

# External API v1 — API-key para acceso máquina-a-máquina a /api/external/v1 (opt-in, NO fail-fast).
# Si está vacío o no está seteada, la API externa retorna 401 para todas las requests.
# En producción: cargar desde secretos del servidor. NUNCA commitear la key real.
EXTERNAL_API_KEY=
