// task-photos — fotos/adjuntos de una ScheduledTask (galería). Espejo de
// TaskCommentAttachment, pero el binario vive en el storage (MinIO/FileStorage) bajo
// `storageKey` (no una url pública). onDelete: Cascade ⟹ al borrar la tarea se borran
// sus filas de adjunto (el binario lo limpia el use case vía FileStorage).
model ScheduledTaskAttachment {
  id           String        @id @default(uuid())
  taskId       String
  task         ScheduledTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  storageKey   String
  filename     String
  mimeType     String
  sizeBytes    Int
  width        Int?
  height       Int?
  uploadedById String
  createdAt    DateTime      @default(now())

  @@index([taskId])
}

// portal-ticket-messaging (v2.B) — quién puede escribir un TicketComment y quién
// puede VERLO. Dos dimensiones cerradas y chicas (2 valores cada una) — a
// diferencia de TicketStatus (catálogo dinámico administrable, por eso String),
// estas son binarias y estructurales al invariante central de la feature: un
// typo de mayúsculas ("Public" vs "public") en un String hubiera podido saltear
// silenciosamente el WHERE que protege el portal. Un enum de Prisma lo vuelve
// imposible a nivel de tipo/columna — mismo criterio que TicketPriority (enum,
// cerrado) vs TicketStatus (String, catálogo abierto).
enum TicketCommentAuthorKind {
  client
  staff
}

enum TicketCommentVisibility {
  public
  internal
}

// #44 — Conversación persistida de tickets con adjuntos inline (espejo de TaskComment).
// v2.B (portal-ticket-messaging) — ganó autoría (authorKind/authorId) y visibilidad
// (visibility). INVARIANTE CENTRAL: visibility=internal NUNCA sale por /api/portal/*;
// se filtra en la QUERY del repositorio (WHERE), no en el mapper.
model TicketComment {
  id          String                    @id @default(uuid())
  ticketId    String
  ticket      Ticket                    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorName  String
  // v2.B — quién escribió. Polimórfico A PROPÓSITO (PortalAccount.id si
  // authorKind=client, RbacUser.id si authorKind=staff): la tabla destino
  // difiere según el kind, así que NO hay una única FK posible sin partir el
  // campo en dos columnas nullable. Se deja como String simple sin FK — la
  // integridad referencial la garantiza el código que lo escribe (los use
  // cases nunca leen authorId de fuera, siempre lo estampan ellos mismos desde
  // la sesión/token), no la base. Null en comentarios viejos (backfill) y en
  // cualquier alta que no tenga un id de autor resoluble.
  authorId    String?
  // G5→G12 (fix wave, corrección de orden de deploy): F6 agregó
  // @default(staff)/@default(internal) acá para espejar el DEFAULT que la
  // migración 20261029000000_ticket_messaging agrega en el ADD COLUMN —
  // protege el INSERT del código VIEJO durante la ventana de deploy (entre
  // que `migrate deploy` corre y el swap del container termina, el código
  // viejo, que no conoce estas columnas, puede seguir insertando
  // TicketComment sin especificarlas; sin DEFAULT esa ventana revienta con
  // NOT NULL violation → 500 en POST /api/tickets/:id/comments).
  //
  // G5 había intentado sacar el DEFAULT en ESTE MISMO release agregando una
  // migración de seguimiento (20261029000100_ticket_comment_drop_defaults)
  // que hacía DROP DEFAULT — pero `prisma migrate deploy` aplica TODAS las
  // migraciones pendientes de una sola pasada, ANTES del swap. Con las dos
  // migraciones en la misma branch, el DEFAULT se agregaba y se borraba en
  // el MISMO deploy, reabriendo exactamente la ventana que estaba destinado
  // a proteger. Por eso el DEFAULT queda EN el schema ahora — es la única
  // forma de que sobreviva hasta después del swap.
  //
  // ✅ SALDADO (2026-08-01, migración 20261101000000_ticket_comment_drop_defaults):
  // los @default se SACARON, en un release aparte y DESPUÉS de que el código
  // que siempre los estampa llevara 3 deploys corriendo en prod. La condición
  // del plan ("una vez que el código de ESTE release ya esté en TODAS las
  // instancias") estaba cumplida; verificado además que hay UN SOLO escritor
  // (`PrismaTicketCommentRepository.create`), que los 3 use cases que lo
  // llaman estampan literales FIJOS (`AddTicketComment` staff/internal,
  // `SendStaffTicketReply` staff/public, `SendPortalTicketMessage`
  // client/public) y que no existe ningún INSERT por SQL crudo.
  //
  // POR QUÉ el DEFAULT permanente era un peligro: con @default, estos dos
  // campos quedan OPCIONALES para siempre en el input de `create` de Prisma —
  // un `create` futuro que se olvide de pasar authorKind compila igual y
  // estampa 'staff' en silencio, dejando un mensaje del CLIENTE mal-etiquetado
  // como staff (no cuenta en countUnread y se muestra como si lo hubiera
  // escrito soporte). Ahora ese olvido es un error de TIPOS, no un dato
  // corrupto en silencio.
  //
  // NO volver a agregarlos: `ticketCommentNoDefaults.schema.test.ts` falla si
  // alguien los reintroduce.
  authorKind  TicketCommentAuthorKind
  visibility  TicketCommentVisibility
  body        String
  createdAt   DateTime                  @default(now())
  attachments TicketCommentAttachment[]

  @@index([ticketId])
  // v2.B — la query que protege el invariante central filtra por (ticketId,
  // visibility) en cada request del portal; el índice compuesto la sirve sin
  // scan completo del hilo del ticket.
  @@index([ticketId, visibility])
}

// v2.B (portal-ticket-messaging) — ganó storageKey/kind para adjuntos de la NUEVA
// mensajería (foto/audio/video), guardados en MinIO vía el patrón BE-proxy
// (espejo de NewsPostAttachment: storageKey != null para binarios propios).
// `url` se conserva para los adjuntos VIEJOS del sistema de notas internas
// (data-URI base64 embebida en la columna, ver ticketComments.dto.ts) — ambos
// mecanismos conviven en la misma tabla; storageKey != null identifica un
// adjunto de la mensajería nueva, url != null uno del sistema viejo. Nunca
// ambos a la vez.
model TicketCommentAttachment {
  id         String        @id @default(uuid())
  commentId  String
  comment    TicketComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  url        String?
  // v2.B — key de MinIO (patrón BE-proxy, igual que ScheduledTaskAttachment/
  // NewsPostAttachment). Null para los adjuntos viejos (url data-URI).
  storageKey String?
  // v2.B — 'image' | 'audio' | 'video'. Null para adjuntos viejos (siempre imagen,
  // pero nunca se etiquetó como tal).
  kind       String?
  filename   String
  mimeType   String?
  sizeBytes  Int?

  @@index([commentId])
}

// F6 — Auditoría IA de la instalación. Run padre (1 vigente por tarea, replace-on-rerun)
// + hallazgos estructurados (severidad/categoría/texto/fotos).
model TaskInstallationAudit {
  id        String             @id @default(uuid())
  taskId    String             @unique
  task      ScheduledTask      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  model     String
  auditedAt DateTime           @default(now())
  findings  TaskAuditFinding[]

  @@index([taskId])
}

model TaskAuditFinding {
  id        String                @id @default(uuid())
  auditId   String
  audit     TaskInstallationAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)
  severity  String // ok | warning | critical
  category  String // señal | conexión | fotos | instalación | otros
  text      String
  photoUrls String[]
  createdAt DateTime              @default(now())

  @@index([auditId])
}

