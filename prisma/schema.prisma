// =============================================
// TV ACTIVATION HISTORY (#5 BE)
// =============================================

// Append-only log of every alta / baja / reactivacion TV event per client.
// actorId is a SOFT FK to RbacUser (SetNull on delete): the actor name is
// also snapshotted in actorName so history is readable even after user deletion.
// GR sync NEVER writes this table.
model TvActivationEvent {
  id         String   @id @default(uuid())
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  // Soft FK: SetNull when the actor user is deleted (history is still readable via actorName).
  actorId    String?
  actor      RbacUser? @relation("TvActivationEventActor", fields: [actorId], references: [id], onDelete: SetNull)
  // Snapshot of the actor name at the time of the event (preserved after user deletion).
  actorName  String
  // 'alta' = first registration, 'reactivacion' = re-registration after baja, 'baja' = cancellation.
  eventType  String
  cic        String?
  internalId String?
  seq        Int?
  contractId String?
  // #127 - optional cancellation reason threaded from the FE cancel modal.
  reason     String?
  createdAt  DateTime @default(now())

  @@index([clientId, createdAt(sort: Desc)])
  @@index([actorId])
  @@map("tv_activation_events")
}

// #110 — Append-only log of every status change of a NON-TV contract service.
// actorId is a SOFT FK (SetNull on RbacUser delete) so history survives user deletion.
// contractId cascades on Contract delete. GR sync NEVER writes this table.
model ContractServiceEvent {
  id               String    @id @default(uuid())
  contractId       String
  serviceCatalogId String
  // 'activated' = alta inicial, 'deactivated' = baja, 'reactivated' = re-alta tras baja.
  eventType        String
  actorId          String?
  actor            RbacUser? @relation("ContractServiceEventActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorName        String    @default("")  // snapshot, legible tras borrado del user
  notes            String?
  // internet-history-plan-direction — snapshot de los CÓDIGOS de plan (viejo/nuevo) del cambio.
  // Solo se completan en eventos 'modified' (cambio de plan). La DIRECCIÓN (upgrade/downgrade) NO
  // se persiste: se DERIVA al leer comparando downloadKbps(newPlan) vs downloadKbps(oldPlan) contra
  // el catálogo de planes. `notes` se mantiene por compatibilidad (mismo par "viejo → nuevo").
  oldPlan          String?
  newPlan          String?
  // pppoe-change-audit — audita cambios de IP/password/status de un PPPoE asociado a contrato.
  // changeKind ('ip'|'password'|'status') discrimina el evento 'modified' cuando NO es cambio de plan.
  // oldValue/newValue guardan el valor viejo/nuevo (password: ambos null — la clave NUNCA se persiste).
  changeKind       String?
  oldValue         String?
  newValue         String?
  // #127 - optional cancellation reason threaded from the FE cancel modal.
  reason           String?
  createdAt        DateTime  @default(now())

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId, createdAt])
  @@map("contract_service_events")
}

// actions-worklist (EPIC titularidad F2) — caso operativo de cambio de titularidad
// detectado desde el mirror GR. Sin FKs duras a Contract/Client: los ids del mirror
// pueden re-sincronizarse; el caso es un registro operativo (mismo criterio que
// RecaptureLead usa SetNull, acá directamente String). Los checks AUTO (tv/pppoe/
// equipos) NO se persisten — se computan en la lectura.
model OwnershipTransferCase {
  id                    String    @id @default(uuid())
  // Lado BAJA (origen) — siempre presente, es el disparador
  sourceContractId      String    @unique // 1 caso por contrato de baja (idempotencia)
  sourceClientId        String
  motivoBaja            String    // snapshot del motivo que disparó
  bajaDate              String?   // GR `baja` (dd-mm-yyyy) si está en raw
  // Lado ALTA (destino) — null si sin candidato o ambiguo hasta el pick
  targetContractId      String?
  targetClientId        String?
  candidates            Json?     // [{contractId, clientId}] si ≥2
  status                String    @default("pending") // pending | ambiguous | done | dismissed
  dismissReason         String?
  // Check MANUAL (mundo físico) — con rastro
  equipmentReviewed     Boolean   @default(false)
  equipmentReviewedById String?
  equipmentReviewedAt   DateTime?
  detectedAt            DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([status])
  @@index([targetClientId])
}

// =============================================
// MESSAGING-INBOX DOMAIN (F1: Inbox WhatsApp/Chatwoot)
// =============================================

// Mirror local de conversaciones de Chatwoot. Sin `clientId` cacheado (desvío deliberado
// del boceto original): CTX-2 exige que calcular el contexto de cliente NO modifique la
// Conversation — persistir un FK cacheado obligaría a re-escribirlo en cada fetch-on-open
// o dejarlo stale entre altas/bajas de Client. El contexto se computa en cada lectura de
// detalle (GetClientContextByPhone), nunca en el listado. Sin FK dura a Client: el match
// es por teléfono normalizado, no por id.
model Conversation {
  id                     String        @id @default(uuid())
  // messaging-bulk-inbox (F1) — nullable: una conversación origin:'bulk' nace SIN
  // chatwootConversationId (Chatwoot aún no la conoce). PG trata NULLs como distintos
  // en un UNIQUE, así que N filas bulk conviven; Fase 2 lo setea al adoptar (in-place).
  chatwootConversationId Int?          @unique
  // messaging-bulk-inbox (F1) — 'chatwoot' (default, back-compat) | 'bulk'. Discrimina
  // el origen del mirror sin romper el write-path de Chatwoot.
  origin                 String        @default("chatwoot")
  contactName            String?
  contactPhone           String?
  // messaging-bulk-inbox (F1) — E164 CANÓNICO (toWhatsAppE164(contactPhone)), clave de
  // matcheo del bulk (upsertBulkByPhone) y de la reconciliación Fase 2. NO normalizePhone:
  // ese es LOSSY (no strippea el "15" móvil embebido) → duplicados sistemáticos cross-format
  // (mismo motivo por el que el opt-out migró a toWhatsAppE164, FIX-9-v2). Backfill
  // best-effort en la migración (null = "no matcheable aún", degradación segura).
  contactPhoneE164       String?
  status                 String        @default("open") // passthrough del vocabulario de
                                                          // Chatwoot (open/resolved/pending) —
                                                          // String plano, mismo criterio que
                                                          // Contract.status/Message.channel
  canReply               Boolean       @default(false)   // cache del can_reply de Chatwoot —
                                                          // SendMessage lo lee del mirror,
                                                          // NUNCA recalcula la ventana 24h local
  lastMessageAt          DateTime?
  lastMessagePreview     String?
  // inbox-views (Ola 1, VIEW-1) — dirección del ÚLTIMO mensaje NO-privado
  // ('inbound' | 'outbound' | NULL sin mensajes públicos). Cache DESNORMALIZADO
  // mantenido por PrismaChatMessageRepository (choke point: los 5 write-paths de
  // mensajes pasan por sus 3 upserts) — una nota interna (isPrivate) jamás lo
  // toca (no cuenta como atención, misma disciplina que bumpsPreview/NOTE-3).
  // Hace O(1) el filtro/count del bucket "Sin atender"; la alternativa por
  // request (último mensaje por conversación) es un correlated subquery que
  // Prisma no expresa sin $queryRaw o un N+1. Backfill en la migración
  // 20260925000000 desde el último ChatMessage no-privado (DISTINCT ON).
  lastPublicMessageDirection String?

  // messaging-inbox-notes (edit/delete, COUNT) — contador DESNORMALIZADO de notas
  // internas VIVAS (isPrivate=true AND deletedAt IS NULL) de la conversación. Mantenido
  // por PrismaChatMessageRepository (choke point de escritura de mensajes, MISMO patrón
  // que lastPublicMessageDirection: recompute total, self-healing, fail-open). Backfill
  // en la migración. Hace O(1) el indicador 📝+N de la lista del inbox, sin subquery/COUNT
  // por request. Una nota soft-deleted (deletedAt != null) NO cuenta.
  internalNoteCount      Int           @default(0)

  // conversation-events (Ola 2) — timestamps DERIVADOS del ciclo de vida de resolución,
  // cimiento de los reports (SLA / "tiempo hasta resolución"). `resolvedAt` = ÚLTIMA vez
  // que la conversación pasó a `resolved` (se LIMPIA a null al reabrir — refleja el
  // estado ACTUAL). `firstResolvedAt` = PRIMERA resolución histórica (NUNCA se limpia —
  // "tiempo hasta primera resolución"). Ambos los mantiene `SetConversationStatus` (acción
  // del agente) y el webhook `conversation_status_changed` (Chatwoot-driven), siempre sobre
  // la MISMA transición real (prev != new) que emite el `ConversationEvent`. Backfill de la
  // migración: para las ya `resolved` se setean ambos = `updatedAt` (APROXIMADO — es la
  // mejor señal disponible para las históricas, no hubo tabla de eventos hasta ahora).
  resolvedAt             DateTime?
  firstResolvedAt        DateTime?

  // conversation-snooze (Ola 6c) — timestamp hasta el que la conversación está POSPUESTA.
  // status='snoozed' AND snoozedUntil>now = VIGENTE (fuera de Abiertas/Sin atender, en el bucket
  // `snoozed`); al vencer (snoozedUntil<=now) reaparece como `open` de forma LAZY en los buckets
  // (sin cron) y el watcher ReactivateExpiredSnoozes normaliza el status en DB a 'open' + null.
  // La escribe SnoozeConversation/el watcher, atómica con el `status`. Backfill: null (aditiva).
  snoozedUntil           DateTime?

  // F1.5-C2 (asignación) — assigneeId/areaId son campos EXCLUSIVAMENTE LOCALES del
  // mirror: Chatwoot NUNCA se entera de la asignación (no existe llamada upstream),
  // igual que status/canReply ya son locales-primero. NINGÚN camino de escritura
  // impulsado por Chatwoot (upsertByChatwootId — webhook/fetch-on-open/SendMessage/
  // SetConversationStatus) toca estos dos campos: solo
  // ConversationRepository.updateLocalFields (AssignConversation/SetConversationArea)
  // los escribe. Clon 1:1 del patrón Ticket.assigneeId/areaId.
  assigneeId             String?
  assignee               RbacUser?          @relation("ConversationAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  areaId                 String?
  area                   TicketAreaCatalog? @relation(fields: [areaId], references: [id], onDelete: SetNull)

  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  messages               ChatMessage[]
  // conversation-events (Ola 2) — historial append-only de transiciones (created/resolved/
  // reopened/assigned/unassigned/area_changed). Fuente de verdad de "resueltas por día" y
  // el resto de los reports de agregación por rango.
  events                 ConversationEvent[]
  // messaging-bulk-inbox (F1) — lazo recipient↔Conversation (proyección + etiqueta #1).
  campaignRecipients     CampaignRecipient[]
  // conversation-labels (Ola 5) — etiquetas de color N:M (catálogo ConversationLabel)
  // vía la join EXPLÍCITA ConversationLabelAssignment (mismo criterio de join
  // explícito que CampaignRecipient — no el M:N implícito de Prisma). Son LOCALES
  // del mirror: Chatwoot NUNCA se entera (igual que assigneeId/areaId). Solo
  // ConversationRepository.setLabels las escribe; ningún write-path de Chatwoot las toca.
  labelAssignments       ConversationLabelAssignment[]
  // note-mentions (Ola 6b) — @menciones registradas en las notas internas de esta
  // conversación. La vista "Menciones" filtra por `mentions.some({ mentionedUserId, readAt: null })`.
  mentions               ConversationMention[]

  // §9: DESC matches the actual INBOX-1 query (orderBy lastMessageAt DESC NULLS
  // LAST in PrismaConversationRepository.list) — same `sort: Desc` idiom already
  // used elsewhere in this schema (e.g. ScheduledTaskActivity's `createdAt(sort: Desc)`).
  @@index([lastMessageAt(sort: Desc)])
  @@index([assigneeId])
  @@index([areaId])
  // messaging-bulk-inbox (F1) — matcheo por E164 canónico (upsertBulkByPhone / Fase 2).
  @@index([contactPhoneE164])
  // inbox-views (Ola 1) — filtro/count del bucket "Sin atender" por request.
  @@index([lastPublicMessageDirection])
  // conversation-snooze (Ola 6c) — sirve el filtro/count del bucket `snoozed` (vigentes) y el
  // `listExpiredSnoozed` del watcher (status='snoozed' AND snoozedUntil<=now); el planner lo
  // combina con el filtro por status. Cardinalidad baja (pocas pospuestas a la vez).
  @@index([snoozedUntil])
}

// conversation-labels (Ola 5) — CATÁLOGO editable de etiquetas de conversación
// (calco de TicketAreaCatalog: name @unique + color hex con default token). El
// FE pinta el chip con name + color. Borrar una label la quita de TODAS las
// conversaciones (onDelete: Cascade en la join) — comportamiento de tag, a
// diferencia de TicketAreaCatalog que bloquea el delete si está en uso.
model ConversationLabel {
  id          String                        @id @default(uuid())
  name        String                        @unique
  color       String                        @default("#6366f1")
  createdAt   DateTime                      @default(now())
  updatedAt   DateTime                      @updatedAt
  assignments ConversationLabelAssignment[]

  @@map("ConversationLabel")
}

// conversation-labels (Ola 5) — join EXPLÍCITA Conversation×ConversationLabel
// (mismo criterio de join explícito que CampaignRecipient, no el M:N implícito de
// Prisma). @@unique([conversationId, labelId]) hace idempotente la asignación;
// ambos FKs Cascade (borrar la conversación o la label limpia la asignación).
model ConversationLabelAssignment {
  id             String            @id @default(uuid())
  conversationId String
  conversation   Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  labelId        String
  label          ConversationLabel @relation(fields: [labelId], references: [id], onDelete: Cascade)
  createdAt      DateTime          @default(now())

  @@unique([conversationId, labelId])
  @@index([conversationId])
  @@index([labelId])
  @@map("ConversationLabelAssignment")
}

// conversation-events (Ola 2) — historial APPEND-ONLY de transiciones de una conversación.
// Cimiento de los reports de Ola 3 (resueltas por día, tiempo hasta resolución, SLA): sin
// esto sólo existe el estado ACTUAL y toda la historia es irreconstruible. NO se emiten
// eventos históricos en el backfill (no hay data): sólo se registran de acá en adelante.
model ConversationEvent {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  // 'created' | 'resolved' | 'reopened' | 'assigned' | 'unassigned' | 'area_changed'
  // — String plano, mismo criterio que Conversation.status / ChatMessage.direction.
  type           String
  // Quién disparó la transición: el usuario RBAC autenticado (acción desde el inbox), o
  // NULL si vino del webhook/sistema (el cliente, o Chatwoot). Soft FK, SetNull on delete:
  // borrar el usuario NO borra su historial, sólo desasocia el actor.
  actorId        String?
  actor          RbacUser?    @relation("ConversationEventActor", fields: [actorId], references: [id], onDelete: SetNull)
  // Valores viejo→nuevo de la transición (ej. assignee viejo→nuevo, área vieja→nueva, o
  // status prev→next). Ambos nullable — un 'created' no tiene from/to, un 'unassigned' tiene
  // to=null. Strings planos (ids o status), nunca entidades.
  fromValue      String?
  toValue        String?
  createdAt      DateTime     @default(now())

  @@index([conversationId])
  // reports por rango: 'resolved'/'created' entre [from,to) — el índice compuesto sirve el
  // filtro por type + el rango de createdAt de un solo golpe.
  @@index([type, createdAt])
  @@index([createdAt])
  @@index([actorId])
}

// note-mentions (Ola 6b) — @menciones en notas internas. Cuando un agente escribe una nota
// interna con el token `@[nombre](userId)` (ver parseMentions), se registra UNA fila por
// usuario mencionado. La vista "Menciones" del inbox lista las conversaciones donde el usuario
// ACTUAL tiene alguna mención NO leída (readAt IS NULL). Aditiva, SIN backfill (no hubo
// menciones hasta esta migración). El registro es BEST-EFFORT desde SendMessage: un fallo al
// registrar menciones NO tumba la creación de la nota (misma disciplina que ConversationEvent).
model ConversationMention {
  id                String       @id @default(uuid())
  conversationId    String
  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  // La nota (ChatMessage) donde ocurrió la mención — parte del UNIQUE(message,user).
  messageId         String
  message           ChatMessage  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  // RbacUser mencionado (el que verá la conversación en su vista "Menciones"). Cascade: si el
  // usuario se borra, la mención (que era PARA él) deja de tener sentido.
  mentionedUserId   String
  mentionedUser     RbacUser     @relation("ConversationMentionUser", fields: [mentionedUserId], references: [id], onDelete: Cascade)
  // RbacUser autor de la nota (quién mencionó). Nullable + SetNull: borrar el autor preserva
  // la mención, sólo desasocia quién la escribió (mismo criterio que ConversationEvent.actorId).
  mentionedByUserId String?
  mentionedBy       RbacUser?    @relation("ConversationMentionByUser", fields: [mentionedByUserId], references: [id], onDelete: SetNull)
  createdAt         DateTime     @default(now())
  // NULL = no leída (aparece en la vista "Menciones"); ISO al marcar leída (sale de la vista).
  readAt            DateTime?

  // Idempotencia: el mismo usuario nombrado dos veces en la misma nota registra 1 sola fila.
  @@unique([messageId, mentionedUserId])
  @@index([conversationId])
  // Sirve el subquery de la vista/count "Menciones": menciones NO leídas por usuario.
  @@index([mentionedUserId, readAt])
}

// chatwootMessageId es único a nivel MENSAJE de Chatwoot — idempotencia de upsert (HOOK-4).
model ChatMessage {
  id                String       @id @default(uuid())
  conversationId    String
  conversation      Conversation @relation(fields: [conversationId], references: [id])
  // messaging-bulk-inbox (F1) — nullable: un mensaje origin:'bulk' NO tiene id de Chatwoot
  // (salió por Twilio directo). PG trata NULLs distintos en el UNIQUE → N filas bulk conviven.
  chatwootMessageId Int?         @unique
  // messaging-bulk-inbox (F1) — 'chatwoot' (default) | 'bulk'.
  origin            String       @default("chatwoot")
  // messaging-bulk-inbox (F1) — clave de idempotencia del mensaje bulk (upsertBulkMessage):
  // una fila por recipient de campaña. FK opcional; onDelete SetNull preserva el rastro en el
  // inbox aunque la campaña/recipient se borre (el mensaje YA se envió).
  campaignRecipientId String?    @unique
  campaignRecipient   CampaignRecipient? @relation(fields: [campaignRecipientId], references: [id], onDelete: SetNull)
  direction         String       // 'inbound' | 'outbound' — mensajes 'activity'/'template' NO
                                  // se persisten (filtrados antes del upsert por
                                  // ReceiveChatwootWebhook, ver design §7)
  content           String
  senderName        String?
  chatwootCreatedAt DateTime     // timestamp de Chatwoot — usado para ordenar (INBOX-3), NUNCA
                                 // para calcular la ventana 24h (eso lo resuelve canReply,
                                 // no math local)
  // messaging-inbox-notes (F1.5 fase D, NOTE-1) — migración aditiva sin backfill (nunca hubo
  // filas históricas de private, F1 siempre las descartó). `true` marca una nota interna de
  // Chatwoot (nunca cruza a WhatsApp) — persistida, pero NUNCA bumpea el preview del inbox
  // (NOTE-3, `bumpsPreview`/el guard de `SendMessage`).
  isPrivate         Boolean      @default(false)
  createdAt         DateTime     @default(now())
  attachments       ChatMessageAttachment[]
  // note-mentions (Ola 6b) — @menciones registradas en ESTA nota interna (una fila por
  // usuario mencionado). Cascade: borrar la nota borra sus menciones.
  mentions          ConversationMention[]
  // inbox-template-send (MODEL-1) — SM sid de Twilio, clave de idempotencia del
  // envío one-off de template desde el hilo (upsertTemplateMessage). Nullable:
  // las filas chatwoot/bulk existentes quedan NULL (PG trata NULLs como distintos
  // en el UNIQUE — conviven N filas).
  providerMessageId String?      @unique
  // H1 (fix wave, idempotency-key server-side) — clave de idempotencia PROPIA
  // del request HTTP (UUID generado por el FE al abrir el confirm), DISTINTA de
  // providerMessageId (que solo se conoce DESPUES de que Twilio acepta el envío).
  // Protege contra doble costo real: un timeout de red tras el accept + retry del
  // operador reusa la MISMA key → SendTemplateMessage devuelve el mensaje ya
  // proyectado sin re-invocar sendTemplate. Nullable/aditiva: filas históricas y
  // request de un FE viejo sin key quedan NULL (PG trata NULLs distintos en el
  // UNIQUE — conviven N filas). El @unique es también el backstop de carrera: dos
  // sends concurrentes con la misma key chocan acá, no duplican la fila.
  idempotencyKey    String?      @unique
  // messaging-inbox-notes (edit/delete, NOTE-EDIT) — autor RBAC de la nota interna
  // (isPrivate). Nullable + onDelete SetNull: notas históricas y TODOS los mensajes
  // públicos quedan NULL (un authorId NULL sólo es editable/eliminable por un supervisor
  // con messaging:manage). Capturado por SendMessage SÓLO cuando isPrivate (el
  // req.user.id del usuario RBAC autenticado, NUNCA el `senderName` del echo de Chatwoot).
  // Set-once: el update idempotente del webhook (mismo chatwootMessageId) NO lo pisa.
  authorId          String?
  author            RbacUser?    @relation("ChatMessageAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  // Timestamp de la última edición de contenido de la nota (NULL = nunca editada). El
  // DTO lo expone como el flag booleano `edited`.
  editedAt          DateTime?
  // Soft-delete de la nota interna (NULL = viva). La fila NUNCA se borra: el hilo la
  // sigue devolviendo con deleted=true (tombstone en el FE); el contador la excluye.
  deletedAt         DateTime?
  // chatwoot-hub-sendpath (D6) — proyección de `message_updated`/`content_attributes.
  // external_error` de Chatwoot: `null` (default = entregado/desconocido) | 'failed'.
  // delivered/read quedan INVISIBLES (paridad con hoy, decisión B — no es regresión).
  // Aditiva/nullable, sin default: no afecta filas existentes ni ningún path OFF.
  deliveryStatus    String?
  // chatwoot-hub-sendpath (D6) — error saneado (curate: trim/acota, NUNCA headers/body
  // crudos de Chatwoot, HIST-3) cuando deliveryStatus='failed'. `null` en cualquier otro caso.
  deliveryError     String?

  @@index([conversationId, chatwootCreatedAt])
  // count de notas internas vivas por conversación (isPrivate=true AND deletedAt IS NULL).
  @@index([conversationId, isPrivate])
  @@index([authorId])
}

// messaging-inbox-v2-media (F1.5 fase A, Tanda 1 · MODEL-1) — adjuntos (fotos/videos/
// audios/documentos) entrantes por WhatsApp. Migración ADITIVA, clon del molde de
// 20260823000000_add_scheduled_task_attachment. chatwootAttachmentId es único a nivel
// ADJUNTO de Chatwoot — idempotencia de upsert (MEDIA-1, mismo criterio que
// ChatMessage.chatwootMessageId). storageKey queda NULL mientras status='pending': la
// descarga del binario es ASYNC (fire-and-forget + scheduler de reintento, MEDIA-2/3),
// a diferencia de ScheduledTaskAttachment donde la escritura es síncrona con el alta.
model ChatMessageAttachment {
  id                   String      @id @default(uuid())
  messageId            String
  message              ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  chatwootAttachmentId Int         @unique
  fileType             String      // 'image' | 'audio' | 'video' | 'file' (String plano, mismo
                                    // criterio que ChatMessage.direction/Conversation.status)
  contentType          String      // MIME real reportado por Chatwoot (content_type)
  filename             String?     // Chatwoot no siempre lo reporta directo
  sizeBytes            Int?        // file_size de Chatwoot; se expone como fileSize en el DTO
  width                Int?        // solo image/video
  height               Int?        // solo image/video
  storageKey           String?     // NULL mientras pending; key = messaging/{conversationId}/{id}.ext
  thumbStorageKey      String?     // solo image; thumb_url de Chatwoot bajado a MinIO
  sourceUrl            String      // data_url de Chatwoot — lo usa el job de descarga y los reintentos
  thumbSourceUrl       String?     // thumb_url de Chatwoot (solo image)
  status               String      @default("pending") // 'pending' | 'downloaded' | 'failed'
  downloadAttempts     Int         @default(0)
  lastError            String?     // último error del download job (debug)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  @@index([messageId])  // mapper de attachments por mensaje, sin N+1 (listByMessageIds)
  @@index([status])     // el scheduler barre por status='pending'/'failed'
}

// Dedup de entregas de webhook por X-Chatwoot-Delivery (HOOK-3). Tabla separada de
// ChatMessage: conversation_created/conversation_status_changed no generan ninguna fila
// ChatMessage donde guardar la idempotencia — WebhookDelivery desacopla la idempotencia de
// ENTREGA HTTP del efecto sobre el mirror, cubriendo los 3 tipos suscritos uniformemente.
model WebhookDelivery {
  id         String   @id @default(uuid())
  source     String   @default("chatwoot")
  deliveryId String   // X-Chatwoot-Delivery
  receivedAt DateTime @default(now())

  @@unique([source, deliveryId])
}

// =============================================
// messaging-bulk (F2) — envío masivo por template WhatsApp (Twilio Content directo)
// =============================================

enum CampaignStatus {
  pending
  running
  paused
  done
  failed
}

enum CampaignRecipientStatus {
  queued
  sent
  delivered
  opted_out // Prisma no admite guiones — display "opted-out" en el DTO
  skipped
  failed
}

// Header + contadores de una campaña de envío masivo. Molde ServiceCutBatch (lock
// distribuido, resumible, status por-destinatario en CampaignRecipient). Uso Prisma
// enum (no String) siguiendo el precedente ClientStatus — DB-enforced, vocabulario
// cerrado (design §1.2).
model Campaign {
  id            String            @id @default(uuid())
  name          String            // nombre humano ("Recordatorio deuda julio")
  templateRef   String            // ContentSid Twilio (HX…) — enviable
  templateName  String?           // friendly_name legible del template
  // campaign-chatwoot-label (CLBL-6) — title del label REAL de Chatwoot elegido
  // opcionalmente al crear la campaña (pass-through, sin catálogo local).
  chatwootLabel String?
  // messaging-bulk-inbox (F1) — texto plano del template capturado en CreateCampaign
  // (TemplateDto.body), para renderizar el body real del mensaje al proyectar al inbox.
  templateBody  String?
  segment       Json              // filtro serializado (reproducible/auditable):
                                  // { statuses: string[], balanceMin?: number, balanceMax?: number }
  variableSpec  Json              @default("{}") // cómo se llenan las variables del template
                                  // por-destinatario: { "1": {source:'name'}, "2": {source:'balanceDue'},
                                  // "3": {source:'literal', value:'…'} }
  // bulk-granular-perms — snapshot de los estados de cliente presentes en los
  // destinatarios (distinct, sin números crudos) + si hubo números crudos, para
  // el re-chequeo de permisos granulares al disparar el envío (POST /:id/send).
  recipientStatuses String[]      @default([])
  hasRawRecipients  Boolean       @default(false)
  status        CampaignStatus    @default(pending)
  total         Int               @default(0)   // destinatarios resueltos al crear
  sentCount     Int               @default(0)
  failedCount   Int               @default(0)
  skippedCount  Int               @default(0)
  optedOutCount Int               @default(0)
  createdById   String            // FK RbacUser — quién la disparó
  createdBy     RbacUser          @relation("CampaignCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  error         String?           // error fatal del batch (si status=failed)
  createdAt     DateTime          @default(now())
  startedAt     DateTime?
  finishedAt    DateTime?
  updatedAt     DateTime          @updatedAt
  recipients    CampaignRecipient[]

  @@index([status])
  @@index([createdAt(sort: Desc)])   // historial ListCampaigns ordenado por fecha
}

// Status por-destinatario, PERSISTIDO por fila (auditable + resumible por SEND-6).
model CampaignRecipient {
  id                     String                   @id @default(uuid())
  campaignId             String
  campaign               Campaign                 @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  // bulk-csv-recipients (PER-1) — migración ADITIVA: nullable para admitir filas
  // "contact" (un contacto crudo del CSV que NO vinculó a ningún Client, CSV-3).
  // @@unique([campaignId, clientId]) se CONSERVA: Postgres trata cada NULL como
  // distinto en un unique index, así que N filas contact conviven sin problema.
  clientId               String?
  client                 Client?                  @relation("ClientCampaignRecipients", fields: [clientId], references: [id], onDelete: Cascade)
  // bulk-csv-recipients (PER-1/D1) — snapshot del nombre tipeado en el CSV, SOLO
  // presente en filas contact (clientId null); un vinculado usa Client.name fresco.
  contactName            String?
  phoneNormalized        String                   // clave de de-dup (normalizePhone) — auditable
  phoneE164              String                   // el destino REAL enviado (whatsapp E164) — auditable
  status                 CampaignRecipientStatus  @default(queued)
  providerId             String?                  // SM… de Twilio (id del mensaje) cuando sent
  chatwootConversationId Int?                     // link al mirror F1 si el cliente responde (F3/opcional)
  // messaging-bulk-inbox (F1) — lazo al mirror local seteado por la proyección. Es la
  // VERDAD de la etiqueta #1 (JOIN Conversation×CampaignRecipient) y el link de la
  // proyección. onDelete SetNull: si la conversación se borra, el recipient sobrevive.
  conversationId         String?
  conversation           Conversation?            @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  // messaging-bulk-inbox (F1) — back-relation 1:1 del mensaje bulk proyectado (idempotencia).
  bulkMessage            ChatMessage?
  error                  String?                  // motivo del fallo por-fila (best-effort, no aborta el lote)
  // bulk-task-stage-transition — SOLO en filas source:'task' (per-tarea). taskId = la tarea
  // por la que sale el mensaje; taskFromStageId = origen A (guard still-in-A al enviar);
  // taskResultingStageId = destino B global snapshoteado (null = sin transición). onDelete
  // SetNull: si la tarea se borra, el recipient sobrevive (auditoría de lo enviado).
  taskId                 String?
  task                   ScheduledTask?           @relation("TaskCampaignRecipients", fields: [taskId], references: [id], onDelete: SetNull)
  taskFromStageId        String?
  taskResultingStageId   String?
  sentAt                 DateTime?
  deliveredAt            DateTime?                // recién se llena en F3 (status callback Twilio)
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt

  // bulk-task-stage-transition — idempotencia PER-TAREA. Reemplaza @@unique([campaignId, clientId]):
  // un cliente puede aparecer N veces (una por tarea). Postgres trata cada NULL como distinto en un
  // unique index → las filas no-task (taskId NULL) conviven sin restricción (equivale a un unique
  // PARCIAL WHERE taskId IS NOT NULL, sin SQL a mano). El dedup por cliente de los otros dominios
  // lo garantiza resolveCombinedRecipients (byClientId), ya no la constraint.
  @@unique([campaignId, taskId])
  @@index([campaignId, status])       // progreso poleable + resume (WHERE status IN queued/failed)
  @@index([conversationId])           // etiqueta #1 — JOIN Conversation×CampaignRecipient
}

// =============================================
// INTERNAL NEWS DOMAIN (internal-news) — tablón interno del equipo
// =============================================

// Categorías del tablón — catálogo propio editable, calco de TicketAreaCatalog.
// Ola 4 (inbox-Chatwoot) — respuestas rápidas / macros (canned responses). Atajos de
// texto reutilizables para el composer. `shortcut` es un slug lowercase ÚNICO (sin la
// barra); el UNIQUE hace de índice de búsqueda por shortcut. `createdById` es la
// atribución soft del autor (SetNull → borrar el usuario NO borra la respuesta).
model CannedResponse {
  id          String    @id @default(uuid())
  shortcut    String    @unique
  content     String
  createdById String?
  createdBy   RbacUser? @relation("CannedResponseCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model NewsCategory {
  id        String     @id @default(uuid())
  name      String     @unique
  color     String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  posts     NewsPost[]
}

model NewsPost {
  id           String            @id @default(uuid())
  title        String
  body         String            // texto MARKDOWN multiline (N2). El BE lo persiste tal cual;
                                  // el FE lo renderiza. No cambia nada estructural (sigue siendo String).
  categoryId   String
  category     NewsCategory      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  authorId     String?
  author       RbacUser?         @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorName   String            // snapshot — sobrevive al borrado del usuario
  pinned       Boolean           @default(false)
  publishedAt  DateTime          @default(now())
  archivedAt   DateTime?
  // N2 — última difusión al NOC (WhatsApp). null = nunca difundida.
  lastBroadcastAt DateTime?
  // noc-broadcast-traceability — nombre (snapshot) del actor de la última difusión al NOC.
  lastBroadcastByName String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  readReceipts NewsReadReceipt[]
  attachments  NewsPostAttachment[]

  @@index([categoryId])
  @@index([archivedAt])
  @@index([pinned, publishedAt])
}

// N2 — adjunto de una NewsPost. Espejo de ScheduledTaskAttachment (binario en el storage
// bajo `storageKey`, prefijo news/{newsPostId}/) PERO con modo `link` (url externa, sin
// binario) y SIN thumbnails/dimensiones. onDelete: Cascade ⟹ al borrar la noticia se borran
// sus filas (el binario lo limpia el use case vía FileStorage).
model NewsPostAttachment {
  id           String   @id @default(uuid())
  newsPostId   String
  newsPost     NewsPost @relation(fields: [newsPostId], references: [id], onDelete: Cascade)
  kind         String   // 'image' | 'file' | 'link'
  storageKey   String?  // null para 'link'
  filename     String?  // nombre de archivo (binario) o rótulo (link); puede ser null
  mimeType     String?  // null para 'link'
  sizeBytes    Int?     // null para 'link'
  url          String?  // URL externa (solo 'link'); null para binarios
  uploadedById String
  createdAt    DateTime @default(now())

  @@index([newsPostId])
}

model NewsReadReceipt {
  id         String   @id @default(uuid())
  newsPostId String
  newsPost   NewsPost @relation(fields: [newsPostId], references: [id], onDelete: Cascade)
  userId     String
  user       RbacUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt     DateTime @default(now())

  @@unique([newsPostId, userId])
  @@index([userId])
}

// =============================================
// SMARTOLT FIBER PROVISIONING (smartolt-provision, K2)
// =============================================

// Catálogo local de OLTs SmartOLT: VLAN de servicio default + VLAN de management
// por OLT. Seed empírico por migración (MERCEDES1 / CHIVILCOY X2 / Estudiantes /
// AGOTE X2); editable en runtime vía PUT /api/fiber/olts/:id.
// serviceVlanDefault NULL = sin default (CHIVILCOY: VLAN heterogénea por cliente,
// el operador la elige en cada aprovisionamiento). mgmtVlan NULL = desconocida →
// el paso de mgmt IP se salta.
model SmartOltOltConfig {
  id                 String   @id @default(uuid())
  smartoltOltId      String   @unique // id de la OLT en SmartOLT ("1", "3", "5", "7")
  name               String
  serviceVlanDefault Int?
  mgmtVlan           Int?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// ============================================================================
// Auditoría GPS de técnicos (change iclass-gps-audit).
//
// IClass retiene el rastro de las cuadrillas ~30 días ROLLING (verificado
// 2026-07-26: el punto más viejo era del 25-06 con fecha actual 26-07). Sin esta
// copia propia no hay auditoría histórica posible: el dato se pierde solo.
//
// El rastro pertenece a la CUADRILLA, no a la orden de servicio: un técnico
// registra puntos toda la jornada haya o no haya órdenes. La OS es un filtro de
// consulta sobre el rastro, nunca su origen.
// ============================================================================

model TeamLocationPoint {
  id String @id @default(uuid())

  /// Login de la cuadrilla en IClass — clave de negocio estable y ÚNICA identidad
  /// que necesita un punto. El id numérico de IClass (el que se extrae de las URLs
  /// embebidas) sólo hace falta para LLAMAR a la API, no para almacenar el rastro:
  /// es un atributo de la cuadrilla, no del breadcrumb. Guardarlo acá sería
  /// denormalizar un dato que el dominio no modela.
  teamLogin String

  latitude  Float
  longitude Float

  /// Instante del fix, normalizado a UTC desde la hora ARGENTINA que emite IClass.
  recordedAt DateTime

  /// `raio` de IClass: precisión en metros, VERBATIM. Observado: 3,8 a 102,5 m.
  /// NULLABLE a propósito: precisión DESCONOCIDA no es 0. Mapear una precisión
  /// ausente a 0 la vuelve "GPS perfecto" y habilita la lectura más dura posible
  /// contra el técnico. Un punto sin precisión puede probar presencia, nunca condenar.
  accuracyM Float?

  /// `origem`(es). Es una lista porque IClass emite el MISMO punto físico por dos
  /// vías distintas (se observó origem 1 y 3 con timestamp y coordenadas idénticas);
  /// la deduplicación los colapsa en una fila conservando ambos orígenes.
  sources Int[]

  ingestedAt DateTime @default(now())

  /// Identidad natural del punto. IClass NO provee un id de breadcrumb, así que la
  /// tupla (cuadrilla, instante, coordenadas) es la clave. `sources` queda FUERA a
  /// propósito: el mismo fix por dos fuentes es UN punto, no dos.
  @@unique([teamLogin, recordedAt, latitude, longitude])
  /// Consulta por ventana de trabajo (auditoría) Y soporte del `DISTINCT ON` del mapa
  /// en vivo, que necesita `recordedAt DESC` para resolverse con un index scan.
  ///
  /// NOTA: es prefijo del unique de arriba, así que a primera vista parece redundante —
  /// pero el unique NO sirve para el `ORDER BY "teamLogin", "recordedAt" DESC` del
  /// DISTINCT ON (su tercera y cuarta columna estorban) y además éste es más angosto,
  /// con lo que el range scan de la ventana toca menos páginas. Decisión escrita, no
  /// accidente (hallazgo 4.5).
  @@index([teamLogin, recordedAt(sort: Desc)])
  /// Purga por retención (12 meses).
  @@index([recordedAt])
}

/// Observabilidad del ingest. El modo de falla peligroso de este ingest es el
/// SILENCIOSO —traer de menos y parecer exitoso—, así que cada corrida deja
/// contadores explícitos y la lista de cuadrillas que NO se leyeron completas.
model TeamLocationIngestRun {
  id              String   @id @default(uuid())
  startedAt       DateTime
  finishedAt      DateTime
  teamsProcessed  Int
  pointsNew       Int
  pointsDuplicate Int
  pointsPurged    Int
  pagesRead       Int
  /// Puntos que IClass devolvió pero no se pudieron leer. Un salto acá delata un
  /// cambio de contrato de la API, que si no se vería como "corrida exitosa, 0 datos".
  pointsDropped   Int      @default(0)
  incompleteTeams String[]
  createdAt       DateTime @default(now())

  @@index([startedAt])
}

/// Estado del ingest POR CUADRILLA (change iclass-gps-audit, hallazgo 2.2).
///
/// Existe para romper el RATCHET DEL WATERMARK. El rastro de IClass viene DESCENDENTE,
/// así que una lectura parcial trae los puntos MÁS NUEVOS. Si el watermark se derivara
/// de `MAX(recordedAt)` de lo persistido, saltaría POR ENCIMA del hueco y la corrida
/// siguiente cortaría en la página 1 reportando "limpio": la cola nunca se volvería a
/// pedir e IClass la purga a los 30 días.
///
/// `contiguousWatermark` sólo avanza cuando la lectura fue COMPLETA. Mientras haya un
/// hueco pendiente, el ingest sigue releyendo desde antes del hueco.
model TeamLocationIngestState {
  id String @id @default(uuid())

  /// Login de la cuadrilla — clave de negocio estable.
  teamLogin String @unique

  /// Hasta acá el rastro está leído SIN huecos. Es el watermark de lectura.
  /// `null` = nunca se completó una lectura para esta cuadrilla.
  contiguousWatermark DateTime?

  /// Última vez que una lectura quedó incompleta. Sirve para alertar si persiste.
  lastIncompleteAt DateTime?

  /// Corridas incompletas consecutivas. Un valor que crece es una alarma: el rastro se
  /// está perdiendo y quedan menos de 30 días para recuperarlo.
  consecutiveIncomplete Int @default(0)

  updatedAt DateTime @updatedAt
}
// ─────────────────────────────────────────────────────────────────────────────
// ai-assistant-multiagent — asistente IA configurable POR ÁREA, sobre conversaciones
// de WhatsApp (mirror Chatwoot) Y tickets. Ver openspec/changes/ai-assistant-multiagent/.
//
// PRINCIPIO RECTOR (D6 del proposal): la CONFIGURACIÓN es 100% editable en runtime;
// sólo las CAPACIDADES nuevas (una fuente de datos o una acción que hoy no existe)
// requieren código. Por eso las intenciones son FILAS (AssistantIntent), NO un enum
// hardcodeado: agregar comportamiento es cargar datos desde la UI, sin deploy.
// ─────────────────────────────────────────────────────────────────────────────

// CFG-1 — un perfil por área. `enabled` nace en FALSE: un perfil recién creado NUNCA
// habla hasta que alguien lo habilite explícitamente (la ausencia de configuración
// SIEMPRE resuelve a "no hablar", nunca a "improvisar" — RTR-3).
model AssistantProfile {
  id     String            @id @default(uuid())
  areaId String            @unique
  area   TicketAreaCatalog @relation(fields: [areaId], references: [id], onDelete: Cascade)

  enabled        Boolean @default(false)
  persona        String  @default("")
  handoffMessage String  @default("")
  // Modelo de redacción (paso 4 del pipeline, D1). Editable por área.
  model          String  @default("deepseek-chat")
  // Modelo del CLASIFICADOR (paso 1). NULL ⇒ usa `model`. Permite un modelo más chico y
  // barato para clasificar, que es una llamada corta y de set cerrado.
  classifierModel String?
  timeoutMs       Int     @default(20000)
  // Keys de AssistantAction habilitadas para ESTE perfil (ACT-1). Una acción no listada
  // acá resuelve a handoff aunque la intención la referencie.
  enabledActions  String[] @default([])

  intents   AssistantIntent[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}

// CFG-2 — una intención = una FILA. Alta/baja/edición SIN deploy. `description` y
// `examples[]` son el material que lee el clasificador (RTR-2): el universo de candidatas
// es SIEMPRE el de las intents enabled DEL PERFIL DEL ÁREA, nunca un vocabulario global.
model AssistantIntent {
  id        String           @id @default(uuid())
  profileId String
  profile   AssistantProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  name        String
  description String
  examples    String[] @default([])
  enabled     Boolean  @default(true)
  // Qué datos ve esta intención. Cada key MUST existir en AssistantDataSource (CFG-3,
  // validado en configuración con 400) — el motor resuelve SÓLO estas fuentes.
  dataSourceKeys String[] @default([])
  responseGuide  String   @default("")
  // Qué hace. MUST existir en AssistantAction Y estar en profile.enabledActions (ACT-1).
  actionKey      String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([profileId, name])
  @@index([profileId])
}

// CFG-3 — CATÁLOGO de fuentes. La implementación de cada `key` vive en CÓDIGO
// (AssistantDataSourceRegistry, D2). Esta tabla sólo permite HABILITAR/deshabilitar:
// NO existe endpoint para CREAR fuentes desde la UI — cada fuente es una puerta a la
// base, y definirlas por formulario sería una inyección con formulario bonito.
// Seed idempotente por migración. `noc.cortes` arranca DESHABILITADA: mientras el hub
// NOC esté en modo oscuro, responder "no hay cortes" sería afirmar sin saber.
model AssistantDataSource {
  key       String   @id
  label     String
  enabled   Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

// CFG-3 — CATÁLOGO de acciones, con su nivel de riesgo (§7 del proposal):
//   green  → comment_internal, suggest_area   (los ve un empleado, daño ~0)
//   yellow → whatsapp_reply, comment_public   (los ve el cliente)
//   red    → close_ticket, create_task        (entierra un problema / despacha cuadrilla)
// ACT-2: ninguna `red` viene habilitada en el seed; habilitarla requiere acto explícito
// y una corrida de eval registrada (EVAL-2).
model AssistantAction {
  key       String   @id
  label     String
  riskLevel String
  updatedAt DateTime @updatedAt
}

// RTR-0 — ruteo cuando la conversación NO tiene área.
//
// Hallazgo que obliga a esto (2026-07-26): `Conversation.areaId` lo escribe ÚNICAMENTE
// `SetConversationArea`, una acción manual en la UI de Prominense — y los agentes trabajan
// dentro de CHATWOOT. O sea: las conversaciones de WhatsApp entran con `areaId = NULL` y
// nadie las clasifica, así que un motor que exigiera área NUNCA se activaría.
//
// Solución elegida por el usuario: **agente default + re-ruteo**. Este singleton dice qué
// área atiende lo que entra sin clasificar. El agente default responde; si detecta que el
// tema pertenece a otra área con agente propio, reasigna y esa área toma la conversación.
//
// Molde config-singleton del repo (NocAlertThresholdsConfig / NocBroadcastConfig).
// `defaultAreaId` NULL = sin agente default ⇒ las conversaciones sin área no se atienden
// (comportamiento seguro por defecto: el seed lo deja en NULL).
model AssistantRoutingConfig {
  id            String             @id @default("singleton")
  defaultAreaId String?
  defaultArea   TicketAreaCatalog? @relation(fields: [defaultAreaId], references: [id], onDelete: SetNull)
  /// RTR-0 — habilita el re-ruteo a otras áreas. OFF ⇒ el agente default atiende todo y
  /// nunca reasigna (menos llamadas al modelo, menos superficie).
  rerouteEnabled Boolean           @default(false)
  updatedAt     DateTime           @updatedAt
}

/// Credenciales del proveedor de IA, editables desde la UI (molde NocBroadcastConfig).
///
/// `apiKey` es un SECRETO: el DTO de lectura NUNCA lo serializa completo — expone
/// `hasApiKey` + `apiKeyLast4`. Y un PUT con `apiKey` vacío PRESERVA la guardada, para que
/// editar la baseUrl desde el formulario no pise la key con la máscara que se mostró.
///
/// ⚠️ TRADEOFF ACEPTADO: la key queda en la base, así que la ve cualquiera con acceso a
/// Postgres (pgweb vía saturno). A cambio se puede rotar desde la UI sin deploy. Mismo
/// criterio que ya se tomó para `NocBroadcastConfig.evolutionApiKey`.
///
/// Vacío ⇒ se usa el env var (`DEEPSEEK_API_KEY`). La DB PISA al env; borrar el valor acá
/// devuelve el control a los secrets sin tocar código.
model AssistantProviderConfig {
  id        String   @id @default("singleton")
  baseUrl   String   @default("")
  apiKey    String   @default("")
  updatedAt DateTime @updatedAt
}

// EVAL-1/EVAL-2 — corridas de evaluación del asistente.
//
// NO es una métrica decorativa: es el CANDADO de las acciones `riskLevel:'red'`. Sin al menos
// una corrida registrada, `resolve_conversation` no se puede habilitar.
//
// Las dos particiones se guardan SEPARADAS a propósito. Un "accuracy" único esconde el modo
// de falla que importa: el benchmark de IrisAgent sobre tickets reales (jul-2026) mostró un
// modelo que resuelve casi todo y es el PEOR resistiendo alucinaciones — con un promedio
// único habría salido primero.
model AssistantEvalRun {
  id                String   @id @default(uuid())
  model             String
  /// Partición de RESOLUCIÓN: la respuesta correcta existe y se conoce.
  resolutionTotal   Int
  resolutionCorrect Int
  /// Partición de ABSTENCIÓN: no hay respuesta buena; el acierto es CALLARSE.
  abstentionTotal   Int
  abstentionCorrect Int
  notes             String?
  createdAt         DateTime @default(now())

  @@index([createdAt])
}

// OBS-1 — auditoría de CADA invocación del motor (responda o no). MUST NOT contener PII
// ni el prompt crudo: sólo qué agente actuó, con qué intención, qué fuentes resolvió y
// en qué terminó. Es la fuente de verdad para depurar por qué el bot dijo (o calló) algo.
model AssistantRun {
  id          String  @id @default(uuid())
  profileId   String?
  areaId      String?
  subjectType String // 'conversation' | 'ticket'
  subjectId   String
  // NULL ⇒ el clasificador no matcheó ninguna intención habilitada (default deny, RTR-3).
  intentName  String?
  dataSources String[] @default([])
  actionKey   String?
  // 'replied' | 'handoff' | 'noop' | 'rejected_numbers' | 'error'
  // `rejected_numbers` = SEC-4 descartó la salida porque el modelo escribió una cifra que
  // no estaba en los hechos inyectados. Es la métrica de alucinación atajada.
  outcome   String
  reason    String?
  latencyMs Int?
  createdAt DateTime @default(now())

  @@index([subjectType, subjectId])
  @@index([createdAt])
}

// wifi-password-snapshot — SmartOLT NUNCA devuelve la password de una red
// WiFi via `get_onu_details` (verificado en vivo, experimento 2026-08-02:
// `password: null` SIEMPRE en las 925 ONUs del parque con WiFi) — sólo la
// ACEPTA al escribir (`set_wifi_port_lan`). El SSID sí se puede releer una vez
// que Prominense lo escribió; la password, nunca. Por eso Prominense la
// RECUERDA acá: cada escritura exitosa (portal o admin, ver
// UpdatePortalWifiBand / SetAdminWifiBand) hace upsert por (sn, port) — este
// modelo es el ÚNICO lugar donde la password sobrevive.
//
// Riesgo aceptado: si alguien cambia la password por FUERA de Prominense (la
// web local del equipo, la UI de SmartOLT) este snapshot queda
// DESACTUALIZADO — no hay forma de detectarlo, SmartOLT no la expone para
// comparar.
//
// Seguridad: password en TEXTO PLANO — mismo criterio que PppoeService.password
// (ya en este schema, ver arriba) — mejora futura: cifrado at-rest.
model OnuWifiCredential {
  id String @id @default(uuid())
  /// Serial NORMALIZADO (normalizeOnuSerial) — misma clave que el resto de wifi-self-service.
  sn String
  /// 'wifi_0/1'..'wifi_0/8'.
  port      String
  ssid      String
  password  String
  updatedAt DateTime @updatedAt
  /// 'portal' | 'staff:<rbacUserId>' — quién la escribió por última vez.
  updatedBy String?

  @@unique([sn, port])
}

/// wifi-guest-pending — intent PERSISTIDO de un cambio de la red de visitas en
/// vuelo (alta o baja). En el EG8041V5 el shutdown_wifi_port es aceptado por
/// SmartOLT pero el push TR-069 SE PIERDE (verificado 2026-08-05, HWTCA92F96B1):
/// el GET del portal evalúa este intent lazy — verificación viva + re-push único
/// + 'unconfirmed' a los 10 min. En DB (no in-memory) para sobrevivir restarts.
model WifiGuestIntent {
  id String @id @default(uuid())
  /// Serial NORMALIZADO (normalizeOnuSerial). UNIQUE: UN intent por ONU a la vez.
  sn String @unique
  /// Contrato que ORDENÓ el cambio. Un ONT se re-provisiona a OTRO cliente de
  /// forma rutinaria: si el contrato actual no coincide, el intent es huérfano
  /// y el GET lo borra en silencio (el dueño nuevo no hereda el nag).
  contractId String
  /// 'creating' | 'deleting'.
  action String
  /// Puerto de visita afectado ('wifi_0/2' | 'wifi_0/6') — re-push + índice WLAN de verificación.
  port String
  /// Inicio del cambio — lo pone el use case (reloj inyectable), no la DB.
  since DateTime
  /// Sellado tras el ÚNICO re-push del flujo deleting. null = nunca re-pusheado.
  retriedAt DateTime?
  createdAt DateTime  @default(now())
}
