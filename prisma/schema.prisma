model TaskTemplateItem {
  id              String              @id @default(uuid())
  templateId      String
  template        TaskTemplate        @relation(fields: [templateId], references: [id], onDelete: Cascade)
  text            String
  order           Int
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  checklistCopies TaskChecklistItem[]

  @@index([templateId, order])
}

model TaskChecklistItem {
  id                 String            @id @default(uuid())
  taskId             String
  task               ScheduledTask     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  text               String
  done               Boolean           @default(false)
  order              Int
  fromTemplateItemId String?
  fromTemplateItem   TaskTemplateItem? @relation(fields: [fromTemplateItemId], references: [id], onDelete: SetNull)
  createdAt          DateTime          @default(now())
