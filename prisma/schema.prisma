// ============================================================================
// IClass closure loop — mirror of CLOSED service orders pulled back from IClass.
// Join to local work: SO.codigo (iclass) == ScheduledTask.sequenceNumber (we send
// soCode=sequenceNumber on create; iclass preserves it as `codigo`).
// ============================================================================

// Catalog of result codes per SO type. `motivoFechamento` on a closed SO equals
// the result-code name (`code`); `type` (Sucesso/Falha) drives the stage transition.
model IClassResultCode {
  id           String   @id @default(uuid())
  soTypeId     BigInt?
  code         String   // motivoFechamento value (the result-code name)
  type         String   // Sucesso | Falha | ...
  // Configurable closure mapping (mirrors Project.iclassSoTypeId): when an SO closes
  // with this result code, the linked task is moved to mappedStage. Null = unmapped
  // (task is NOT moved; left for manual review). Assigned via the admin API/UX.
  mappedStageId String?
  mappedStage   Stage?   @relation("ResultCodeMappedStage", fields: [mappedStageId], references: [id], onDelete: SetNull)
  // Closure-detected returns (EPIC #38 W4): when true, a completed (Sucesso) SO closing
  // with this result code stages equipment-return suggestions. Configurable per code so
  // ops can add removal codes without a redeploy. Default false; seeded true for the 2
  // confirmed retiro codes.
  isRemovalCode Boolean  @default(false)
  lastSyncedAt DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([soTypeId, code])
  @@index([code])
  @@index([mappedStageId])
}

// iclass-status-sync — auto-discovered catalog of IClass OS status codes.
// statusCode is the opaque IClass id (status.id, e.g. "7", "3", "50").
// Entries are auto-upserted on each ingest tick; operator configures displayLabel/color/tracked.
model IClassStatusCatalog {
  id           String   @id @default(uuid())
  statusCode   String   @unique // IClass status.id (opaque string)
  iclassLabel  String   // status.descricao (raw, refreshed on each upsert)
  displayLabel String?  // Prominense editable label; NULL → use iclassLabel
  color        String?  // hex color for the badge (e.g. "#FF5500"); NULL → no color
  tracked      Boolean  @default(false) // opt-in: visible in FE badge/filter
  // iclass-intermediate-states — operator-mapped Prominense Stage (kanban column).
  // When set, the scheduler auto-moves a matched task to this stage on a status change
  // (forward-only). NULL = no auto-move. Preserved by the auto-discovery upsert.
  prominenseStageId String?
  prominenseStage   Stage?  @relation("StatusCatalogProminenseStage", fields: [prominenseStageId], references: [id], onDelete: SetNull)
  lastSyncedAt DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([tracked])
  @@index([prominenseStageId])
}

model IClassServiceOrder {
  id                String  @id @default(cuid())
  iclassId          BigInt  @unique // numeric SO id from IClass
  iclassCodigo      String  @unique // SO `codigo`; equals our ScheduledTask.sequenceNumber for our SOs
  clusterName       String
  thirdPartyCode    String?
  nodeCode          String?
  soTypeId          String? // IClass tipoOs.id — resolves the result-code mapping per SO type
  soTypeDescription String?

  customerCode String?
  customerName String?
  addressCode  String?
  addressLine  String?
  addressCity  String?
  addressLat   Float?
  addressLng   Float?

  statusCode        String // '7' for terminal Concluida
  statusDescription String

  requestedAt      DateTime?
  scheduledFor     DateTime?
  availableAt      DateTime?
  serviceStartedAt DateTime?
  serviceEndedAt   DateTime?
  firstClosedAt    DateTime? // status 4 transition (technician close)
  approvedAt       DateTime? // status 50 transition
  closedAt         DateTime? // status 7 transition (final) — derived from history

  resultCodeName String? // motivoFechamento
  resultCodeType String? // joined from IClassResultCode (Sucesso/Falha)
  closedByLogin  String?
  closedByName   String?
  closeLatitude  Float?
  closeLongitude Float?
  closeGpsAt     DateTime?
  billingAmount  Decimal?  @db.Decimal(12, 2)

  technicianNote String? @db.Text // obsEquipe
  internalNote   String? @db.Text // obs
  commentaryLog  String? @db.Text // raw comentario blob

  teamLogin          String?
  teamTechnicianName String?
  teamPhone          String?
  teamEmail          String?

  // Link back to our task (matched by codigo↔sequenceNumber). Nullable: an SO with
  // no local match is skipped, but the FK stays optional for resilience.
  scheduledTaskId String?        @unique
  scheduledTask   ScheduledTask? @relation(fields: [scheduledTaskId], references: [id], onDelete: SetNull)

  iclassCreatedAt DateTime?
  iclassUpdatedAt DateTime? // alteradoPor.data — idempotency key
  ingestedAt      DateTime  @default(now())
  rawDetail       Json // full SO snapshot for forensics

  // Closure side-effect tracking — lets the manual reprocess re-fire only the
  // effects that have NOT yet succeeded, decoupled from the mirror idempotency.
  commentPosted      Boolean   @default(false) // PostClosureComment succeeded
  inventoryBuilt     Boolean   @default(false) // BuildInventorySuggestions succeeded
  auditDone          Boolean   @default(false) // AuditInstallationQuality persisted
  auditAttempts      Int       @default(0) // audit retries (cap to avoid hammering Ollama)
  lastAuditAttemptAt DateTime? // when the last audit attempt ran
  // EPIC #38 W4 — L1 idempotency for closure-detected returns. Mirrors inventoryBuilt:
  // the processInventoryReturns side-effect stages return suggestions ONLY when false,
  // and sets it true after staging. Re-mirror/re-closure never re-stages.
  inventoryReturnsProcessed Boolean @default(false)

  history          IClassSoStatusHistory[]
  checklists       IClassSoChecklist[]
  materials        IClassSoMaterial[]
  equipmentEvents  IClassSoEquipmentEvent[]

  @@index([clusterName, closedAt])
  @@index([customerCode])
  @@index([iclassUpdatedAt])
  @@index([scheduledTaskId])
}

