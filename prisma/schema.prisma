// Staging per task: what we scraped/OCR'd, shown as checkboxes. NEVER touches the
// contract on its own — the operator confirms each into a ServiceInstalledItem.
model TaskInventorySuggestion {
  id              String        @id @default(uuid())
  taskId          String
  task            ScheduledTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  kind            String // DEVICE | MATERIAL
  deviceType      String? // if DEVICE: ONU | ROUTER | ANTENA | REPETIDOR | OTROS (del label)
  qwenDeviceType  String? // clasificación del modelo de visión desde la foto (badge), o null
  serialNumber    String?
  mac             String?
  materialDesc    String?
  quantity        Float?
  unit            String?
  source          String // OCR | ICLASS_MATERIAL | MANUAL
  photoUrl        String?       @db.Text
  status          String        @default("pending") // pending | confirmed | discarded
  confirmedItemId String?
  createdAt       DateTime      @default(now())

  @@index([taskId, status])
}

// Confirmed inventory on the client's contract. ONE row = ONE physical device.
// 2 routers = 2 rows. serialNumber/mac are SINGULAR by design.
model ContractInstalledItem {
  id            String    @id @default(uuid())
  contractId    String
  contract      Contract  @relation(fields: [contractId], references: [id], onDelete: Cascade)
  type          String // ONU | ROUTER | ANTENA | REPETIDOR | OTROS
  serialNumber  String?
  mac           String?
  model         String?
  source        String // OCR | MANUAL | ICLASS
  sourceTaskId  String?
  addedByUserId String?
  confirmedAt   DateTime?
  status        String    @default("active") // active | removed | replaced

  // Link to the item this one replaced (self-relation). null = not a replacement.
  replacesItemId String?
  replaces       ContractInstalledItem?  @relation("ItemReplacement", fields: [replacesItemId], references: [id], onDelete: SetNull)
  replacedBy     ContractInstalledItem[] @relation("ItemReplacement")

  notes         String?   @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Inventory Foundation (W1): dual-write link to the unified asset ledger record.
  // Nullable so legacy rows + fixtures don't break; backfilled by the W1 migration.
  assetId       String?
  asset         InventoryAsset? @relation("CiiAsset", fields: [assetId], references: [id], onDelete: SetNull)

  @@index([contractId])
  @@index([serialNumber])
  @@index([replacesItemId])
  @@index([assetId])
}

// ============================================================================
// Inventory Foundation (EPIC #38, Wave 1) — unified asset + material ledger.
// StockLocation anchors every serialized asset and material balance. The
// InventoryMovement ledger is the immutable audit trail; InventoryAsset.currentLocationId
// and MaterialStock.qty are the materialized live truth.
// ============================================================================

// Physical/logical inventory location. DEPOSITO is a singleton (unique `code`);
// CLIENTE is per-contract; TECNICO is per-technician; CAMIONETA is per-vehicle (W5b).
model StockLocation {
  id           String    @id @default(uuid())
  type         String    // DEPOSITO | CLIENTE | TECNICO | CAMIONETA
  code         String?   @unique // DEPOSITO singleton key (e.g. 'DEPOSITO')
  contractId   String?
  contract     Contract? @relation("ContractStockLocation", fields: [contractId], references: [id], onDelete: Cascade)
  technicianId String?
  technician   RbacUser? @relation("TechnicianStockLocation", fields: [technicianId], references: [id], onDelete: Cascade)
  // EPIC #38 W5b — CAMIONETA location: one per vehicle
  vehicleId    String?
  vehicle      Vehicle?  @relation("VehicleStockLocation", fields: [vehicleId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  assetsHere          InventoryAsset[]    @relation("AssetCurrentLocation")
  materialStocks      MaterialStock[]
  movementsFrom       InventoryMovement[] @relation("MovementFrom")
  movementsTo         InventoryMovement[] @relation("MovementTo")

  // One CLIENTE per contract / one TECNICO per technician (DEPOSITO uses unique code).
  // @@unique([type, vehicleId]) uses PG NULL-distinct semantics — no NULLS NOT DISTINCT needed.
  @@unique([type, contractId])
  @@unique([type, technicianId])
  @@unique([type, vehicleId])
  @@index([type])
}

// EPIC #38 Wave 5b — Vehicle catalog (ABM). Mirrors MaterialCatalog pattern.
// Each vehicle can have at most one CAMIONETA StockLocation (compound unique).
model Vehicle {
  id                    String          @id @default(uuid())
  plate                 String          @unique
  name                  String?
  assignedTechnicianId  String?
  assignedTechnician    RbacUser?       @relation("AssignedVehicleTechnician", fields: [assignedTechnicianId], references: [id], onDelete: SetNull)
  status                String          @default("active") // active | inactive
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  // One CAMIONETA StockLocation per vehicle (find-or-create via ResolveVehicleLocation)
  locations             StockLocation[] @relation("VehicleStockLocation")
}

// Unified serialized equipment record (ONU, router, antenna, ...). Replaces
// ContractInstalledItem as the single source of truth for tracked devices.
model InventoryAsset {
  id                String            @id @default(uuid())
  serialNumber      String            @unique
  // FIX 3 (depot-stock-entry): mac has a hand-written PARTIAL UNIQUE index
  // (WHERE mac IS NOT NULL) in 20260617000000_inventory_asset_mac_unique/migration.sql.
  // NULLs are free (MAC-unknown entries); non-null macs are device-unique.
  // DO-NOT-ADD @unique here — Prisma cannot express the WHERE clause and would create
  // a full unique index that collides on NULLs. Keep plain String? + this comment.
  mac               String?
  deviceTypeId      String
  deviceType        DeviceTypeCatalog @relation("AssetDeviceType", fields: [deviceTypeId], references: [id], onDelete: Restrict)
  status            String            // available | installed | removed | damaged | retired
  currentLocationId String
  currentLocation   StockLocation     @relation("AssetCurrentLocation", fields: [currentLocationId], references: [id], onDelete: Restrict)
  source            String            // OCR | MANUAL | ICLASS
  sourceTaskId      String?
  sourceTask        ScheduledTask?    @relation("AssetSourceTask", fields: [sourceTaskId], references: [id], onDelete: SetNull)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  movements        InventoryMovement[]     @relation("MovementAsset")
  contractItems    ContractInstalledItem[] @relation("CiiAsset")
  // EPIC #38 W4 — return suggestions that matched THIS asset (installed → return-to-depot)
  returnSuggestions ReturnSuggestion[]     @relation("ReturnMatchedAsset")

  @@index([deviceTypeId])
  @@index([currentLocationId])
  @@index([status])
  @@index([sourceTaskId])
}

// Consumable quantity balance of a catalog material at a location. One row per
// (materialCatalogId, locationId). W1 operates DEPOSITO balances only.
model MaterialStock {
  id                String          @id @default(uuid())
  materialCatalogId String
  material          MaterialCatalog @relation("MaterialStock", fields: [materialCatalogId], references: [id], onDelete: Restrict)
  locationId        String
  location          StockLocation   @relation(fields: [locationId], references: [id], onDelete: Cascade)
  qty               Decimal         @default(0) @db.Decimal(12, 4)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([materialCatalogId, locationId])
  @@index([locationId])
}

// Immutable audit trail of every inventory event. RecordInventoryMovement is the
// ONLY mutating entry point: it writes the ledger row AND the materialized balance
// atomically. Either an asset moves (assetId) or a material qty moves (materialCatalogId+qty).
model InventoryMovement {
  id                String          @id @default(uuid())
  type              String          // ISSUE | TRANSFER | INSTALL | RETURN | CONSUME | ADJUST
  assetId           String?
  asset             InventoryAsset? @relation("MovementAsset", fields: [assetId], references: [id], onDelete: SetNull)
  materialCatalogId String?
  material          MaterialCatalog? @relation("MaterialMovement", fields: [materialCatalogId], references: [id], onDelete: SetNull)
  qty               Decimal?        @db.Decimal(12, 4)
  fromLocationId    String?
  fromLocation      StockLocation?  @relation("MovementFrom", fields: [fromLocationId], references: [id], onDelete: SetNull)
  toLocationId      String?
  toLocation        StockLocation?  @relation("MovementTo", fields: [toLocationId], references: [id], onDelete: SetNull)
  taskId            String?
  task              ScheduledTask?  @relation("MovementTask", fields: [taskId], references: [id], onDelete: SetNull)
  technicianId      String?
  technician        RbacUser?       @relation("MovementTechnician", fields: [technicianId], references: [id], onDelete: SetNull)
  source            String
  note              String?         @db.Text
  occurredAt        DateTime        @default(now())
  createdAt         DateTime        @default(now())
  // EPIC #38 W4 — L2 idempotency for operator-confirmed returns. Deterministic natural
  // key `iclass:return:{iclassId}:{normalizedSerial}` stamped on a RETURN confirm so a
  // double-confirm / concurrent-confirm hits a UNIQUE and no-ops (caught as P2002).
  // DO-NOT-CHURN: the UNIQUE is a hand-written PARTIAL index (WHERE sourceRef IS NOT NULL)
  // in 20260612000000_iclass_returns/migration.sql, NOT a Prisma @@unique — @@unique would
  // index NULLs and collide across the many legacy rows. Keep the column plain here; do not
  // add @@unique([sourceRef]) or `prisma migrate` will try to recreate a full-NULL index.
  sourceRef         String?
  // EPIC #38 W6 — back-relation: deduction suggestion that consumed via this movement.
  deductionSuggestion MaterialDeductionSuggestion? @relation("DeductionMovement")

  @@index([assetId, type])
  @@index([materialCatalogId])
  @@index([taskId])
  @@index([occurredAt])
  // Wave 7 (Capstone) — composite index for type filter + occurredAt DESC order.
  // sort: Desc matches the hand-written migration SQL: ("type","occurredAt" DESC)
  @@index([type, occurredAt(sort: Desc)])
}

// EPIC #38 W4 — closure-detected equipment RETURN suggestion. Staged (read-only) when a
// completed RETIRO SO closes; an operator later confirms (the ONLY stock mutation) which
// records a RETURN→DEPOSITO movement. One concern per row; the inverse of #19's
// TaskInventorySuggestion (find-existing-asset → return, not create-on-contract).
model ReturnSuggestion {
  id             String        @id @default(uuid())
  taskId         String
  task           ScheduledTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  serviceOrderId String        // IClass iclassId (for sourceRef + traceability)
  serialNumber   String?       // normalized OCR serial
  mac            String?
  deviceType     String?       // hint from the OCR label
  matchedAssetId String?
  matchedAsset   InventoryAsset? @relation("ReturnMatchedAsset", fields: [matchedAssetId], references: [id], onDelete: SetNull)
  status         String   @default("pending") // pending | needs_review | confirmed | discarded
  resolution     String?  // return | link | create | discard
  confirmedMovementId String? // the real movement.id (uuid) produced on confirm (Fix #5)
  sourceRef      String?  // L2 natural key `iclass:return:{assetId}` — the findBySourceRef key (Fix #3/#5)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([serviceOrderId, serialNumber]) // one suggestion per (SO, serial) — dedup on re-stage
  @@index([status])
  @@index([taskId])
}

model Project {
  id             String           @id @default(uuid())
  title          String
  description    String?
  typeId         String?
  type           ProjectType?     @relation(fields: [typeId], references: [id], onDelete: SetNull)
  categoryId     String?
  category       ProjectCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  workflowId     String?
  workflow       Workflow?        @relation(fields: [workflowId], references: [id], onDelete: SetNull)
  projectLeadId  String?
  projectLead    Admin?           @relation(fields: [projectLeadId], references: [id], onDelete: SetNull)
  visible        Boolean          @default(true)
  allowsEquipmentRetirement Boolean @default(false)
  isNetworkProject Boolean        @default(false)
  partners       ProjectPartner[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  tasks          ScheduledTask[]
  iclassSoTypeId String?
  iclassSoType   IClassSoType?    @relation(fields: [iclassSoTypeId], references: [id], onDelete: SetNull)

  // GR ingest config back-relations (fiber / wireless target project mappings)
  grIngestFiber    GestionRealIngestConfig[] @relation("GrIngestFiber")
  grIngestWireless GestionRealIngestConfig[] @relation("GrIngestWireless")

  @@index([title])
  @@index([categoryId])
  @@index([typeId])
  @@index([workflowId])
  @@index([projectLeadId])
  @@index([visible])
  @@index([iclassSoTypeId])
}

model ProjectPartner {
  projectId String
  partnerId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Restrict)

  @@id([projectId, partnerId])
  @@index([partnerId])
}

model ScheduledTask {
  id             String    @id @default(uuid())
  sequenceNumber Int       @unique @default(autoincrement())
  title          String
  description    String?
  stageId        String
  stage          Stage     @relation(fields: [stageId], references: [id], onDelete: Restrict)
  priority       String    @default("normal")
  estimatedHours Float     @default(1)
  address        String?
  lat            Float?
  lng            Float?
  category       String    @default("installation")
  notes          String?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  projectId      String?
  project        Project?  @relation(fields: [projectId], references: [id])

  // NEW — datetime envelope
  startDate DateTime?
  endDate   DateTime?

  // NEW — FK relations
  customerId  String?
  customer    Client?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  contractId  String?
  contract    Contract? @relation(fields: [contractId], references: [id], onDelete: SetNull)
  partnerId  String?
  partnerRef Partner?  @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  reporterId String?
  reporter   RbacUser? @relation("TaskReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  assigneeId String?
  assignee   RbacUser? @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  // NEW — travel time (minutes)
  travelTimeTo   Int?
  travelTimeFrom Int?

  // NEW — watchers pivot back-relation
  watchers TaskWatcher[]

  // NEW — checklist back-relation
  checklist TaskChecklistItem[]

  // NEW — comments back-relation
  comments TaskComment[]

  // task-photos — fotos/adjuntos de la tarea (galería)
  attachments ScheduledTaskAttachment[]

  // Material consumption ledger per task
  materialConsumptions TaskMaterialConsumption[]

  // IClass closure → inventory: staged suggestions for this task
  inventorySuggestions TaskInventorySuggestion[]

  // #41 — lifecycle management state (single source of truth). isClosed is derived.
  generalStatus String @default("open")
  // Flag: task is closed (soft-close, not deleted). Derived from generalStatus; synced on write for ops tooling.
  isClosed Boolean @default(false)

  // #86 — archive flag. Only closed/dismissed tasks can be archived. Null = not archived.
  archivedAt DateTime?

  // RV — inventory team review flag
  reviewedByInventory       Boolean   @default(false)
  reviewedByInventoryAt     DateTime?
  reviewedByInventoryUserId String?
  reviewedByInventoryUser   RbacUser? @relation("TaskInventoryReviewer", fields: [reviewedByInventoryUserId], references: [id], onDelete: SetNull)

  // Closure completeness (#14) — per-task flags to measure/auto-complete closure processes.
  // closureHasDeviceInventory counts only DEVICE items (ONU/router/…), NOT materials.
  closureCommentDone        Boolean   @default(false)
  closureAuditDone          Boolean   @default(false)
  closureHasDeviceInventory Boolean   @default(false)

  // IClass — service order code returned when the task is sent to IClass
  iclassOrderCode String?

  // Gestión Real — upstream service order id this task was ingested from.
  // Null for manually-created tasks. NULL-distinct unique = idempotency backstop.
  grOrdenId String? @unique

  // Ticket FK (tickets-actions-be) — optional link to a support ticket.
  ticketId String?
  ticket   Ticket? @relation(fields: [ticketId], references: [id], onDelete: SetNull)

  // network-node-task (#29) — discriminator + FK a NetworkSite
  kind          String       @default("customer")
  networkSiteId String?
  networkSite   NetworkSite? @relation(fields: [networkSiteId], references: [id], onDelete: SetNull)

  // #54 — task-level locality snapshot for network tasks. Required on create/update
  // when kind='network'. Dispatch precedence: iclassCityCode ?? networkSite?.city ?? null.
  // Nullable + additive: existing tasks fall back to site.city (back-compat, no backfill).
  iclassCityCode String?

  // #66 — Red/FO switch. networkType = 'red' (FK to networkSite) | 'fibra' (free-text node).
  // NULL treated as 'red' for back-compat (backfill sets it on existing network rows).
  networkType String?
  // Stored free-text node name for fibra tasks (networkSiteId is NULL for fibra).
  // For red tasks the name is JOIN-derived from networkSite.name; this column stays NULL.
  networkSiteName String?

  // iclass-status-sync — current IClass OS status code (opaque IClass id).
  // Null until the scheduler first captures it. Label/color resolved by JOIN at read time.
  iclassStatusCode      String?
  iclassStatusUpdatedAt DateTime?

  // IClass closure loop — mirror of the closed SO, linked back by codigo↔sequenceNumber
  iclassClosedOrder IClassServiceOrder?

  // IClass dispatch audit — intentos de envio a IClass (exito/fallo)
  iclassDispatchAttempts IClassDispatchAttempt[]

  // F6 — auditoría IA de la calidad de instalación (1 vigente por tarea)
  installationAudit TaskInstallationAudit?

  // task-activity-log — append-only audit feed for this task
  activities ScheduledTaskActivity[]

  // Inventory Foundation (W1) — back-relations
  sourcedAssets     InventoryAsset[]    @relation("AssetSourceTask")
  inventoryMovements InventoryMovement[] @relation("MovementTask")

  // EPIC #38 W4 — closure-detected return suggestions staged for this task
  returnSuggestions ReturnSuggestion[]
  // EPIC #38 W6 — material deduction suggestions staged for this task
  materialDeductionSuggestions MaterialDeductionSuggestion[]

  @@index([stageId])
  @@index([projectId])
  @@index([startDate])
  @@index([endDate])
  @@index([customerId])
  @@index([contractId])
  @@index([partnerId])
  @@index([assigneeId])
  @@index([reporterId])
  @@index([ticketId])
  @@index([networkSiteId])
  @@index([archivedAt])
}

// task-activity-log — append-only audit feed. One row per change on a task
// (created, stage/priority/assignee changes, comments, checklist ops, ...).
// `actorName` is a snapshot so entries survive a later user rename/delete.
model ScheduledTaskActivity {
  id         String        @id @default(uuid())
  taskId     String
  task       ScheduledTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  type       String        // ActivityType union — kept as String for forward-compat
  actorId    String?
  actor      RbacUser?     @relation("TaskActivityActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorName  String        // snapshot — survives user rename/delete
  fromValue  Json?
  toValue    Json?
  metadata   Json?
  createdAt  DateTime      @default(now())

  @@index([taskId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([actorId])
}

model TaskWatcher {
  taskId  String
  adminId String
  task    ScheduledTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user    RbacUser      @relation("TaskWatcher", fields: [adminId], references: [id], onDelete: Cascade)

  @@id([taskId, adminId])
  @@index([adminId])
}

model TaskTemplate {
  id          String             @id @default(uuid())
  name        String             @unique
  description String?
  category    String             @default("other")
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  items       TaskTemplateItem[]
}

model TaskTemplateItem {
  id              String              @id @default(uuid())
  templateId      String
  template        TaskTemplate        @relation(fields: [templateId], references: [id], onDelete: Cascade)
  text            String
  order           Int
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  checklistCopies TaskChecklistItem[]

  @@index([templateId, order])
}

model TaskChecklistItem {
  id                 String            @id @default(uuid())
  taskId             String
  task               ScheduledTask     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  text               String
  done               Boolean           @default(false)
  order              Int
  fromTemplateItemId String?
  fromTemplateItem   TaskTemplateItem? @relation(fields: [fromTemplateItemId], references: [id], onDelete: SetNull)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([taskId, order])
}

model TaskComment {
  id          String                  @id @default(uuid())
  taskId      String
  task        ScheduledTask           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorName  String
  body        String
  createdAt   DateTime                @default(now())
  attachments TaskCommentAttachment[]

  @@index([taskId])
}

model TaskCommentAttachment {
  id        String      @id @default(uuid())
  commentId String
  comment   TaskComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  url       String
  filename  String
  mimeType  String?
  sizeBytes Int?

  @@index([commentId])
}

// task-photos — fotos/adjuntos de una ScheduledTask (galería). Espejo de
// TaskCommentAttachment, pero el binario vive en el storage (MinIO/FileStorage) bajo
// `storageKey` (no una url pública). onDelete: Cascade ⟹ al borrar la tarea se borran
// sus filas de adjunto (el binario lo limpia el use case vía FileStorage).
model ScheduledTaskAttachment {
  id           String        @id @default(uuid())
  taskId       String
  task         ScheduledTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  storageKey   String
  filename     String
  mimeType     String
  sizeBytes    Int
  width        Int?
  height       Int?
  uploadedById String
  createdAt    DateTime      @default(now())

  @@index([taskId])
}

// #44 — Conversación persistida de tickets con adjuntos inline (espejo de TaskComment).
model TicketComment {
  id          String                    @id @default(uuid())
  ticketId    String
  ticket      Ticket                    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorName  String
  body        String
  createdAt   DateTime                  @default(now())
  attachments TicketCommentAttachment[]

  @@index([ticketId])
}

model TicketCommentAttachment {
  id        String        @id @default(uuid())
  commentId String
  comment   TicketComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  url       String
  filename  String
  mimeType  String?
  sizeBytes Int?

  @@index([commentId])
}

// F6 — Auditoría IA de la instalación. Run padre (1 vigente por tarea, replace-on-rerun)
// + hallazgos estructurados (severidad/categoría/texto/fotos).
model TaskInstallationAudit {
