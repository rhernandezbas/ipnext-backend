model NetworkSite {
  id           String        @id @default(uuid())
  // network-site-fixed-code (#51) — número estable por sitio, secuencia dedicada.
  // Mismo patrón serial que ScheduledTask.sequenceNumber: Prisma genera/posee
  // la secuencia `"NetworkSite_siteNumber_seq"`. La migración 20260706000000 la
  // crea con OWNED BY + backfill para datos existentes (autoincrement no backfillea).
  siteNumber   Int           @unique @default(autoincrement())
  name         String
  address      String?
  city         String?
  lat          Float?
  lng          Float?
  type         String        @default("nodo")
  status       String        @default("active")
  deviceCount  Int           @default(0)
  clientCount  Int           @default(0)
  uplink       String?
  parentSiteId String?
  parent       NetworkSite?  @relation("SiteHierarchy", fields: [parentSiteId], references: [id])
  children     NetworkSite[] @relation("SiteHierarchy")
  description  String?
  createdAt    DateTime      @default(now())

  // network-node-task (#29) — código de nodo en IClass para envío de OS de RED
  iclassNodeCode String?

  // uisp-integration — optional link to the UISP mirror site (uispId TEXT).
  // Intentionally NO @relation FK: the mirror re-upserts by uispId TEXT;
  // validation is enforced at the application layer (not DB), same reasoning
  // as UispDevice.uispSiteId.
  uispSiteId String?

  // Back-relation: tareas de RED vinculadas a este nodo
  scheduledTasks ScheduledTask[]

  // contract-node-ap-catalog (Bulk WhatsApp F2/F3) — back-relations
  accessPoints AccessPoint[]
  contracts    Contract[]

  @@index([uispSiteId])
}

/// Derived catalog of Access Points — UISP devices with role='ap'. Auto-seeded by
/// SyncUispMirror from the UispDevice mirror (step 9); NOT hand-editable, the sync owns it.
/// Each AP links to its NetworkSite (nodo) via networkSiteId, resolved by matching
/// UispDevice.uispSiteId === NetworkSite.uispSiteId. Powers the Bulk WhatsApp F2/F3
/// segmentation by node/AP. Never auto-deleted (retired APs are stamped missingSince).
model AccessPoint {
  id            String       @id @default(uuid())
  /// UISP device UUID (UispDevice.uispId) — the upsert key. One AccessPoint per AP device.
  uispDeviceId  String       @unique
  networkSiteId String?
  networkSite   NetworkSite? @relation(fields: [networkSiteId], references: [id], onDelete: SetNull)
  name          String
  mac           String?
  // FIX-2: retired-AP marker — stamped by SyncUispMirror when the device vanishes from UISP
  // or drops role='ap'. Null while live. Fase B's assignment selector filters these out.
  missingSince  DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  // Back-relation: contratos asignados a este AP (Fase B)
  contracts Contract[]

  @@index([networkSiteId])
}

model NasServer {
  id           String    @id @default(uuid())
  name         String
  type         String
  ipAddress    String
  radiusSecret String?
  nasIpAddress String?
  apiPort      Int?
  apiLogin     String?
  apiPassword  String?
  status       String    @default("active")
  lastSeen     DateTime?
  clientCount  Int       @default(0)
  description  String?
  createdAt    DateTime  @default(now())
  pppoeServices PppoeService[]
  radiusEvents  RadiusEvent[]
}

model RadiusEvent {
  id             String    @id @default(uuid())
  /// = radacct.acctuniqueid — THE idempotency key. Upsert target.
  sourceUniqueId String    @unique
  username       String
  nasIpAddress   String
  nasId          String?
  framedIp       String?
  macAddress     String?
  vlanId         Int?
  startedAt      DateTime
  stoppedAt      DateTime?
  sessionTime    Int?
  bytesIn        BigInt    @default(0)
  bytesOut       BigInt    @default(0)
  eventType      String                    // 'start' | 'stop' | 'interim'
  status         String                    // 'online' | 'closed' — denormalized for indexed filter
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  nas            NasServer? @relation(fields: [nasId], references: [id], onDelete: SetNull)

  @@index([username])
  @@index([nasId])
  @@index([nasIpAddress])
  @@index([vlanId])
  @@index([startedAt])
  @@index([stoppedAt])
  @@index([status])
  @@index([username, startedAt])
}

/// Espejo de eventos de AUTENTICACIÓN RADIUS (radpostauth), ingestados desde el
/// radius-orchestrator (GET /postauth). Permite ver intentos de auth (Access-Accept/Reject).
model RadiusAuthEvent {
  id             String   @id @default(uuid())
  /// = radpostauth source id — THE idempotency key. Upsert target.
  sourceUniqueId String   @unique
  username       String
  reply          String                   // 'Access-Accept' | 'Access-Reject'
  authdate       DateTime
  class          String?
  /// Motivo del rechazo congelado al ingestar (orchestrator GET /postauth):
  /// 'user_not_found' | 'session_stuck' | 'other'. null para Access-Accept o históricos viejos.
  reason         String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([username])
  @@index([reply])
  @@index([authdate])
  @@index([reply, authdate])
}

model PppoeService {
  id            String    @id @default(uuid())
  username      String    @unique
  password      String
  profile       String?
  remoteAddress String?
  status        String    @default("enabled")
  // Fase C — estado del CORTE (separado del profile comercial): active | reduced | blocked
  enforcedState String    @default("active")
  // pppoe-preprovision (D1): NULLABLE — nasId NULL = pre-provisión "pendiente de instalación"
  // (el usuario vive en el RADIUS central sin Framed-IP; el watcher lo adopta al conectar).
  nasId         String?
  contractId    String?
  callerId      String?   // MAC del CPE (persistida de la última sesión vista — sobrevive a la desconexión)
  // pppoe-pool-ip: modo de asignación de IP — 'pool' (FreeRADIUS asigna del pool del NAS, framedIp null) | 'fixed' (Framed-IP-Address pineada).
  ipMode        String    @default("fixed")
  // pppoe-preprovision (D2): tipo de IP elegido al crear — 'cgnat' | 'public'. Obligatorio en el
  // CREATE (zod 422); default para las filas legacy (backfill de públicas en la migración).
  ipTypePreference String @default("cgnat")
  createdAt     DateTime  @default(now())
  // onDelete/onUpdate EXPLÍCITOS = los del FK original (Restrict/Cascade): al pasar la relación a
  // opcional el default de Prisma cambia a SetNull — borrar un NAS convertiría a sus servicios en
  // "pendientes de instalación" masivos por accidente. Restrict preserva la semántica de prod.
  nas           NasServer? @relation(fields: [nasId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  contract      Contract? @relation(fields: [contractId], references: [id], onDelete: SetNull)

  @@index([nasId])
  @@index([contractId])
}

/// pppoe-move-nas (REQ-LOG-1 / design D6 punto 2) — registro VISIBLE de movimientos de NAS.
/// TODO intento de move (manual o auto, con o sin contrato) persiste una fila con su outcome:
/// 'moved' | 'failed_no_free_ip' | 'failed_orchestrator' | 'failed_db' | 'failed_router' | 'skipped_public' | 'skipped_unknown_nas'.
/// Append-only. Sin FKs a propósito: fromNasId/toNasId/pppoeServiceId son referencias blandas —
/// el log de auditoría debe sobrevivir al borrado del NAS/servicio (patrón RadiusEvent, sin cascada).
model PppoeNasMoveEvent {
  id             String   @id @default(uuid())
  username       String
  pppoeServiceId String?
  fromNasId      String?
  toNasId        String?
  fromIp         String?
  toIp           String?
  trigger        String            // 'manual' | 'auto'
  outcome        String            // 'moved' | 'failed_no_free_ip' | 'failed_orchestrator' | 'failed_db' | 'failed_router' | 'skipped_public' | 'skipped_unknown_nas' | 'skipped_stale_session' | 'skipped_nas_conflict' (D-W2.5; String libre — outcomes nuevos SIN migración)
  reason         String?
  actorName      String?
  createdAt      DateTime @default(now())

  @@index([createdAt])
  @@index([username])
  @@index([outcome, createdAt])
  @@index([trigger, createdAt])
}

/// radius-session-autocure (REQ-CURE-5) — registro VISIBLE de intentos de curación de sesiones
/// RADIUS colgadas (watcher AutoCureStuckSessions o manual). Molde 1:1 de PppoeNasMoveEvent:
/// append-only, soft refs sin FK (el log sobrevive al borrado de NAS/servicio), outcome String
/// libre (outcomes nuevos sin migración).
/// outcome: 'cured' | 'already_cured' | 'skipped_alive' | 'skipped_ambiguous' |
///          'skipped_no_session' | 'skipped_no_signal' | 'flagged_flapping' | 'failed'
/// signalUsed: 'persistent_rejects' (fast path) | 'stale_interim' (camino clásico) | null (skips)
model RadiusSessionCureEvent {
  id                String    @id @default(uuid())
  username          String
  nasIp             String?
  sessionId         String?
  sessionStartedAt  DateTime?
  sessionLastUpdate DateTime?
  signalUsed        String?           // 'persistent_rejects' | 'stale_interim'
  trigger           String            // 'auto' | 'manual'
  action            String?           // 'both' | 'acct_close' | 'coa' | null
  outcome           String            // 'cured' | 'already_cured' | 'skipped_alive' | 'skipped_ambiguous' | 'skipped_no_session' | 'skipped_no_signal' | 'flagged_flapping' | 'failed'
  reason            String?
  actorName         String?           // 'sistema' (auto) | nombre del operador (manual)
  createdAt         DateTime @default(now())

  @@index([createdAt])
  @@index([username])
  @@index([outcome, createdAt])
  @@index([trigger, createdAt])
}

