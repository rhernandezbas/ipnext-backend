datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// =============================================
// ADMIN DOMAIN
// =============================================

model Admin {
  id           String             @id @default(uuid())
  name         String
  email        String             @unique
  role         String // role-definition name (editable, backed by AdminRoleDefinition)
  status       AdminStatus        @default(active)
  twoFaEnabled Boolean            @default(false)
  twoFaSecret  String?
  lastLogin    DateTime?
  passwordHash String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  sessions     AdminSession[]
  projectsLed  Project[]
}

enum AdminRole {
  superadmin
  admin
  viewer
  engineer
  financial_manager
  support_agent
  technician
}

enum AdminStatus {
  active
  inactive
}

model AdminSession {
  id         String   @id @default(uuid())
  adminId    String
  admin      Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  ip         String
  userAgent  String?
  city       String?
  country    String?
  loginAt    DateTime @default(now())
  lastSeenAt DateTime @default(now())
  active     Boolean  @default(true)

  @@index([adminId])
}

model AdminRoleDefinition {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false)
  permissions Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("admin_role_definitions")
}

// =============================================
// FEATURE FLAGS
// =============================================

// Runtime feature flags persisted in DB, toggleable via admin API.
// First flag: `iclass-integration` (seeded OFF until validated in prod).
model FeatureFlag {
  key       String   @id
  enabled   Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

// =============================================
// CRM DOMAIN
// =============================================

enum LeadStatus {
  new_lead      @map("new")
  contacted
  qualified
  proposal_sent
  won
  lost
}

enum LeadSource {
  website
  referral
  cold_call
  social_media
  other
}

model Lead {
  id                String     @id @default(uuid())
  name              String
  email             String?
  phone             String?
  address           String?
  city              String?
  source            LeadSource @default(other)
  status            LeadStatus @default(new_lead)
  assignedTo        String?
  assignedToId      String?
  interestedIn      String?
  notes             String?
  followUpDate      DateTime?
  convertedAt       DateTime?
  convertedClientId String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@index([status])
}

model Partner {
  id           String           @id @default(uuid())
  name         String
  status       String           @default("active")
  primaryEmail String?
  phone        String?
  address      String?
  city         String?
  country      String?
  timezone     String?
  currency     String?
  logoUrl      String?
  clientCount  Int              @default(0)
  adminCount   Int              @default(0)
  comision     Float?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  projects     ProjectPartner[]
  tasks        ScheduledTask[]
}

// =============================================
// MESSAGING DOMAIN
// =============================================

model Message {
  id        String    @id @default(uuid())
  subject   String
  body      String
  fromId    String
  fromName  String
  toId      String?
  toName    String?
  clientId  String?
  channel   String    @default("internal")
  status    String    @default("unread")
  threadId  String?
  sentAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([clientId])
  @@index([status])
}

model Client {
  id               String          @id @default(uuid())
  splynxId         String?         @unique
  grClienteId      String?         @unique
  name             String
  email            String
  phone            String
  status           ClientStatus    @default(active)
  address          String?
  city             String?
  country          String?
  login            String          @unique
  customAttributes Json?
  // GR balance fields — null until first fetch; 0 = no debt
  balanceDue       Decimal?        @db.Decimal(12, 2)
  balanceCurrency  String?
  lastBalanceAt    DateTime?
  // #72 — local TV-cancel flag. Set by CancelTv on teardown; cleared by Link/Register on re-link.
  // GR sync NEVER writes this — it's mirror-only state (the partner has no unlink primitive).
  tvCancelledAt    DateTime?
  // #81 — contador de reactivaciones de TV POR CLIENTE. seq=0 = identidad de hoy (internal_id =
  // Client.id crudo, mail sin sufijo). Se incrementa SOLO en re-alta para mintear un internal_id +
  // mail frescos, nunca quemados en el partner. GR sync NUNCA escribe esta columna (mirror-only).
  tvActivationSeq  Int             @default(0)
  // #10/#11 — async TV-cancel status fields. Mirror-only; GR sync NEVER writes these.
  // tvCancelStatus: 'pending' | 'running' | 'done' | 'failed' | null
  // tvCancelResult: CancelTvResult JSON on done; {error} on failed
  // tvCancelStartedAt: when the runner transitioned to 'running'
  tvCancelStatus    String?
  tvCancelResult    Json?
  tvCancelStartedAt DateTime?
  // client-geolocation — Prominense-owned GPS (NOT from GR). GR sync NEVER writes these.
  lat              Float?
  lng              Float?
  plusCode         String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  contracts        Contract[]
  logs             ClientLog[]
  invoices         Invoice[]
  tasks            ScheduledTask[]
  tickets          Ticket[]
  // #80 — Recaptación back-relation
  recaptureLeads   RecaptureLead[]
  // #5 BE — TV activation history back-relation
  tvActivationEvents TvActivationEvent[]

  @@index([status])
  @@index([email])
}

enum ClientStatus {
  active
  late
  blocked
  inactive
  baja
}

model Contract {
  id           String          @id @default(uuid())
  clientId     String
  grContratoId String?         @unique
  type         String
  plan         String
  ip           String?
  status       String          @default("active")
  startDate    DateTime
  endDate      DateTime?
  address      String?
  lat          Float?
  lng          Float?
  // client-geolocation — Prominense-owned GPS separate from GR lat/lng. GR sync NEVER writes these.
  gpsLat       Float?
  gpsLng       Float?
  gpsPlusCode  String?
  technology   String?         // Phase 1: free-text name from ContractTechnology catalog. NOT a FK.
  name         String?         // #43 manual-only identifier. GR sync NEVER writes this.
  vendedor     String?         // GR `vendedor` — agente que dio de alta. Base de la cartera por agente.
  createdAt    DateTime        @default(now())
  client         Client                   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tasks          ScheduledTask[]
  tickets        Ticket[]
  installedItems ContractInstalledItem[]
  stockLocations StockLocation[]          @relation("ContractStockLocation")
  contractServices      ContractService[]
  contractServiceEvents ContractServiceEvent[]
  pppoeServices         PppoeService[]

  @@index([clientId])
  @@index([status])
}

model ClientLog {
  id          String   @id @default(uuid())
  clientId    String
  timestamp   DateTime @default(now())
  eventType   String
  description String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

model Invoice {
  id           String        @id @default(uuid())
  number       String        @unique
  clientId     String
  customerName String
  issueDate    DateTime
  dueDate      DateTime
  amount       Decimal       @db.Decimal(12, 2)
  status       InvoiceStatus @default(pendiente)
  lineItems    Json
  createdAt    DateTime      @default(now())
  client       Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([status])
  @@index([dueDate])
}

enum InvoiceStatus {
  pagada
  pendiente
  vencida
}

model ClientComment {
  id         String   @id @default(uuid())
  clientId   String
  authorName String
  content    String
  createdAt  DateTime @default(now())

  @@index([clientId])
}

model Notification {
  id        String    @id @default(uuid())
  type      String
  title     String
  message   String
  severity  String    @default("info")
  read      Boolean   @default(false)
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())
}

// =============================================
// FINANCE DOMAIN
// =============================================

model CreditNote {
  id               String    @id @default(uuid())
  number           String    @unique
  clientId         String
  clientName       String
  amount           Float
  taxAmount        Float     @default(0)
  totalAmount      Float
  reason           String
  relatedInvoiceId String?
  status           String    @default("draft")
  notes            String?
  issuedAt         DateTime  @default(now())
  appliedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([clientId])
}

model ProformaInvoice {
  id                   String    @id @default(uuid())
  number               String    @unique
  clientId             String
  clientName           String
  items                Json
  subtotal             Float
  taxAmount            Float     @default(0)
  total                Float
  status               String    @default("draft")
  notes                String?
  issuedAt             DateTime  @default(now())
  validUntil           DateTime?
  convertedToInvoiceId String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([clientId])
}

model FinanceHistoryEvent {
  id          String   @id @default(uuid())
  type        String
  description String
  clientId    String
  clientName  String
  amount      Float?
  referenceId String?
  adminId     String
  adminName   String
  occurredAt  DateTime @default(now())

  @@index([clientId])
  @@index([occurredAt])
}

// =============================================
// SETTINGS DOMAIN
// =============================================

model SystemSettings {
  id            String   @id @default("singleton")
  companyName   String   @default("IPNEXT")
  timezone      String   @default("America/Argentina/Buenos_Aires")
  currency      String   @default("ARS")
  language      String   @default("es")
  dateFormat    String   @default("DD/MM/YYYY")
  invoicePrefix String   @default("FAC")
  supportEmail  String?
  website       String?
  updatedAt     DateTime @updatedAt
}

model EmailSettings {
  id           String   @id @default("singleton")
  smtpHost     String?
  smtpPort     Int      @default(587)
  smtpUser     String?
  smtpPassword String?
  fromName     String?
  fromEmail    String?
  useTls       Boolean  @default(true)
  updatedAt    DateTime @updatedAt
}

model MessageTemplate {
  id        String   @id @default(uuid())
  name      String
  type      String
  subject   String?
  body      String
  variables Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ApiToken {
  id          String    @id @default(uuid())
  name        String
  token       String    @unique
  permissions Json
  lastUsed    DateTime?
  createdAt   DateTime  @default(now())
}

model PaymentMethod {
  id      String  @id @default(uuid())
  name    String
  type    String
  enabled Boolean @default(true)
  config  Json?
}

model Webhook {
  id            String    @id @default(uuid())
  name          String
  url           String
  events        Json
  secret        String?
  status        String    @default("active")
  lastTriggered DateTime?
  lastStatus    String?
  createdAt     DateTime  @default(now())
}

model BackupRecord {
  id          String   @id @default(uuid())
  filename    String
  sizeBytes   Int
  type        String   @default("manual")
  status      String   @default("completed")
  downloadUrl String?
  createdAt   DateTime @default(now())
}

model ClientPortalSettings {
  id                       String   @id @default("singleton")
  enabled                  Boolean  @default(false)
  portalUrl                String?
  allowSelfRegistration    Boolean  @default(false)
  requireEmailVerification Boolean  @default(true)
  allowPaymentOnline       Boolean  @default(false)
  allowTicketCreation      Boolean  @default(true)
  allowServiceManagement   Boolean  @default(false)
  welcomeMessage           String?
  logoUrl                  String?
  primaryColor             String   @default("#3B82F6")
  customCss                String?
  updatedAt                DateTime @updatedAt
}

// =============================================
// SCHEDULING DOMAIN
// =============================================

enum StageCategory {
  nuevo
  enProgreso
  hecho
}

model Workflow {
  id          String    @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  stages      Stage[]
  projects    Project[]
}

model Stage {
  id         String          @id @default(uuid())
  workflowId String
  workflow   Workflow        @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  name       String
  code       String          // identidad de negocio, inmutable, slug
  category   StageCategory
  order      Int
  color      String?
  tasks      ScheduledTask[]

  // IClass closure loop — result codes that move a task to THIS stage on closure
  iclassResultCodes IClassResultCode[] @relation("ResultCodeMappedStage")

  // iclass-intermediate-states — IClass status codes mapped to THIS stage (auto-move target)
  iclassStatusCatalogs IClassStatusCatalog[] @relation("StatusCatalogProminenseStage")

  @@unique([workflowId, code])
  @@index([workflowId, order])
}

model ProjectCategory {
  id          String    @id @default(uuid())
  name        String
  description String?
  projects    Project[]
}

// Editable catalog of task categories. ScheduledTask.category stores the name
// (free text), so there is no FK relation here — the catalog drives the UI dropdown.
model TaskCategory {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("TaskCategory")
}

// Editable catalog of contract technologies (Fiber, DOCSIS, Wireless, ...).
// Contract.technology stores the name (free text) — no FK relation in Phase 1.
model ContractTechnology {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("ContractTechnology")
}

// Editable catalog of task priorities, with a colour and a sort weight.
// ScheduledTask.priority stores the name (free text).
model TaskPriority {
  id        String   @id @default(uuid())
  name      String   @unique
  color     String
  weight    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("TaskPriority")
}

// Editable catalog of inventory device types (ONU, ROUTER, ANTENA, ...).
// ContractInstalledItem.type + TaskInventorySuggestion.deviceType store the NAME
// (free-text String). Validation (OCR normalize, confirm guard, route guard) reads
// the active names from this table instead of a hardcoded enum.
model DeviceTypeCatalog {
  id        String   @id @default(uuid())
  name      String   @unique          // canonical, UPPERCASE (ONU, ROUTER, ...)
  label     String?                   // optional human label for the UI
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Inventory Foundation (W1) — assets of this device type
  assets    InventoryAsset[] @relation("AssetDeviceType")

  @@map("DeviceTypeCatalog")
}

// #43 — editable catalog of contracted service types (INTERNET, TV, VOZ, CAMARAS, OTROS).
// Mirrors DeviceTypeCatalog. OTROS is non-deletable (use-case guard).
model ServiceCatalog {
  id        String   @id @default(uuid())
  name      String   @unique          // canonical, UPPERCASE (INTERNET, TV, ...)
  label     String?                   // optional human label for the UI
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contractServices ContractService[]
}

// #43 — pivot linking a Contract to a ServiceCatalog entry.
model ContractService {
  id               String   @id @default(uuid())
  contractId       String
  serviceCatalogId String
  status           String   @default("active")  // active | inactive
  notes            String?
  tvLogin          String?  // #65 Gigared Play login (GIGA{abonado}) — null para servicios no-TV
  tvPassword       String?  // #65 contraseña determinística del alta TV (visible al operador)
  createdAt        DateTime @default(now())
  deactivatedAt    DateTime?  // #73 set when status transitions to inactive; null while active

  contract       Contract       @relation(fields: [contractId], references: [id], onDelete: Cascade)
  serviceCatalog ServiceCatalog @relation(fields: [serviceCatalogId], references: [id], onDelete: Restrict)

  @@unique([contractId, serviceCatalogId])
  @@index([contractId])
}

model MaterialCatalog {
  id        String   @id @default(uuid())
  name      String   @unique          // canonical, UPPERCASE (CABLE_UTP, CONECTOR_RJ45, ...)
  label     String?                   // optional human label for the UI
  unit      String?                   // "m" | "unidad" | "rollo" — default applied in use-case
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  // Wave 7 (Capstone) — global low-stock threshold. 0 = no alert configured.
  minStock  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  consumptions TaskMaterialConsumption[]
  // Inventory Foundation (W1) — stock balances + ledger movements
  stocks       MaterialStock[]     @relation("MaterialStock")
  movements    InventoryMovement[] @relation("MaterialMovement")
  // EPIC #38 W6 — deduction suggestions for this material
  deductionSuggestions MaterialDeductionSuggestion[]

  @@map("MaterialCatalog")
}

model TaskMaterialConsumption {
  id                String          @id @default(uuid())
  taskId            String
  task              ScheduledTask   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  materialCatalogId String
  material          MaterialCatalog @relation(fields: [materialCatalogId], references: [id], onDelete: Restrict)
  materialName      String          // snapshot del nombre al momento del consumo
  quantity          Float
  unit              String?
  notes             String?         @db.Text
  recordedByUserId  String?
  recordedByUser    RbacUser?       @relation("TaskMaterialRecorder", fields: [recordedByUserId], references: [id], onDelete: SetNull)
  // EPIC #38 W6 — link to the deduction that consumed this stock. Null = never deducted.
  deductedAt        DateTime?
  deductedMovementId String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  // W6 back-relation
  deductionSuggestion MaterialDeductionSuggestion?

  @@index([taskId])
}

// EPIC #38 W6 — operator surface for semi-automatic technician stock deduction.
// Staged (read-only) on every consumption; operator confirms (the ONLY mutation) via
// ConfirmMaterialDeduction (UnitOfWork, atomic). Mirror of ReturnSuggestion (W4).
model MaterialDeductionSuggestion {
  id                       String                  @id @default(uuid())
  // L1 unique: one consumption → at most one suggestion. DO NOT change to @@unique;
  // see the hand-written UNIQUE index in the migration (same reason as W4 sourceRef).
  taskMaterialConsumptionId String                 @unique
  consumption               TaskMaterialConsumption @relation(fields: [taskMaterialConsumptionId], references: [id], onDelete: Cascade)
  taskId                   String
  task                     ScheduledTask           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  technicianId             String?
  materialCatalogId        String
  material                 MaterialCatalog         @relation(fields: [materialCatalogId], references: [id], onDelete: Restrict)
  qty                      Decimal                 @db.Decimal(12,4)
  technicianLocationId     String?
  status                   String                  @default("pending") // pending | needs_review | confirmed | discarded
  resolution               String?                 // deduct | issue-first | depot | discard
  // L2 natural key: consume:task-material:{consumptionId}
  sourceRef                String?
  deductedMovementId       String?                 @unique
  deductedMovement         InventoryMovement?      @relation("DeductionMovement", fields: [deductedMovementId], references: [id], onDelete: SetNull)
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt

  @@index([status])
  @@index([taskId])
  @@index([sourceRef])
}

model ProjectType {
  id          String    @id @default(uuid())
  name        String
  description String?
  projects    Project[]
}

model IClassSoType {
  id           String    @id @default(uuid())
  code         String    @unique
  description  String
  active       Boolean   @default(true)
  lastSyncedAt DateTime
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  projects     Project[]

  @@index([active])
}

// nodes-city-mapper (#45) — persisted mirror of the IClass node catalog.
// Nodes ARE the cities in Prominense. Upsert key is `nodeId` (stable IClass id).
// `selectable=false` flags grouping nodes that must NOT be assignable to a site.
model IClassNode {
  id           String   @id @default(uuid())
  nodeId       Int      @unique
  code         String
  description  String
  active       Boolean  @default(true)
  selectable   Boolean  @default(true)
  lastSyncedAt DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([active])
}

// iclass-os-actions (Ola B) — IClass team catalog (cuadrillas).
// Keyed by `login` (unique stable identifier from IClass). Clone of IClassNode.
model IClassTeam {
  id             String   @id @default(uuid())
  login          String   @unique
  name           String
  thirdPartyCode String?
  active         Boolean  @default(true)
  selectable     Boolean  @default(true)
  lastSyncedAt   DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([active])
}

// ============================================================================
// IClass closure loop — mirror of CLOSED service orders pulled back from IClass.
// Join to local work: SO.codigo (iclass) == ScheduledTask.sequenceNumber (we send
// soCode=sequenceNumber on create; iclass preserves it as `codigo`).
// ============================================================================

// Catalog of result codes per SO type. `motivoFechamento` on a closed SO equals
// the result-code name (`code`); `type` (Sucesso/Falha) drives the stage transition.
model IClassResultCode {
  id           String   @id @default(uuid())
  soTypeId     BigInt?
  code         String   // motivoFechamento value (the result-code name)
  type         String   // Sucesso | Falha | ...
  // Configurable closure mapping (mirrors Project.iclassSoTypeId): when an SO closes
  // with this result code, the linked task is moved to mappedStage. Null = unmapped
  // (task is NOT moved; left for manual review). Assigned via the admin API/UX.
  mappedStageId String?
  mappedStage   Stage?   @relation("ResultCodeMappedStage", fields: [mappedStageId], references: [id], onDelete: SetNull)
  // Closure-detected returns (EPIC #38 W4): when true, a completed (Sucesso) SO closing
  // with this result code stages equipment-return suggestions. Configurable per code so
  // ops can add removal codes without a redeploy. Default false; seeded true for the 2
  // confirmed retiro codes.
  isRemovalCode Boolean  @default(false)
  lastSyncedAt DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([soTypeId, code])
  @@index([code])
  @@index([mappedStageId])
}

// iclass-status-sync — auto-discovered catalog of IClass OS status codes.
// statusCode is the opaque IClass id (status.id, e.g. "7", "3", "50").
// Entries are auto-upserted on each ingest tick; operator configures displayLabel/color/tracked.
model IClassStatusCatalog {
  id           String   @id @default(uuid())
  statusCode   String   @unique // IClass status.id (opaque string)
  iclassLabel  String   // status.descricao (raw, refreshed on each upsert)
  displayLabel String?  // Prominense editable label; NULL → use iclassLabel
  color        String?  // hex color for the badge (e.g. "#FF5500"); NULL → no color
  tracked      Boolean  @default(false) // opt-in: visible in FE badge/filter
  // iclass-intermediate-states — operator-mapped Prominense Stage (kanban column).
  // When set, the scheduler auto-moves a matched task to this stage on a status change
  // (forward-only). NULL = no auto-move. Preserved by the auto-discovery upsert.
  prominenseStageId String?
  prominenseStage   Stage?  @relation("StatusCatalogProminenseStage", fields: [prominenseStageId], references: [id], onDelete: SetNull)
  lastSyncedAt DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([tracked])
  @@index([prominenseStageId])
}

model IClassServiceOrder {
  id                String  @id @default(cuid())
  iclassId          BigInt  @unique // numeric SO id from IClass
  iclassCodigo      String  @unique // SO `codigo`; equals our ScheduledTask.sequenceNumber for our SOs
  clusterName       String
  thirdPartyCode    String?
  nodeCode          String?
  soTypeId          String? // IClass tipoOs.id — resolves the result-code mapping per SO type
  soTypeDescription String?

  customerCode String?
  customerName String?
  addressCode  String?
  addressLine  String?
  addressCity  String?
  addressLat   Float?
  addressLng   Float?

  statusCode        String // '7' for terminal Concluida
  statusDescription String

  requestedAt      DateTime?
  scheduledFor     DateTime?
  availableAt      DateTime?
  serviceStartedAt DateTime?
  serviceEndedAt   DateTime?
  firstClosedAt    DateTime? // status 4 transition (technician close)
  approvedAt       DateTime? // status 50 transition
  closedAt         DateTime? // status 7 transition (final) — derived from history

  resultCodeName String? // motivoFechamento
  resultCodeType String? // joined from IClassResultCode (Sucesso/Falha)
  closedByLogin  String?
  closedByName   String?
  closeLatitude  Float?
  closeLongitude Float?
  closeGpsAt     DateTime?
  billingAmount  Decimal?  @db.Decimal(12, 2)

  technicianNote String? @db.Text // obsEquipe
  internalNote   String? @db.Text // obs
  commentaryLog  String? @db.Text // raw comentario blob

  teamLogin          String?
  teamTechnicianName String?
  teamPhone          String?
  teamEmail          String?

  // Link back to our task (matched by codigo↔sequenceNumber). Nullable: an SO with
  // no local match is skipped, but the FK stays optional for resilience.
  scheduledTaskId String?        @unique
  scheduledTask   ScheduledTask? @relation(fields: [scheduledTaskId], references: [id], onDelete: SetNull)

  iclassCreatedAt DateTime?
  iclassUpdatedAt DateTime? // alteradoPor.data — idempotency key
  ingestedAt      DateTime  @default(now())
  rawDetail       Json // full SO snapshot for forensics

  // Closure side-effect tracking — lets the manual reprocess re-fire only the
  // effects that have NOT yet succeeded, decoupled from the mirror idempotency.
  commentPosted      Boolean   @default(false) // PostClosureComment succeeded
  inventoryBuilt     Boolean   @default(false) // BuildInventorySuggestions succeeded
  auditDone          Boolean   @default(false) // AuditInstallationQuality persisted
  auditAttempts      Int       @default(0) // audit retries (cap to avoid hammering Ollama)
  lastAuditAttemptAt DateTime? // when the last audit attempt ran
  // EPIC #38 W4 — L1 idempotency for closure-detected returns. Mirrors inventoryBuilt:
  // the processInventoryReturns side-effect stages return suggestions ONLY when false,
  // and sets it true after staging. Re-mirror/re-closure never re-stages.
  inventoryReturnsProcessed Boolean @default(false)

  history          IClassSoStatusHistory[]
  checklists       IClassSoChecklist[]
  materials        IClassSoMaterial[]
  equipmentEvents  IClassSoEquipmentEvent[]

  @@index([clusterName, closedAt])
  @@index([customerCode])
  @@index([iclassUpdatedAt])
  @@index([scheduledTaskId])
}

model IClassSoStatusHistory {
