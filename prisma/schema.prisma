  children     NetworkSite[] @relation("SiteHierarchy")
  description  String?
  createdAt    DateTime      @default(now())

  // network-node-task (#29) — código de nodo en IClass para envío de OS de RED
  iclassNodeCode String?

  // uisp-integration — optional link to the UISP mirror site (uispId TEXT).
