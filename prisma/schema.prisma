// IClass closure → inventory: raw OCR output per scraped photo (audit + reprocess).
model OcrExtraction {
  id             String   @id @default(uuid())
  photoUrl       String   @db.Text
  serviceOrderId String?
  sourceTaskId   String?
  deviceType     String? // ROUTER | ANTENA | ONU | REPETIDOR | OTROS (del label de la pregunta)
  qwenDeviceType String? // clasificación del modelo de visión desde la foto (badge), o null
  sn             String?
  mac            String?
  confidence     Float?
  rawOutput      String?  @db.Text
  provider       String   @default("ollama:gemma3:12b")
  createdAt      DateTime @default(now())

  @@index([sourceTaskId])
