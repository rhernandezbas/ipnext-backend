model TaskComment {
  id          String                  @id @default(uuid())
  taskId      String
  task        ScheduledTask           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorName  String
  body        String
  createdAt   DateTime                @default(now())
  attachments TaskCommentAttachment[]

  @@index([taskId])
