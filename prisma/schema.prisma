datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// =============================================
// ADMIN DOMAIN
// =============================================

model Admin {
  id           String             @id @default(uuid())
  name         String
  email        String             @unique
  role         String // role-definition name (editable, backed by AdminRoleDefinition)
  status       AdminStatus        @default(active)
  twoFaEnabled Boolean            @default(false)
  twoFaSecret  String?
  lastLogin    DateTime?
  passwordHash String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  sessions     AdminSession[]
  projectsLed  Project[]
}

enum AdminRole {
  superadmin
  admin
  viewer
  engineer
  financial_manager
  support_agent
  technician
}

enum AdminStatus {
  active
  inactive
}

model AdminSession {
  id         String   @id @default(uuid())
  adminId    String
  admin      Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  ip         String
  userAgent  String?
  city       String?
  country    String?
  loginAt    DateTime @default(now())
  lastSeenAt DateTime @default(now())
  active     Boolean  @default(true)

  @@index([adminId])
}

model AdminRoleDefinition {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false)
  permissions Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("admin_role_definitions")
}

// =============================================
// FEATURE FLAGS
// =============================================

// Runtime feature flags persisted in DB, toggleable via admin API.
// First flag: `iclass-integration` (seeded OFF until validated in prod).
model FeatureFlag {
  key       String   @id
  enabled   Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

// =============================================
// CRM DOMAIN
// =============================================

enum LeadStatus {
  new_lead      @map("new")
  contacted
  qualified
  proposal_sent
  won
  lost
}

enum LeadSource {
  website
  referral
  cold_call
  social_media
  other
}

model Lead {
  id                String     @id @default(uuid())
  name              String
  email             String?
  phone             String?
  address           String?
  city              String?
  source            LeadSource @default(other)
  status            LeadStatus @default(new_lead)
  assignedTo        String?
  assignedToId      String?
  interestedIn      String?
  notes             String?
  followUpDate      DateTime?
  convertedAt       DateTime?
  convertedClientId String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@index([status])
}

model Partner {
  id           String           @id @default(uuid())
  name         String
  status       String           @default("active")
  primaryEmail String?
  phone        String?
  address      String?
  city         String?
  country      String?
  timezone     String?
  currency     String?
  logoUrl      String?
  clientCount  Int              @default(0)
  adminCount   Int              @default(0)
  comision     Float?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  projects     ProjectPartner[]
  tasks        ScheduledTask[]
}

// =============================================
// MESSAGING DOMAIN
// =============================================

model Message {
  id        String    @id @default(uuid())
  subject   String
  body      String
  fromId    String
  fromName  String
  toId      String?
  toName    String?
  clientId  String?
  channel   String    @default("internal")
  status    String    @default("unread")
  threadId  String?
  sentAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([clientId])
  @@index([status])
}

model Client {
  id               String          @id @default(uuid())
  splynxId         String?         @unique
  grClienteId      String?         @unique
  name             String
  email            String
  phone            String
  status           ClientStatus    @default(active)
  address          String?
  city             String?
  country          String?
  login            String          @unique
  customAttributes Json?
  // GR balance fields — null until first fetch; 0 = no debt
  balanceDue       Decimal?        @db.Decimal(12, 2)
  balanceCurrency  String?
  lastBalanceAt    DateTime?
  // #72 — local TV-cancel flag. Set by CancelTv on teardown; cleared by Link/Register on re-link.
  // GR sync NEVER writes this — it's mirror-only state (the partner has no unlink primitive).
  tvCancelledAt    DateTime?
  // #81 — contador de reactivaciones de TV POR CLIENTE. seq=0 = identidad de hoy (internal_id =
  // Client.id crudo, mail sin sufijo). Se incrementa SOLO en re-alta para mintear un internal_id +
  // mail frescos, nunca quemados en el partner. GR sync NUNCA escribe esta columna (mirror-only).
  tvActivationSeq  Int             @default(0)
  // #10/#11 — async TV-cancel status fields. Mirror-only; GR sync NEVER writes these.
  // tvCancelStatus: 'pending' | 'running' | 'done' | 'failed' | null
  // tvCancelResult: CancelTvResult JSON on done; {error} on failed
  // tvCancelStartedAt: when the runner transitioned to 'running'
  tvCancelStatus    String?
  tvCancelResult    Json?
  tvCancelStartedAt DateTime?
  // client-geolocation — Prominense-owned GPS (NOT from GR). GR sync NEVER writes these.
  lat              Float?
  lng              Float?
  plusCode         String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  // messaging-bulk (F2) — null = contactable. IS NOT NULL = excluido SIEMPRE del bulk
  // WhatsApp (OPT-1/OPT-2/SEG-2). Aditiva, sin backfill (default null = contactable).
  whatsappOptOutAt DateTime?
  contracts        Contract[]
  logs             ClientLog[]
  invoices         Invoice[]
  tasks            ScheduledTask[]
  tickets          Ticket[]
  // #80 — Recaptación back-relation
  recaptureLeads   RecaptureLead[]
  // #5 BE — TV activation history back-relation
  tvActivationEvents TvActivationEvent[]
  // messaging-bulk (F2) — back-relation a los destinatarios de campaña de este cliente.
  campaignRecipients CampaignRecipient[] @relation("ClientCampaignRecipients")
  // customer-portal-api (Fase 1) — 1 cuenta de portal <-> 1 cliente (v1). Nullable: la
  // mayoria de los clientes NO tiene cuenta (provisioning manual, beta inicial acotada).
  portalAccount      PortalAccount?
  // portal-promos — back-relation de las respuestas ("Me interesa"/"no me
  // interesa") de este cliente a promos publicadas.
  portalPromoResponses PortalPromoResponse[]
  // store-backend — back-relation de los pedidos de la tienda hechos por este cliente.
  storeOrders          StoreOrder[]

  @@index([status])
  @@index([email])
}

enum ClientStatus {
  active
  late
  blocked
  inactive
  baja
}

model Contract {
  id           String          @id @default(uuid())
  clientId     String
  grContratoId String?         @unique
  type         String
  plan         String
  ip           String?
  status       String          @default("active")
  startDate    DateTime
  endDate      DateTime?
  address      String?
  lat          Float?
  lng          Float?
  // client-geolocation — Prominense-owned GPS separate from GR lat/lng. GR sync NEVER writes these.
  gpsLat       Float?
  gpsLng       Float?
  gpsPlusCode  String?
  technology   String?         // Phase 1: free-text name from ContractTechnology catalog. NOT a FK.
  name         String?         // #43 manual-only identifier. GR sync NEVER writes this.
  vendedor     String?         // GR `vendedor` — agente que dio de alta. Base de la cartera por agente.
  motivoBaja   String?         // GR `motivo_baja` — recapture-active-client-match, mirror field GR-owned, forward-only.
  // contract-node-ap-catalog (Bulk WhatsApp F2/F3) — manual-only node/AP assignment for
  // segmentation. GR sync NEVER writes these (excluded from PrismaClientMirrorRepository
  // upsertContract data whitelist, same as name/gps/technology).
  networkSiteId String?
  networkSite   NetworkSite?    @relation(fields: [networkSiteId], references: [id], onDelete: SetNull)
  accessPointId String?
  accessPoint   AccessPoint?    @relation(fields: [accessPointId], references: [id], onDelete: SetNull)
  createdAt    DateTime        @default(now())
  client         Client                   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tasks          ScheduledTask[]
  tickets        Ticket[]
  installedItems ContractInstalledItem[]
  stockLocations StockLocation[]          @relation("ContractStockLocation")
  contractServices      ContractService[]
  contractServiceEvents ContractServiceEvent[]
  pppoeServices         PppoeService[]
  // store-backend — back-relation de los pedidos de la tienda hechos con este contrato.
  storeOrders           StoreOrder[]

  @@index([clientId])
  @@index([status])
  @@index([networkSiteId])
  @@index([accessPointId])
}

model ClientLog {
  id          String   @id @default(uuid())
  clientId    String
  timestamp   DateTime @default(now())
  eventType   String
  description String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

model Invoice {
  id           String        @id @default(uuid())
  // NOTE: `number` is NO LONGER unique — a GR invoice `numero` is only unique in
  // combination with tipo+sucursal. Identity/upsert key is `grInvoiceId` instead.
  number       String
  // GR composite identity "{tipo}-{sucursal}-{numero}" — unique + nullable, the
  // upsert key and the "sourced from GR" marker (null = manual, never touched by sync).
  grInvoiceId  String?       @unique
  clientId     String
  customerName String
  issueDate    DateTime
  dueDate      DateTime
  amount       Decimal       @db.Decimal(12, 2)
  // Outstanding balance (GR `saldo`); nullable for non-GR/manual rows. Drives status.
  balance      Decimal?      @db.Decimal(12, 2)
  grType       String?
  currency     String?
  pdfUrl       String?
  couponPdfUrl String?
  paymentUrl   String?
  status       InvoiceStatus @default(pendiente)
  lineItems    Json
  createdAt    DateTime      @default(now())
  client       Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([status])
  @@index([dueDate])
}

enum InvoiceStatus {
  pagada
  pendiente
  vencida
}

model ClientComment {
  id         String   @id @default(uuid())
  clientId   String
  authorName String
  content    String
  createdAt  DateTime @default(now())

  @@index([clientId])
}

model Notification {
  id        String    @id @default(uuid())
  type      String
  title     String
  message   String
  severity  String    @default("info")
  read      Boolean   @default(false)
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())
}

// =============================================
// FINANCE DOMAIN
// =============================================

model CreditNote {
  id               String    @id @default(uuid())
  number           String    @unique
  clientId         String
  clientName       String
  amount           Float
  taxAmount        Float     @default(0)
  totalAmount      Float
  reason           String
  relatedInvoiceId String?
  status           String    @default("draft")
  notes            String?
  issuedAt         DateTime  @default(now())
  appliedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([clientId])
}

model ProformaInvoice {
  id                   String    @id @default(uuid())
  number               String    @unique
  clientId             String
  clientName           String
  items                Json
  subtotal             Float
  taxAmount            Float     @default(0)
  total                Float
  status               String    @default("draft")
  notes                String?
  issuedAt             DateTime  @default(now())
  validUntil           DateTime?
  convertedToInvoiceId String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([clientId])
}

model FinanceHistoryEvent {
  id          String   @id @default(uuid())
  type        String
  description String
  clientId    String
  clientName  String
  amount      Float?
  referenceId String?
  adminId     String
  adminName   String
  occurredAt  DateTime @default(now())

  @@index([clientId])
  @@index([occurredAt])
}

// =============================================
// SETTINGS DOMAIN
// =============================================

model SystemSettings {
  id            String   @id @default("singleton")
  companyName   String   @default("IPNEXT")
  timezone      String   @default("America/Argentina/Buenos_Aires")
  currency      String   @default("ARS")
  language      String   @default("es")
  dateFormat    String   @default("DD/MM/YYYY")
  invoicePrefix String   @default("FAC")
  supportEmail  String?
  website       String?
  updatedAt     DateTime @updatedAt
}

model EmailSettings {
  id           String   @id @default("singleton")
  smtpHost     String?
  smtpPort     Int      @default(587)
  smtpUser     String?
  smtpPassword String?
  fromName     String?
  fromEmail    String?
  useTls       Boolean  @default(true)
  updatedAt    DateTime @updatedAt
}

model MessageTemplate {
  id        String   @id @default(uuid())
  name      String
  type      String
  subject   String?
  body      String
  variables Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ApiToken {
  id          String    @id @default(uuid())
  name        String
  token       String    @unique
  permissions Json
  lastUsed    DateTime?
  createdAt   DateTime  @default(now())
}

model PaymentMethod {
  id      String  @id @default(uuid())
  name    String
  type    String
  enabled Boolean @default(true)
  config  Json?
}

model Webhook {
  id            String    @id @default(uuid())
  name          String
  url           String
  events        Json
  secret        String?
  status        String    @default("active")
  lastTriggered DateTime?
  lastStatus    String?
  createdAt     DateTime  @default(now())
}

model BackupRecord {
  id          String   @id @default(uuid())
  filename    String
  sizeBytes   Int
  type        String   @default("manual")
  status      String   @default("completed")
  downloadUrl String?
  createdAt   DateTime @default(now())
}

model ClientPortalSettings {
  id                       String   @id @default("singleton")
  enabled                  Boolean  @default(false)
  portalUrl                String?
  allowSelfRegistration    Boolean  @default(false)
  requireEmailVerification Boolean  @default(true)
  allowPaymentOnline       Boolean  @default(false)
  allowTicketCreation      Boolean  @default(true)
  allowServiceManagement   Boolean  @default(false)
  welcomeMessage           String?
  logoUrl                  String?
  primaryColor             String   @default("#3B82F6")
  customCss                String?
  updatedAt                DateTime @updatedAt
}

// customer-portal-api (Fase 1) — identidad del portal de clientes. Migración ADITIVA,
// no toca ninguna tabla existente. 1 cuenta <-> 1 cliente (v1). El DNI se materializa
// ACA (no en Client.customAttributes) porque es la ruta caliente del login: columna
// unica indexada, cero JSON scan. Ver design.md customer-portal-api §2.
model PortalAccount {
  id                 String    @id @default(uuid())
  clientId           String    @unique
  client             Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  dni                String    @unique
  passwordHash       String
  status             String    @default("active") // active | disabled
  mustChangePassword Boolean   @default(true)
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  sessions           PortalSession[]
  // portal-push-notifications — dispositivos registrados (push-per-device: la
  // preferencia vive en CADA PortalPushToken, no acá).
  pushTokens         PortalPushToken[]
  // @deprecated — huérfana, ver el docblock de `PortalPushPreference`.
  pushPreference     PortalPushPreference?
  // portal-notification-inbox — buzón: rastro persistente de cada aviso enviado.
  notifications      PortalNotification[]
}

// Refresh tokens rotativos del portal. tokenHash = sha256 del refresh opaco (32 bytes
// base64url) — el token crudo NUNCA se persiste. rotatedAt marca "ya se uso una vez";
// reuso de un refresh rotado ⇒ señal de robo, revoca TODAS las sesiones de la cuenta.
model PortalSession {
  id         String    @id @default(uuid())
  accountId  String
  account    PortalAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  rotatedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([accountId])
}

// =============================================
// SCHEDULING DOMAIN
// =============================================

enum StageCategory {
  nuevo
  enProgreso
  hecho
}

model Workflow {
  id          String    @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  stages      Stage[]
  projects    Project[]
}

model Stage {
  id         String          @id @default(uuid())
  workflowId String
  workflow   Workflow        @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  name       String
  code       String          // identidad de negocio, inmutable, slug
  category   StageCategory
  order      Int
  color      String?
  tasks      ScheduledTask[]

  // IClass closure loop — result codes that move a task to THIS stage on closure
  iclassResultCodes IClassResultCode[] @relation("ResultCodeMappedStage")

  // iclass-intermediate-states — IClass status codes mapped to THIS stage (auto-move target)
  iclassStatusCatalogs IClassStatusCatalog[] @relation("StatusCatalogProminenseStage")

  // bulk-task-recipients (D1) — mapeo opcional: este Stage es elegible como criterio de
  // destinatarios del bulk WhatsApp (dominio "Tarea"). Cascade: borrar el Stage limpia el
  // mapeo solo, sin job de limpieza.
  whatsappTaskStageRecipientConfig WhatsappTaskStageRecipientConfig?

  // bulk-task-stage-transition (D1) — back-relation del singleton de transición cuando
  // este Stage es el estado resultante global. Lista por el modelo relacional de Prisma
  // (la unicidad del singleton la garantiza el id fijo, no la FK).
  taskTransitionConfigs WhatsappTaskStageTransitionConfig[] @relation("TaskTransitionResultingStage")

  @@unique([workflowId, code])
  @@index([workflowId, order])
}

/// bulk-task-recipients (D1, TSC-1) — set de Stages elegibles como criterio de destinatarios
/// del bulk WhatsApp (dominio "Tarea"). Una fila POR stage mapeado (NO `stageIds String[]`
/// crudo): la FK real evita ids huérfanos y `onDelete: Cascade` limpia el mapeo solo al
/// borrar el Stage. `@unique` en stageId = idempotencia del mapeo (nunca 2 filas del mismo
/// stage).
model WhatsappTaskStageRecipientConfig {
  id        String   @id @default(uuid())
  stageId   String   @unique
  stage     Stage    @relation(fields: [stageId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

// bulk-task-stage-transition (D1, TTC-1) — SINGLETON: el ÚNICO estado resultante global
// al que transicionan las tareas cuando el bulk WhatsApp las envía. Molde NocBroadcastConfig
// (id fijo "singleton", una sola fila). `resultingStageId` null = sin transición (el dominio
// task sigue siendo solo filtro). onDelete SetNull: si se borra el Stage destino, la config
// sobrevive sin destino (no cae la campaña).
model WhatsappTaskStageTransitionConfig {
  id               String   @id @default("singleton")
  resultingStageId String?
  resultingStage   Stage?   @relation("TaskTransitionResultingStage", fields: [resultingStageId], references: [id], onDelete: SetNull)
  updatedAt        DateTime @updatedAt
}

model ProjectCategory {
  id          String    @id @default(uuid())
  name        String
  description String?
  projects    Project[]
}

// Editable catalog of task categories. ScheduledTask.category stores the name
// (free text), so there is no FK relation here — the catalog drives the UI dropdown.
model TaskCategory {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("TaskCategory")
}

// Editable catalog of contract technologies (Fiber, DOCSIS, Wireless, ...).
// Contract.technology stores the name (free text) — no FK relation in Phase 1.
model ContractTechnology {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("ContractTechnology")
}

// Editable catalog of task priorities, with a colour and a sort weight.
// ScheduledTask.priority stores the name (free text).
model TaskPriority {
  id        String   @id @default(uuid())
  name      String   @unique
  color     String
  weight    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("TaskPriority")
}

// Editable catalog of inventory device types (ONU, ROUTER, ANTENA, ...).
// ContractInstalledItem.type + TaskInventorySuggestion.deviceType store the NAME
// (free-text String). Validation (OCR normalize, confirm guard, route guard) reads
// the active names from this table instead of a hardcoded enum.
model DeviceTypeCatalog {
  id        String   @id @default(uuid())
  name      String   @unique          // canonical, UPPERCASE (ONU, ROUTER, ...)
  label     String?                   // optional human label for the UI
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Inventory Foundation (W1) — assets of this device type
  assets    InventoryAsset[] @relation("AssetDeviceType")

  @@map("DeviceTypeCatalog")
}

// #43 — editable catalog of contracted service types (INTERNET, TV, VOZ, CAMARAS, OTROS).
// Mirrors DeviceTypeCatalog. OTROS is non-deletable (use-case guard).
model ServiceCatalog {
  id        String   @id @default(uuid())
  name      String   @unique          // canonical, UPPERCASE (INTERNET, TV, ...)
  label     String?                   // optional human label for the UI
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contractServices ContractService[]
}

// #43 — pivot linking a Contract to a ServiceCatalog entry.
model ContractService {
  id               String   @id @default(uuid())
  contractId       String
  serviceCatalogId String
  status           String   @default("active")  // active | inactive
  notes            String?
  tvLogin          String?  // #65 Gigared Play login (GIGA{abonado}) — null para servicios no-TV
  tvPassword       String?  // #65 contraseña determinística del alta TV (visible al operador)
  createdAt        DateTime @default(now())
  deactivatedAt    DateTime?  // #73 set when status transitions to inactive; null while active

  contract       Contract       @relation(fields: [contractId], references: [id], onDelete: Cascade)
  serviceCatalog ServiceCatalog @relation(fields: [serviceCatalogId], references: [id], onDelete: Restrict)

  @@unique([contractId, serviceCatalogId])
  @@index([contractId])
}

model MaterialCatalog {
  id        String   @id @default(uuid())
  name      String   @unique          // canonical, UPPERCASE (CABLE_UTP, CONECTOR_RJ45, ...)
  label     String?                   // optional human label for the UI
  unit      String?                   // "m" | "unidad" | "rollo" — default applied in use-case
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  // Wave 7 (Capstone) — global low-stock threshold. 0 = no alert configured.
  minStock  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  consumptions TaskMaterialConsumption[]
  // Inventory Foundation (W1) — stock balances + ledger movements
  stocks       MaterialStock[]     @relation("MaterialStock")
  movements    InventoryMovement[] @relation("MaterialMovement")
  // EPIC #38 W6 — deduction suggestions for this material
  deductionSuggestions MaterialDeductionSuggestion[]

  @@map("MaterialCatalog")
}

model TaskMaterialConsumption {
  id                String          @id @default(uuid())
  taskId            String
  task              ScheduledTask   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  materialCatalogId String
  material          MaterialCatalog @relation(fields: [materialCatalogId], references: [id], onDelete: Restrict)
  materialName      String          // snapshot del nombre al momento del consumo
  quantity          Float
  unit              String?
  notes             String?         @db.Text
  recordedByUserId  String?
  recordedByUser    RbacUser?       @relation("TaskMaterialRecorder", fields: [recordedByUserId], references: [id], onDelete: SetNull)
  // EPIC #38 W6 — link to the deduction that consumed this stock. Null = never deducted.
  deductedAt        DateTime?
  deductedMovementId String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  // W6 back-relation
  deductionSuggestion MaterialDeductionSuggestion?

  @@index([taskId])
}

// EPIC #38 W6 — operator surface for semi-automatic technician stock deduction.
// Staged (read-only) on every consumption; operator confirms (the ONLY mutation) via
// ConfirmMaterialDeduction (UnitOfWork, atomic). Mirror of ReturnSuggestion (W4).
model MaterialDeductionSuggestion {
  id                       String                  @id @default(uuid())
  // L1 unique: one consumption → at most one suggestion. DO NOT change to @@unique;
  // see the hand-written UNIQUE index in the migration (same reason as W4 sourceRef).
  taskMaterialConsumptionId String                 @unique
  consumption               TaskMaterialConsumption @relation(fields: [taskMaterialConsumptionId], references: [id], onDelete: Cascade)
  taskId                   String
  task                     ScheduledTask           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  technicianId             String?
  materialCatalogId        String
  material                 MaterialCatalog         @relation(fields: [materialCatalogId], references: [id], onDelete: Restrict)
  qty                      Decimal                 @db.Decimal(12,4)
  technicianLocationId     String?
  status                   String                  @default("pending") // pending | needs_review | confirmed | discarded
  resolution               String?                 // deduct | issue-first | depot | discard
  // L2 natural key: consume:task-material:{consumptionId}
  sourceRef                String?
  deductedMovementId       String?                 @unique
  deductedMovement         InventoryMovement?      @relation("DeductionMovement", fields: [deductedMovementId], references: [id], onDelete: SetNull)
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt

  @@index([status])
  @@index([taskId])
  @@index([sourceRef])
}

