// =============================================
// FINANCE-GROWTH DOMAIN — Fase 1 (ingest de cobranza GR)
// =============================================

/// finance-growth Fase 1 — clasificación de tipos de comprobante GR (`grType`),
/// filas en vez de enum (design.md Decision 2 — vocabulario ajeno, puede crecer
/// sin deploy). `bucket` es VARCHAR validado en el use case, no un enum Postgres
/// (mismo criterio que RbacPermission.action). Seed inicial: solo `FB` (mayoría
/// absoluta verificada en vivo) — el resto se auto-alta `unclassified` al vuelo.
model FinanceInvoiceTypeClassification {
  grType    String   @id
  bucket    String   @default("unclassified") @db.VarChar(32)
  label     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// finance-growth Fase 1 (design.md Decision 4b) — pacing del ingest de
/// recibos: presupuesto de requests COMPARTIDO entre el carril delta
/// (prioridad absoluta) y el carril backfill (newest→oldest). Molde
/// GestionRealIngestConfig; NO tiene endpoint HTTP propio en este change (es
/// un knob operativo, no un settable de negocio).
model FinanceReceiptSyncConfig {
  id                       String   @id @default("singleton")
  enabled                  Boolean  @default(true)
  requestIntervalMs        Int      @default(20000)
  maxRequestIntervalMs     Int      @default(300000)
  deltaCheckIntervalMs     Int      @default(300000)
  backfillFloorYearMonth   String   @default("2013-01")
  /// fix-wave-2 LOW — moved out of a hardcoded scheduler constant so the whole
  /// pacing model stays editable in DB without a redeploy (same rationale as
  /// the rest of this table, F6).
  deltaStarvationThreshold Int      @default(3)
  /// gr-receipt-annulment (design.md Decision 1/2) — third lane: re-consults GR
  /// a moving window backwards, catching late-confirmed receipts and real
  /// annulments. Runtime kill-switch, independent of `enabled` (the whole ingest).
  reconcileEnabled         Boolean  @default(true)
  /// gr-receipt-annulment (design.md Decision 2/7) — how many days back the
  /// reconcile lane re-scans. MUST be >= the snapshot rebuild window (current +
  /// previous month, worst case 35d) — the normalizer enforces an effective
  /// floor of 35 (see `normalizeFinanceReceiptSyncConfig`).
  reconcileWindowDays      Int      @default(35)
  /// gr-receipt-annulment (design.md Decision 2/9) — how often (ms) the
  /// reconcile lane re-checks whether a fresh sweep is due once idle.
  reconcileCheckIntervalMs Int      @default(21600000)
  /// gr-receipt-annulment (design.md Decision 4/7) — systemic guard: aborts a
  /// page/run when the annulled ratio EXCEEDS this percent (strict `>`),
  /// protecting against a GR sentinel-format drift flooding the mirror with
  /// false `anulado: true`. `100` would mean "never abort" — REJECTED by the
  /// normalizer as the dangerous extreme.
  annulmentGuardMaxPct     Int      @default(5)
  /// gr-receipt-annulment (design.md Decision 4/7) — absolute floor: the guard
  /// never fires below this many annulled rows in the page/run, so a tiny tail
  /// page with 1-2 LEGITIMATE annulments never traps the lane forever.
  annulmentGuardMinCount   Int      @default(5)
  updatedAt                DateTime @updatedAt
}

/// finance-growth Fase 1 (design.md Decision 0) — recibo de cobranza GR
/// (action `recibos`). `Invoice` queda INTOCADO (Decision 0b) — este es un
/// mirror propio, sin el invariante destructivo de replace-all por cliente
/// que `ClientMirrorRepository.upsertInvoices` ya tiene en producción.
model FinancePaymentReceipt {
  grReceiptId       String    @id
  clientGrId        String?
  recaudador        String?
  fechaRecibo       DateTime?
  fechaConfirmacion DateTime?
  /// gr-receipt-annulment (design.md Decision 3) — TRUE cuando GR reporta una
  /// anulación real (derivado por mapGrReceipt via isRealAnnulment). Filtrado
  /// en runtime por los 4 lectores del dashboard (finance-dashboard-annulment-
  /// filter) y por PrismaPortalPaymentsReader.
  anulado           Boolean   @default(false)
  observaciones     String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  applications FinanceReceiptApplication[]
  items        FinanceReceiptItem[]
  retenciones  FinanceReceiptRetencion[]

  @@index([clientGrId])
  @@index([fechaRecibo])
  // finance-growth Fase 3 rework (J2) — the per-client cash attribution walk
  // (`listByClientAndMonth` on items/applications, JOINed through this
  // table) filters by BOTH columns together every time; the single-column
  // indexes above don't back that combination as well as a compound one.
  // Added defensively (index-only, zero code-path change) — the N+1 query
  // SHAPE itself (one query per client per month in the attribution loop)
  // is accepted as documented debt, see BuildFinanceMonthlySnapshot's
  // closing report; this index at least caps the per-query cost.
  @@index([clientGrId, fechaRecibo])
}

/// fix-wave-2 R1 — línea de `recibo.items[]`: CASH efectivamente recibido (medio
/// de cobro: transferencia/depósito/etc). Es la base de la métrica "cash
/// collected" del spec (`aplicaciones` es deuda CANCELADA, no necesariamente
/// cash — puede exceder el cash cuando el recibo también trae `retenciones`).
/// Medido en vivo (junio 2026, 4.839 recibos): SUM(aplicaciones) - SUM(items) -
/// SUM(retenciones) = -0.00, identidad exacta. Persistida en tabla propia
/// (nunca inferida) para que el split cobranza/retenciones sea reversible sin
/// re-ingerir los 163 meses de historia — ver design.md Decision 0/0b.
model FinanceReceiptItem {
  grItemId            String                @id
  receiptId           String
  receipt             FinancePaymentReceipt @relation(fields: [receiptId], references: [grReceiptId])
  banco               String?
  cajaCuentaId        String?
  destino             String?
  fecha               DateTime?
  amount              Decimal               @db.Decimal(12, 2)
  moneda              String?
  numeroTransferencia String?
  tipo                String?

  @@index([receiptId])
  /// fix-wave-3 LOW — added to support PrismaFinanceReceiptItemRepository.listByMonth's
  /// `WHERE fecha BETWEEN ...`. fix-wave-4 W2: that cut was WRONG (11,2% of
  /// items measured live with no `fecha` at all — see migration
  /// `20261023000400`'s comment) and the read path now cuts by the parent
  /// receipt's `fechaRecibo` (already indexed, `@@index([fechaRecibo])`
  /// above) instead. This index is UNUSED by the current read path; kept
  /// (not dropped) as a harmless leftover, see the migration comment.
  @@index([fecha])
}

/// fix-wave-2 R1 — línea de `recibo.retenciones[]`: certificado de retención
/// impositiva (retiva/retgan/retib/retpat — vocabulario abierto, sin enum).
/// NUNCA cash — un recibo puede ser 100% retenciones con `items` vacío (medido:
/// 7 de 18 recibos de junio 2026 con `retenciones` no traen `items`). Se
/// expone como serie APARTE de la métrica de cash, nunca neteada en silencio.
model FinanceReceiptRetencion {
  grRetencionId String                @id
  receiptId     String
  receipt       FinancePaymentReceipt @relation(fields: [receiptId], references: [grReceiptId])
  tipo          String?
  amount        Decimal               @db.Decimal(12, 2)
  fecha         DateTime?

  @@index([receiptId])
}

/// finance-growth Fase 1 (design.md Decision 0b) — aplicación de un recibo a
/// UN comprobante (relación 1-N recibo→aplicaciones). `grInvoiceId` comparte
/// la MISMA identidad compuesta que `Invoice.grInvoiceId`
/// (`"{tipo}-{sucursal}-{numero}"`) pero SIN FK dura (deuda declarada #6) —
/// `grType` viaja en la propia aplicación, así que el motor de métricas nunca
/// necesita joinear `Invoice`.
model FinanceReceiptApplication {
  grApplicationId String    @id
  receiptId       String
  receipt         FinancePaymentReceipt @relation(fields: [receiptId], references: [grReceiptId])
  grInvoiceId     String
  grType          String
  amount          Decimal   @db.Decimal(12, 2)
  appliedDate     DateTime?

  @@index([grInvoiceId])
  @@index([appliedDate])
  @@index([receiptId])
}

/// finance-growth Fase 2 (design.md Data Model) — costo por tecnología, clave
/// natural `technologyName` (= `ContractTechnology.name`, SIN FK — deuda
/// declarada #2). `comisionVentaPct` viaja en esta misma fila: decisión
/// declarada del change, la comisión de venta va POR TECNOLOGÍA, igual que el
/// resto de los costos (no por plan ni global).
model FinanceTechnologyCost {
  technologyName          String   @id
  costoVentaArs           Decimal  @default(0) @db.Decimal(12, 2)
  costoInstalacionArs     Decimal  @default(0) @db.Decimal(12, 2)
  costoMensualServicioArs Decimal  @default(0) @db.Decimal(12, 2)
  comisionVentaPct        Decimal  @default(0) @db.Decimal(5, 2)
  updatedByUserId         String?
  updatedAt               DateTime @updatedAt
}

/// finance-growth Fase 2 (design.md Data Model) — precio mensual ESTIMADO por
/// plan, clave natural `planCode` (= `Plan.code`, SIN FK). Uso EXCLUSIVO:
/// reparto proporcional de la atribución Capa B (Decision 1) + "what-if" de
/// CAC/payback — NUNCA la fuente de la cobranza agregada.
model FinancePlanPrice {
  planCode              String   @id
  estimatedMonthlyPrice Decimal  @default(0) @db.Decimal(12, 2)
  updatedByUserId       String?
  updatedAt             DateTime @updatedAt
}

/// finance-growth Fase 2 (design.md Data Model) — metas y config global,
/// molde singleton (mismo criterio que `FinanceReceiptSyncConfig`).
/// `inflationBaseYearMonth: ""` = sin configurar (la serie real de
/// `GetFinanceOverview`, Fase 4, no está disponible hasta que se cargue un
/// mes ancla).
model FinanceTargetsConfig {
  id                      String   @id @default("singleton")
  churnTargetPct          Decimal  @default(5) @db.Decimal(5, 2)
  maxPaybackMonths        Int      @default(12)
  monthlyNewContractsGoal Int      @default(0)
  inflationBaseYearMonth  String   @default("")
  updatedAt               DateTime @updatedAt
}

/// finance-growth Fase 2 (design.md Decision 3) — índice IPC mensual cargado
/// a mano: `monthlyRatePct` es la variación mensual TAL CUAL la publica INDEC
/// (ej. `4.2` para +4.2% ese mes), no un índice base-100 precalculado. El
/// encadenamiento (`chainedIndex`) es responsabilidad del consumidor de
/// lectura (`GetFinanceOverview`, Fase 4) — esta tabla solo persiste la serie
/// cruda. Fail-loud ante huecos: un mes faltante trunca la serie real, nunca
/// se interpola ni se asume `0%`.
model FinanceInflationIndex {
  yearMonth      String   @id
  monthlyRatePct Decimal  @db.Decimal(6, 3)
  source         String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

/// finance-growth Fase 3 (design.md Decision 4) — precomputed monthly MRR
/// bridge/churn/revenue snapshot, built nightly by `BuildFinanceMonthlySnapshot`.
/// All `*Ars` fields are NOMINAL — nominal/real deflation happens at READ
/// time (`GetFinanceOverview`, Fase 4), chained from `FinanceInflationIndex`,
/// so loading a late IPC value updates the real series immediately without
/// recomputing snapshots.
model FinanceMonthlySnapshot {
  yearMonth               String   @id
  contractsActive         Int
  contractsNew            Int
  contractsChurned        Int
  contractsUpgraded       Int
  contractsDowngraded     Int
  mrrInicialArs           Decimal  @db.Decimal(14, 2)
  mrrNewArs               Decimal  @db.Decimal(14, 2)
  mrrUpgradeArs           Decimal  @db.Decimal(14, 2)
  mrrDowngradeArs         Decimal  @db.Decimal(14, 2)
  mrrChurnArs             Decimal  @db.Decimal(14, 2)
  mrrFinalArs             Decimal  @db.Decimal(14, 2)
  // fix-wave-3 (🟡 4) — mrrFinal - (mrrInicial+new+upgrade-downgrade-churn).
  // 0 en el caso sano; hace VISIBLE cualquier hueco del bridge (extremo sin
  // precio, evento 'modified' perdido, etc.) en vez de dejarlo pasar en silencio.
  bridgeResidualArs       Decimal  @default(0) @db.Decimal(14, 2)
  // finance-growth Fase 3 REWORK (F2) — contratos activos al cierre del mes
  // cuyo precio contratado no pudo resolverse; excluidos de mrrFinalArs,
  // nunca un cero silencioso.
  unpricedContractsActive Int      @default(0)
  unpricedContractsPct    Decimal  @default(0) @db.Decimal(5, 2)
  unpricedPlanChangeEvents Int     @default(0)
  // fix-wave-3 (🔴 1) — eventos 'modified' del mes donde el plan viejo o
  // nuevo es un código de ENFORCEMENT (IP-REDUCCION/IP-BAJA) — excluidos de
  // mrrUpgrade/mrrDowngrade aunque tengan precio resoluble en FinancePlanPrice.
  enforcementPlanChangeEventsExcluded Int @default(0)
  revenueTotalArs         Decimal  @db.Decimal(14, 2)
  // finance-growth Fase 3 REWORK — tasa de cobranza (cobranza / MRR
  // contratado). Nullable: null cuando mrrFinalArs es 0 (sin base contra la
  // cual comparar), nunca "0% cobrado".
  collectionRatePct       Decimal? @db.Decimal(9, 2)
  revenueAttributableArs  Decimal  @db.Decimal(14, 2)
  unclassifiedAmountArs   Decimal  @default(0) @db.Decimal(14, 2)
  attributionPct          Decimal  @db.Decimal(5, 2)
  arpuArs                 Decimal  @db.Decimal(12, 2)
  churnContractsPct       Decimal  @db.Decimal(5, 2)
  // finance-growth Fase 3 REWORK (F4) — nullable: null cuando no había
  // ningún contrato activo al inicio del mes (sin base), nunca "0% churn".
  churnRevenuePct         Decimal? @db.Decimal(5, 2)
  computedAt              DateTime @default(now())
}

/// finance-growth Fase 3 (design.md Decision 4) — retention cohort row: of
/// the contracts activated in `cohortYearMonth` (`originalCount`), how many
/// (`survivingCount`) were still active `monthsElapsed` (3 | 6 | 12) months
/// later. A cohort younger than `monthsElapsed` never gets that row (no
/// invented data).
model FinanceCohortSnapshot {
  cohortYearMonth String
  monthsElapsed   Int
  originalCount   Int
  survivingCount  Int
  computedAt      DateTime @default(now())

  @@id([cohortYearMonth, monthsElapsed])
}

// =============================================
// SUPPORT DOMAIN
// =============================================

// #49 — Ticket area catalog. Editable list; 3 seed areas.
// #69 — `color` (hex) drives the area pill in the tickets list.
model TicketAreaCatalog {
  id        String   @id @default(uuid())
  name      String   @unique
  color     String   @default("#6366f1")
  // portal-ticket-topic (BE) — el cliente del portal ELIGE un tópico al abrir
  // un reclamo, en vez de que el área salga siempre del config. Default
  // `false` A PROPÓSITO: es el lado SEGURO — un área nueva (o ya existente,
  // como NOC/GigaRed, que son INTERNAS) NO se expone a clientes hasta que
  // alguien lo decida explícitamente desde el admin. `getPortalVisibleById`
  // es la AUTORIDAD de seguridad: filtra por esta columna DENTRO del WHERE,
  // nunca en una capa de arriba (ver TicketAreaCatalogRepository).
  portalVisible     Boolean  @default(false)
  // Nombre que ve el CLIENTE en el selector de tópicos — el área interna
  // sigue llamándose `name` como hoy. Null hasta que el admin lo cargue;
  // ListPortalTicketTopics cae a `name` cuando es null.
  portalLabel       String?
  // Línea de ayuda que explica CUÁNDO elegir este tópico (portal, selector).
  portalDescription String?
  // Orden de presentación en el selector del portal (ASC; empata por `name`).
  portalOrder       Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tickets   Ticket[]
  // F1.5-C2 (asignación) — back-relation del área LOCAL de Conversation (mirror WhatsApp).
  conversations Conversation[]
  // ai-assistant-multiagent (CFG-1) — perfil del asistente IA de ESTA área. 1:1 (el FK del
  // otro lado es @unique). Este catálogo YA es compartido por Ticket.areaId y
  // Conversation.areaId, así que UN perfil sirve a las dos superficies sin duplicar nada.
  // onDelete: Cascade del lado del perfil ⇒ borrar el área se lleva su configuración.
  assistantProfile AssistantProfile?
  // RTR-0 — back-relation del área designada como DEFAULT (la que atiende lo que entra sin
  // clasificar). onDelete: SetNull del otro lado: borrar el área deja el ruteo sin default
  // (las conversaciones sin área dejan de atenderse) en vez de romper la config.
  assistantRoutingDefault AssistantRoutingConfig[]
  // portal-promos — back-relation de las promos cuyo interés ("Me interesa")
  // abre un reclamo en ESTA área.
  portalPromos PortalPromo[]
  // store-backend — back-relation de los productos de la tienda cuyo pedido
  // abre un reclamo en ESTA área.
  storeProducts StoreProduct[]

  @@map("TicketAreaCatalog")
}

// Phase 2 complete: TicketStatus enum dropped; Ticket.status is now a FK → TicketStatusCatalog.
// The API still exposes status as a string (the catalog name) — see PrismaTicketRepository.
model TicketStatusCatalog {
  id        String   @id @default(uuid())
  name      String   @unique
  color     String
  weight    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tickets   Ticket[]

  @@map("TicketStatusCatalog")
}

enum TicketPriority {
  low
  medium
  high
}

model Ticket {
  id          String @id @default(uuid())
  // #11: monotonic display number (like ScheduledTask.sequenceNumber). Never reused.
  sequenceNumber Int @unique @default(autoincrement())
  subject     String
  description String

  // Phase 2: status is now a FK to TicketStatusCatalog.
  // The API still exposes `status` as the catalog name string (not the id).
  statusId String
  status   TicketStatusCatalog @relation(fields: [statusId], references: [id], onUpdate: Cascade, onDelete: Restrict)

  priority TicketPriority @default(medium)

  // FK al cliente — espejo de ScheduledTask.customerId
  customerId String?
  customer   Client? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  // FK al contrato del cliente. Requerido en el flujo de creacion (route + use case),
  // pero nullable en DB: los tickets viejos no tienen contrato. SetNull al borrar el
  // contrato (espejo de customer).
  contractId String?
  contract   Contract? @relation(fields: [contractId], references: [id], onDelete: SetNull)

  // Asignacion opcional a un RbacUser — espejo de ScheduledTask.assigneeId
  assigneeId String?
  assignee   RbacUser? @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  // #48 — quien creo el ticket. Estampado en create desde la sesion (req.user.id).
  // Opcional: tickets viejos sin reporter quedan null (sin backfill). Espejo de assigneeId.
  reporterId String?
  reporter   RbacUser? @relation("TicketReporter", fields: [reporterId], references: [id], onDelete: SetNull)

  // Previsto para la futura integracion de "casos" de Gestion Real (out-of-scope)
  grCasoId String? @unique

  // #49 — Area FK (optional; BATCH 2 wires business logic)
  areaId String?
  area   TicketAreaCatalog? @relation(fields: [areaId], references: [id], onDelete: SetNull)

  // #84 — stamped when the ticket transitions to a closed status; null while open/pending.
  // Used by the FE SLA timer to freeze the elapsed display at the moment of closure.
  resolvedAt DateTime?

  // #85 — set when the ticket is archived (must be closed first); null otherwise.
  archivedAt DateTime?

  // Back-relation: tasks created from this ticket (tickets-actions-be)
  tasks ScheduledTask[]

  // #44 — Back-relation: persisted comments on this ticket.
  comments TicketComment[]

  // v2.B (portal-ticket-messaging) — cursor de lectura por lado ("no leídos").
  // Diseño simple a propósito (spec "No leídos por lado"): UN timestamp por
  // lado en vez de una tabla de recibos por-mensaje — el badge solo necesita
  // "¿hay algo nuevo desde la última vez que abrí el hilo?", no un tracking
  // granular por mensaje. Null = "nunca abrió el hilo" (todo lo público/ajeno
  // cuenta como no leído). Se estampa a `now()` cuando ese lado abre el hilo
  // (GET del listado de mensajes correspondiente), NUNCA al escribir un
  // mensaje propio.
  clientMessagesReadAt DateTime?
  staffMessagesReadAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // portal-promos — back-relation: la respuesta ("Me interesa") que generó ESTE
  // ticket, si lo creó una promo (1:1 — ver PortalPromoResponse.ticketId @unique).
  promoResponse PortalPromoResponse?
  // store-backend — back-relation: el/los pedido(s) de la tienda que abrieron
  // ESTE ticket. Array (no 1:1 como promoResponse): StoreOrder.ticketId NO es
  // único en el schema — el pedido es la unidad, un ticket que lo origina.
  storeOrders StoreOrder[]

  @@index([customerId])
  @@index([contractId])
  @@index([statusId])
  @@index([assigneeId])
  @@index([reporterId])
  @@index([areaId])
  @@index([archivedAt])
}

// =============================================
// PORTAL PROMOS DOMAIN
// =============================================

// portal-promos — el operador publica una promo eligiendo A QUIÉN le llega
// (`segment`, MISMO shape que `CampaignSegmentFilter` — ver
// `buildSegmentWhere`/`buildClientMatchesSegmentWhere` en
// PrismaCustomerRepository, la garantía anti-divergencia del preview vs. lo
// que el cliente realmente ve). El cliente la ve en Inicio (`publishedAt` no
// null, `archivedAt` null, dentro de [startsAt, endsAt], su cliente matchea
// el segmento) y puede tocar el CTA, lo que abre un `Ticket` (ver
// PortalPromoResponse).
model PortalPromo {
  id    String @id @default(uuid())
  title String
  // Texto corto de la tarjeta en Inicio.
  summary String
  // Texto largo del detalle.
  body String
  // MinIO — mismo patrón que los adjuntos de mensajería (storageKey, no URL
  // pública). Opcional: una promo puede no tener imagen.
  imageStorageKey String?
  ctaLabel        String  @default("Me interesa")
  // Área del reclamo que genera el interés. Null = área default del portal
  // (config.portal.ticketAreaName, mismo fallback que CreatePortalTicket).
  ticketAreaId String?
  ticketArea   TicketAreaCatalog? @relation(fields: [ticketAreaId], references: [id], onDelete: SetNull)
  // CampaignSegmentFilter — statuses/balanceMin/balanceMax/networkSiteId/accessPointId.
  segment Json
  startsAt DateTime
  endsAt   DateTime
  // null = borrador, NO visible para clientes.
  publishedAt DateTime?
  archivedAt  DateTime?
  authorId    String?
  author      RbacUser? @relation(fields: [authorId], references: [id], onDelete: SetNull)
  // Snapshot — sobrevive al borrado del usuario (mismo criterio que NewsPost.authorName).
  authorName String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  responses  PortalPromoResponse[]

  @@index([publishedAt])
  @@index([archivedAt])
  @@index([ticketAreaId])
}

// portal-promos — UNA respuesta por (promo, cliente): "Me interesa" (kind =
// interested, con el ticket que abrió) o "no me interesa" (kind = dismissed,
// sin ticket). El `@@unique` es la red de idempotencia real — el use case
// (InterestInPortalPromo) hace un chequeo previo por UX, pero es esta
// constraint la que garantiza que NUNCA se crean dos tickets si dos requests
// concurrentes llegan al mismo tiempo.
model PortalPromoResponse {
  id      String      @id @default(uuid())
  promoId String
  promo   PortalPromo @relation(fields: [promoId], references: [id], onDelete: Cascade)
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  // 'interested' | 'dismissed'
  kind String
  // Solo presente cuando kind='interested'. @unique: 1 respuesta <-> a lo sumo
  // 1 ticket. SetNull (no Cascade): si el ticket se borra, la respuesta
  // (evidencia de que el cliente expresó interés) sobrevive con ticketId=null.
  ticketId String? @unique
  ticket   Ticket? @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@unique([promoId, clientId])
  @@index([clientId])
}

// =============================================
// STORE DOMAIN (store-backend)
// =============================================

// store-backend — el staff carga productos en Prominense; el cliente los ve
// en la app y pide con "Lo quiero" eligiendo forma de pago (1 pago o cuotas
// EN LA FACTURA — sin pasarela en v1). El pedido abre una conversación
// (Ticket) donde el equipo coordina. Legal AR: precio final, cuotas claras,
// garantía y arrepentimiento de 10 días viven como TEXTO del producto
// (warrantyText), no como lógica de negocio separada.
model StoreProduct {
  id    String @id @default(uuid())
  title String
  // Línea corta de la card del catálogo.
  summary String
  // Texto largo del detalle.
  description String
  priceArs Decimal @db.Decimal(12, 2)
  // 1 = solo un pago; N = hasta N cuotas SIN interés (priceArs/N).
  maxInstallments Int @default(1)
  warrantyText String
  // ej. "Recomendado". Opcional.
  badge String?
  // MinIO — mismo patrón que los adjuntos de mensajería (storageKey, no URL
  // pública). Opcional: un producto puede no tener imagen todavía.
  imageStorageKey String?
  // Área del ticket del pedido; null = área default del portal (mismo
  // fallback que CreatePortalTicket/PortalPromo.ticketAreaId).
  ticketAreaId String?
  ticketArea   TicketAreaCatalog? @relation(fields: [ticketAreaId], references: [id], onDelete: SetNull)
  // false = borrador, el cliente NO lo ve (lado seguro, default).
  active    Boolean @default(false)
  sortOrder Int     @default(0)
  archivedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  orders     StoreOrder[]

  @@index([active])
  @@index([archivedAt])
  @@index([ticketAreaId])
}

// store-backend — un pedido, SNAPSHOT inmutable del precio y las cuotas
// elegidas al momento de la compra (priceArsAtOrder): el catálogo puede
// cambiar de precio después sin alterar pedidos ya hechos.
model StoreOrder {
  id        String       @id @default(uuid())
  productId String
  product   StoreProduct @relation(fields: [productId], references: [id], onDelete: Restrict)
  clientId  String
  client    Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  contractId String?
  contract   Contract? @relation(fields: [contractId], references: [id], onDelete: SetNull)
  installments Int
  // Snapshot — ver docblock del modelo.
  priceArsAtOrder Decimal @db.Decimal(12, 2)
  ticketId String?
  ticket   Ticket? @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([productId])
  @@index([clientId])
  @@index([contractId])
  @@index([ticketId])
}

// =============================================
// PORTAL PUSH NOTIFICATIONS DOMAIN
// =============================================

// portal-push-notifications — un dispositivo (token de registro FCM) de una
// cuenta del portal. `token` es GLOBALMENTE único (no por-cuenta): un mismo
// teléfono vendido/prestado reasigna su token a la cuenta que lo registra de
// último (RegisterPortalPushToken hace upsert por `token`) — jamás sigue
// mandando push al dueño anterior. `invalidAt` NUNCA borra la fila: FCM
// reporta un token como UNREGISTERED/INVALID_ARGUMENT y queda marcado para
// auditoría, no eliminado.
// push-per-device — `serviceAlerts`/`promos`/`promosOptInAt`/
// `promosOptInAppVersion` viven ACÁ (por TOKEN, no por cuenta). Una cuenta
// del portal = un contrato = una CASA: marido, mujer, hijos, varios
// teléfonos con la MISMA cuenta. Con la preferencia por cuenta, uno apaga las
// promos y se las apaga a TODOS; peor, uno acepta marketing y el otro —que
// nunca consintió— empieza a recibirlo. El APARATO se parece más a la
// persona que la cuenta en una cuenta compartida. `serviceAlerts` default
// TRUE: es transaccional (avisos de servicio), sin restricción de
// Apple/Google — no requiere opt-in. `promos` default FALSE: el opt-in de
// marketing es EXPLÍCITO (Apple 4.5.4 exige texto de consentimiento + baja
// desde la app; Ley 25.326 art. 27 exige poder pedir salir de bases de
// marketing) — jamás se asume encendido. `promosOptInAt`/
// `promosOptInAppVersion` quedan estampados la PRIMERA vez que `promos` pasa
// de false a true, en ESE dispositivo, y NUNCA se limpian al apagarlo — es el
// rastro auditable del consentimiento, no el estado actual del toggle. Un
// re-registro del mismo token (`upsertByToken`) NUNCA las resetea.
model PortalPushToken {
  id                    String        @id @default(uuid())
  accountId             String
  account               PortalAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  token                 String        @unique
  // 'android' | 'ios' — hoy solo Android tiene build (proposal "Out of Scope:
  // Push a iOS"), pero la columna ya modela ambos valores.
  platform              String
  // Modelo legible del dispositivo, para una futura UI de "mis sesiones".
  deviceLabel           String?
  createdAt             DateTime      @default(now())
  lastSeenAt            DateTime      @default(now())
  invalidAt             DateTime?
  serviceAlerts         Boolean       @default(true)
  promos                Boolean       @default(false)
  promosOptInAt         DateTime?
  promosOptInAppVersion String?

  @@index([accountId])
}

// @deprecated push-per-device — la preferencia se mudó a `PortalPushToken`
// (arriba). Esta tabla queda HUÉRFANA A PROPÓSITO: sin lecturas en el código
// (`GetPortalPushPreferences`/`UpdatePortalPushPreferences` ya no la tocan),
// backfilleada UNA vez hacia `PortalPushToken` en la migración que agregó las
// columnas de arriba. NO se borra en este change — borrarla (DROP TABLE) es
// una migración DESTRUCTIVA aparte, a propósito, para no perder el rastro
// mientras el cambio de contrato termina de asentarse en prod.
model PortalPushPreference {
  id                     String        @id @default(uuid())
  accountId              String        @unique
  account                PortalAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  serviceAlerts          Boolean       @default(true)
  promos                 Boolean       @default(false)
  promosOptInAt          DateTime?
  promosOptInAppVersion  String?
  updatedAt              DateTime      @updatedAt
}

// portal-notification-inbox — el buzón del portal. Feedback probando el push
// real: "se mandó la notificación pero no persiste en ningún lado de la app,
// por lo cual la persona puede abrirla sin leerla" — `SendPushServiceAlert`
// escribe UNA fila por cuenta destinataria (tenga o no token de push vivo) al
// momento del envío, sea el push exitoso o no. `channel` reusa el mismo eje
// que `PortalPushPreference` ('service' | 'promo'); `data` es el mismo
// payload `data` del push (deep link). `readAt` null = no leída.
model PortalNotification {
  id        String        @id @default(uuid())
  accountId String
  account   PortalAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  channel   String // 'service' | 'promo'
  title     String
  body      String
  data      Json?
  sentAt    DateTime      @default(now())
  readAt    DateTime?

  @@index([accountId, sentAt])
}

// =============================================
// RBAC DOMAIN
// =============================================

// RbacAction enum removed — action is now VARCHAR(64) to allow sub-actions without migrations.
// TS source-of-truth: KNOWN_ACTIONS in src/domain/entities/rbac.ts

model RbacModule {
  id          String           @id @default(uuid())
  code        String           @unique
  label       String
  createdAt   DateTime         @default(now())
  permissions RbacPermission[]
}

model RbacPermission {
  id       String               @id @default(uuid())
  moduleId String
  action   String               @db.VarChar(64)
  module   RbacModule           @relation(fields: [moduleId], references: [id], onDelete: Restrict)
  grants   RbacRolePermission[]

  @@unique([moduleId, action])
  @@index([moduleId])
}

model RbacRole {
  id          String               @id @default(uuid())
  code        String               @unique
  label       String
  description String?
  isSystem    Boolean              @default(false)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  users       RbacUserRole[]
  permissions RbacRolePermission[]
}

model RbacUser {
  id              String          @id @default(uuid())
  name            String
  email           String          @unique
  login           String          @unique
  passwordHash    String
  status          String          @default("active")
  failedLoginCount Int            @default(0)
  lockedUntil     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  lastLoginAt     DateTime?
  /// AD-1: Soft FK to IClassTeam.login — 1 técnico → 0..1 cuadrilla. No FK física.
  iclassTeamLogin String?
  /// Mis clientes (Fase 2): nombre del vendedor en Gestión Real. Soft, nullable, sin FK física.
  grVendedorName  String?
  roles           RbacUserRole[]
  tasksReported          ScheduledTask[] @relation("TaskReporter")
  tasksAssigned          ScheduledTask[] @relation("TaskAssignee")
  tasksInventoryReviewed ScheduledTask[] @relation("TaskInventoryReviewer")
  materialsRecorded TaskMaterialConsumption[] @relation("TaskMaterialRecorder")
  tasksWatching   TaskWatcher[]   @relation("TaskWatcher")
  assignedTickets Ticket[]        @relation("TicketAssignee")
  reportedTickets Ticket[]        @relation("TicketReporter")
  auditEvents     AuditEvent[]
  sessions        Session[]
  taskActivities  ScheduledTaskActivity[] @relation("TaskActivityActor")
  // Inventory Foundation (W1) — back-relations
  stockLocations    StockLocation[]     @relation("TechnicianStockLocation")
  inventoryMovements InventoryMovement[] @relation("MovementTechnician")
  // EPIC #38 W5b — vehicles assigned to this technician
  assignedVehicles  Vehicle[]           @relation("AssignedVehicleTechnician")
  // #80 — Recaptación back-relations
  recaptureLeadsAssigned  RecaptureLead[]    @relation("RecaptureLeadAssignee")
  recaptureContacts       RecaptureContact[] @relation("RecaptureContactActor")
  // #5 BE — TV activation history back-relation (soft FK, SetNull on delete)
  tvActivationEvents      TvActivationEvent[] @relation("TvActivationEventActor")
  // #110 — Contract service event history back-relation (soft FK, SetNull on delete)
  contractServiceEvents   ContractServiceEvent[] @relation("ContractServiceEventActor")
  // F1.5-C2 (asignación) — back-relation de la asignación LOCAL de Conversation
  // (mirror WhatsApp, nunca sincronizada a Chatwoot).
  assignedConversations   Conversation[]         @relation("ConversationAssignee")
  // conversation-events (Ola 2) — back-relation de las transiciones que este usuario
  // disparó (soft FK, SetNull on delete: su historial sobrevive con actorId=null).
  conversationEventsActed ConversationEvent[]    @relation("ConversationEventActor")
  // messaging-bulk (F2) — back-relation de las campañas disparadas por este usuario.
  createdCampaigns        Campaign[]             @relation("CampaignCreatedBy")
  // messaging-inbox-notes (edit/delete) — back-relation de las notas internas escritas
  // por este usuario (soft FK, SetNull on delete: borrar el usuario NO borra sus notas,
  // sólo desasocia el autor → la nota queda editable/eliminable sólo por un supervisor).
  authoredChatMessages    ChatMessage[]          @relation("ChatMessageAuthor")
  // Ola 4 (inbox-Chatwoot) — respuestas rápidas creadas por este usuario (soft FK, SetNull).
  cannedResponses         CannedResponse[]       @relation("CannedResponseCreatedBy")
  // internal-news — back-relations: noticias publicadas + acuses de lectura de este usuario.
  newsPosts               NewsPost[]
  newsReadReceipts        NewsReadReceipt[]
  // note-mentions (Ola 6b) — back-relations de @menciones: recibidas (aparecen en SU vista
  // "Menciones") y hechas (notas donde este usuario nombró a otros). Cascade en las recibidas
  // (una mención sin el usuario mencionado no tiene sentido); SetNull en las hechas (borrar
  // el autor preserva la mención, sólo desasocia quién la escribió).
  mentionsReceived        ConversationMention[]  @relation("ConversationMentionUser")
  mentionsMade            ConversationMention[]  @relation("ConversationMentionByUser")
  // portal-promos — back-relation de las promos publicadas por este usuario.
  portalPromosAuthored    PortalPromo[]

  @@index([login])
  @@index([iclassTeamLogin])
}

// SDD #5 sessions-management: real login sessions tied to RbacUser. tokenHash =
// sha256(jwt) (raw token never stored). revokedAt = null => active. Each request
// validates the session exists + is not revoked (stateful auth).
model Session {
  id         String    @id @default(uuid())
  rbacUserId String
  user       RbacUser  @relation(fields: [rbacUserId], references: [id], onDelete: Cascade)
  actorLogin String
  tokenHash  String    @unique
  ip         String?
  userAgent  String?
  loginAt    DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?
  // session-expiration: absolute cap = loginAt + 8h (== JWT MAX_AGE). Nullable
  // only for legacy rows; the migration backfills them. revokedAt=null AND
  // expiresAt>now AND lastSeenAt>now-1h => the session is "alive".
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([rbacUserId])
  @@index([revokedAt])
}

model RbacUserRole {
  userId    String
  roleId    String
  createdAt DateTime @default(now())
  user      RbacUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      RbacRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model RbacRolePermission {
  roleId       String
  permissionId String
  createdAt    DateTime       @default(now())
  role         RbacRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   RbacPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

// SDD #4 audit-log-mutations: immutable record of every mutation. Replaces the
// hand-curated AdminActivityLog (dropped in Phase 3). actorId is SET NULL on
// user delete, but actorLogin is a snapshot so the trail survives.
model AuditEvent {
  id           String    @id @default(uuid())
  actorId      String?
  actor        RbacUser? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorLogin   String
  method       String
  path         String
  action       String?
  entityType   String?
  entityId     String?
  beforeJson   Json?
  afterJson    Json?
  statusCode   Int
  errorMessage String?
  ip           String?
  createdAt    DateTime  @default(now())

  @@index([actorId])
  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([method])
}

// =============================================
// ICLASS DISPATCH AUDIT
// =============================================

model IClassDispatchAttempt {
  id     String        @id @default(uuid())
  taskId String
  task   ScheduledTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  /// success | node_not_found | rejected | unavailable | error
  outcome           String
  /// Domain error code (ICLASS_NODE_NOT_FOUND, ICLASS_REJECTED, ...) when outcome != success.
  errorCode         String?
  /// Human-readable error detail. Truncado en el caller si hace falta.
  errorMessage      String?
  /// Node code que se INTENTO. En fallo automatico por city = city normalizada; null si no aplica.
  attemptedNodeCode String?
  /// Node code que efectivamente RESOLVIO/uso (elegido en reenvio, o matcheado por city en exito).
  resolvedNodeCode  String?
  /// Actor que disparo el intento. Null para automaticos sin usuario; FK suelta (sin @relation a RbacUser).
  actorId           String?
  createdAt         DateTime @default(now())

  @@index([taskId, createdAt])
}

// =============================================
// UISP MIRROR DOMAIN
// =============================================

/// Mirror of UISP site data. Synced every 5min by UispSyncScheduler.
/// uispId is the UISP-internal UUID (used as the upsert key).
model UispSite {
  id            String    @id @default(uuid())
  uispId        String    @unique
  name          String
  status        String
  parentUispId  String?
  latitude      Float?
  longitude     Float?
  deviceCount   Int       @default(0)
  outageCount   Int       @default(0)
  contact       String?
  address       String?
  missingSince  DateTime?
  lastSyncAt    DateTime
  createdAt     DateTime  @default(now())
  updatedAt     DateTime

  @@index([status])
  @@index([missingSince])
}

/// Mirror of UISP device data. Synced every 5min by UispSyncScheduler.
/// uispSiteId is the UISP site UUID — intentionally NOT an @relation FK so upserts
/// are order-independent (sites and devices can be upserted in any order).
model UispDevice {
  id           String    @id @default(uuid())
  uispId       String    @unique
  uispSiteId   String
  name         String
  model        String
  modelName    String?
  type         String?
  role         String?
  mac          String?
  ip           String?
  firmware     String?
  status       String
  signal       Int?
  uptime       BigInt?
  lastSeenAt   DateTime?
  missingSince DateTime?
  /// contract-node-ap-auto-assign (Fase B, MIR-1): UISP device id del AP al que está asociada
  /// esta station (raw.attributes.apDevice.id). NO es FK interna. Sin índice: se consume vía
  /// listAll() -> Map en memoria, nunca WHERE por esta columna.
  apUispDeviceId String?
  lastSyncAt   DateTime
  createdAt    DateTime  @default(now())
  updatedAt    DateTime

  @@index([uispSiteId])
  @@index([status])
  @@index([missingSince])
}

/// Gigared Partners TV integration config (#47). Single-row (id = "singleton").
/// Empty apiKey means unconfigured. The full apiKey never leaves the API (masked to last4).
model GigaredConfig {
  id        String   @id @default("singleton")
  apiKey    String   @default("")
  baseUrl   String   @default("https://partners.gigaredsa.com.ar/api/v1")
  updatedAt DateTime @updatedAt
}

// =============================================
// RECAPTACIÓN (#80)
// =============================================

enum RecaptureLeadSource {
  churned_client
  csv
}

enum RecaptureLeadStatus {
  nuevo
  en_gestion
  contactado
  interesado
  recuperado
  descartado
}

enum RecaptureContactChannel {
  llamada
  whatsapp
  email
  sms
  otro
}

enum RecaptureContactOutcome {
  sin_respuesta
  contactado
  no_interesado
  interesado
  recuperado
  numero_erroneo
}

model RecaptureLead {
  id           String              @id @default(cuid())
  source       RecaptureLeadSource
  clientId     String?
  client       Client?             @relation(fields: [clientId], references: [id], onDelete: SetNull)
  contactName  String
  phone        String?
  email        String?
  status       RecaptureLeadStatus @default(nuevo)
  assigneeId   String?
  assignee     RbacUser?           @relation("RecaptureLeadAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
