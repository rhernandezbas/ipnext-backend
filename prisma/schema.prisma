datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// =============================================
// ADMIN DOMAIN
// =============================================

model Admin {
  id           String             @id @default(uuid())
  name         String
  email        String             @unique
  role         String // role-definition name (editable, backed by AdminRoleDefinition)
  status       AdminStatus        @default(active)
  twoFaEnabled Boolean            @default(false)
  twoFaSecret  String?
  lastLogin    DateTime?
  passwordHash String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  activityLogs AdminActivityLog[]
  sessions     AdminSession[]
  projectsLed  Project[]
}

enum AdminRole {
  superadmin
  admin
  viewer
  engineer
  financial_manager
  support_agent
  technician
}

enum AdminStatus {
  active
  inactive
}

model AdminActivityLog {
  id        String   @id @default(uuid())
  adminId   String
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  category  String
  action    String
  details   String?
  ip        String?
  createdAt DateTime @default(now())

  @@index([adminId])
  @@index([createdAt])
}

model AdminSession {
  id         String   @id @default(uuid())
  adminId    String
  admin      Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  ip         String
  userAgent  String?
  city       String?
  country    String?
  loginAt    DateTime @default(now())
  lastSeenAt DateTime @default(now())
  active     Boolean  @default(true)

  @@index([adminId])
}

model AdminRoleDefinition {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false)
  permissions Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("admin_role_definitions")
}

// =============================================
// FEATURE FLAGS
// =============================================

// Runtime feature flags persisted in DB, toggleable via admin API.
// First flag: `iclass-integration` (seeded OFF until validated in prod).
model FeatureFlag {
  key       String   @id
  enabled   Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

// =============================================
// CRM DOMAIN
// =============================================

enum LeadStatus {
  new_lead      @map("new")
  contacted
  qualified
  proposal_sent
  won
  lost
}

enum LeadSource {
  website
  referral
  cold_call
  social_media
  other
}

model Lead {
  id                String     @id @default(uuid())
  name              String
  email             String?
  phone             String?
  address           String?
  city              String?
  source            LeadSource @default(other)
  status            LeadStatus @default(new_lead)
  assignedTo        String?
  assignedToId      String?
  interestedIn      String?
  notes             String?
  followUpDate      DateTime?
  convertedAt       DateTime?
  convertedClientId String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@index([status])
}

model Partner {
  id           String           @id @default(uuid())
  name         String
  status       String           @default("active")
  primaryEmail String?
  phone        String?
  address      String?
  city         String?
  country      String?
  timezone     String?
  currency     String?
  logoUrl      String?
  clientCount  Int              @default(0)
  adminCount   Int              @default(0)
  comision     Float?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  projects     ProjectPartner[]
  tasks        ScheduledTask[]
}

// =============================================
// MESSAGING DOMAIN
// =============================================

model Message {
  id        String    @id @default(uuid())
  subject   String
  body      String
  fromId    String
  fromName  String
  toId      String?
  toName    String?
  clientId  String?
  channel   String    @default("internal")
  status    String    @default("unread")
  threadId  String?
  sentAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([clientId])
  @@index([status])
}

model Client {
  id               String          @id @default(uuid())
  splynxId         String?         @unique
  grClienteId      String?         @unique
  name             String
  email            String
  phone            String
  status           ClientStatus    @default(active)
  address          String?
  city             String?
  country          String?
  login            String          @unique
  customAttributes Json?
  // GR balance fields — null until first fetch; 0 = no debt
  balanceDue       Decimal?        @db.Decimal(12, 2)
  balanceCurrency  String?
  lastBalanceAt    DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  services         Service[]
  logs             ClientLog[]
  invoices         Invoice[]
  tasks            ScheduledTask[]
  tickets          Ticket[]

  @@index([status])
  @@index([email])
}

enum ClientStatus {
  active
  late
  blocked
  inactive
}

model Service {
  id           String          @id @default(uuid())
  clientId     String
  grContratoId String?         @unique
  type         String
  plan         String
  ip           String?
  status       String          @default("active")
  startDate    DateTime
  endDate      DateTime?
  address      String?
  lat          Float?
  lng          Float?
  createdAt    DateTime        @default(now())
  client       Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tasks        ScheduledTask[]

  @@index([clientId])
  @@index([status])
}

model ClientLog {
  id          String   @id @default(uuid())
  clientId    String
  timestamp   DateTime @default(now())
  eventType   String
  description String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

model Invoice {
  id           String        @id @default(uuid())
  number       String        @unique
  clientId     String
  customerName String
  issueDate    DateTime
  dueDate      DateTime
  amount       Decimal       @db.Decimal(12, 2)
  status       InvoiceStatus @default(pendiente)
  lineItems    Json
  createdAt    DateTime      @default(now())
  client       Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([status])
  @@index([dueDate])
}

enum InvoiceStatus {
  pagada
  pendiente
  vencida
}

model ClientComment {
  id         String   @id @default(uuid())
  clientId   String
  authorName String
  content    String
  createdAt  DateTime @default(now())

  @@index([clientId])
}

model Notification {
  id        String    @id @default(uuid())
  type      String
  title     String
  message   String
  severity  String    @default("info")
  read      Boolean   @default(false)
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())
}

// =============================================
// FINANCE DOMAIN
// =============================================

model CreditNote {
  id               String    @id @default(uuid())
  number           String    @unique
  clientId         String
  clientName       String
  amount           Float
  taxAmount        Float     @default(0)
  totalAmount      Float
  reason           String
  relatedInvoiceId String?
  status           String    @default("draft")
  notes            String?
  issuedAt         DateTime  @default(now())
  appliedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([clientId])
}

model ProformaInvoice {
  id                   String    @id @default(uuid())
  number               String    @unique
  clientId             String
  clientName           String
  items                Json
  subtotal             Float
  taxAmount            Float     @default(0)
  total                Float
  status               String    @default("draft")
  notes                String?
  issuedAt             DateTime  @default(now())
  validUntil           DateTime?
  convertedToInvoiceId String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([clientId])
}

model FinanceHistoryEvent {
  id          String   @id @default(uuid())
  type        String
  description String
  clientId    String
  clientName  String
  amount      Float?
  referenceId String?
  adminId     String
  adminName   String
  occurredAt  DateTime @default(now())

  @@index([clientId])
  @@index([occurredAt])
}

// =============================================
// SETTINGS DOMAIN
// =============================================

model SystemSettings {
  id            String   @id @default("singleton")
  companyName   String   @default("IPNEXT")
  timezone      String   @default("America/Argentina/Buenos_Aires")
  currency      String   @default("ARS")
  language      String   @default("es")
  dateFormat    String   @default("DD/MM/YYYY")
  invoicePrefix String   @default("FAC")
  supportEmail  String?
  website       String?
  updatedAt     DateTime @updatedAt
}

model EmailSettings {
  id           String   @id @default("singleton")
  smtpHost     String?
  smtpPort     Int      @default(587)
  smtpUser     String?
  smtpPassword String?
  fromName     String?
  fromEmail    String?
  useTls       Boolean  @default(true)
  updatedAt    DateTime @updatedAt
}

model MessageTemplate {
  id        String   @id @default(uuid())
  name      String
  type      String
  subject   String?
  body      String
  variables Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ApiToken {
  id          String    @id @default(uuid())
  name        String
  token       String    @unique
  permissions Json
  lastUsed    DateTime?
  createdAt   DateTime  @default(now())
}

model PaymentMethod {
  id      String  @id @default(uuid())
  name    String
  type    String
  enabled Boolean @default(true)
  config  Json?
}

model Webhook {
  id            String    @id @default(uuid())
  name          String
  url           String
  events        Json
  secret        String?
  status        String    @default("active")
  lastTriggered DateTime?
  lastStatus    String?
  createdAt     DateTime  @default(now())
}

model BackupRecord {
  id          String   @id @default(uuid())
  filename    String
  sizeBytes   Int
  type        String   @default("manual")
  status      String   @default("completed")
  downloadUrl String?
  createdAt   DateTime @default(now())
}

model ClientPortalSettings {
  id                       String   @id @default("singleton")
  enabled                  Boolean  @default(false)
  portalUrl                String?
  allowSelfRegistration    Boolean  @default(false)
  requireEmailVerification Boolean  @default(true)
  allowPaymentOnline       Boolean  @default(false)
  allowTicketCreation      Boolean  @default(true)
  allowServiceManagement   Boolean  @default(false)
  welcomeMessage           String?
  logoUrl                  String?
  primaryColor             String   @default("#3B82F6")
  customCss                String?
  updatedAt                DateTime @updatedAt
}

// =============================================
// SCHEDULING DOMAIN
// =============================================

enum StageCategory {
  nuevo
  enProgreso
  hecho
}

model Workflow {
  id          String    @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  stages      Stage[]
  projects    Project[]
}

model Stage {
  id         String          @id @default(uuid())
  workflowId String
  workflow   Workflow        @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  name       String
  category   StageCategory
  order      Int
  color      String?
  tasks      ScheduledTask[]

  // IClass closure loop — result codes that move a task to THIS stage on closure
  iclassResultCodes IClassResultCode[] @relation("ResultCodeMappedStage")

  @@index([workflowId, order])
}

model ProjectCategory {
  id          String    @id @default(uuid())
  name        String
  description String?
  projects    Project[]
}

// Editable catalog of task categories. ScheduledTask.category stores the name
// (free text), so there is no FK relation here — the catalog drives the UI dropdown.
model TaskCategory {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("TaskCategory")
}

// Editable catalog of task priorities, with a colour and a sort weight.
// ScheduledTask.priority stores the name (free text).
model TaskPriority {
  id        String   @id @default(uuid())
  name      String   @unique
  color     String
  weight    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("TaskPriority")
}

model ProjectType {
  id          String    @id @default(uuid())
  name        String
  description String?
  projects    Project[]
}

model IClassSoType {
  id           String    @id @default(uuid())
  code         String    @unique
  description  String
  active       Boolean   @default(true)
  lastSyncedAt DateTime
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  projects     Project[]

  @@index([active])
}

// ============================================================================
// IClass closure loop — mirror of CLOSED service orders pulled back from IClass.
// Join to local work: SO.codigo (iclass) == ScheduledTask.sequenceNumber (we send
// soCode=sequenceNumber on create; iclass preserves it as `codigo`).
// ============================================================================

// Catalog of result codes per SO type. `motivoFechamento` on a closed SO equals
// the result-code name (`code`); `type` (Sucesso/Falha) drives the stage transition.
model IClassResultCode {
  id           String   @id @default(uuid())
  soTypeId     BigInt?
  code         String   // motivoFechamento value (the result-code name)
  type         String   // Sucesso | Falha | ...
  // Configurable closure mapping (mirrors Project.iclassSoTypeId): when an SO closes
  // with this result code, the linked task is moved to mappedStage. Null = unmapped
  // (task is NOT moved; left for manual review). Assigned via the admin API/UX.
  mappedStageId String?
  mappedStage   Stage?   @relation("ResultCodeMappedStage", fields: [mappedStageId], references: [id], onDelete: SetNull)
  lastSyncedAt DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([soTypeId, code])
  @@index([code])
  @@index([mappedStageId])
}

model IClassServiceOrder {
  id                String  @id @default(cuid())
  iclassId          BigInt  @unique // numeric SO id from IClass
  iclassCodigo      String  @unique // SO `codigo`; equals our ScheduledTask.sequenceNumber for our SOs
  clusterName       String
  thirdPartyCode    String?
  nodeCode          String?
  soTypeDescription String?

  customerCode String?
  customerName String?
  addressCode  String?
  addressLine  String?
  addressCity  String?
  addressLat   Float?
  addressLng   Float?

  statusCode        String // '7' for terminal Concluida
  statusDescription String

  requestedAt      DateTime?
  scheduledFor     DateTime?
  availableAt      DateTime?
  serviceStartedAt DateTime?
  serviceEndedAt   DateTime?
  firstClosedAt    DateTime? // status 4 transition (technician close)
  approvedAt       DateTime? // status 50 transition
  closedAt         DateTime? // status 7 transition (final) — derived from history

  resultCodeName String? // motivoFechamento
  resultCodeType String? // joined from IClassResultCode (Sucesso/Falha)
  closedByLogin  String?
  closedByName   String?
  closeLatitude  Float?
  closeLongitude Float?
  closeGpsAt     DateTime?
  billingAmount  Decimal?  @db.Decimal(12, 2)

  technicianNote String? @db.Text // obsEquipe
  internalNote   String? @db.Text // obs
  commentaryLog  String? @db.Text // raw comentario blob

  teamLogin          String?
  teamTechnicianName String?
  teamPhone          String?
  teamEmail          String?

  // Link back to our task (matched by codigo↔sequenceNumber). Nullable: an SO with
  // no local match is skipped, but the FK stays optional for resilience.
  scheduledTaskId String?        @unique
  scheduledTask   ScheduledTask? @relation(fields: [scheduledTaskId], references: [id], onDelete: SetNull)

  iclassCreatedAt DateTime?
  iclassUpdatedAt DateTime? // alteradoPor.data — idempotency key
  ingestedAt      DateTime  @default(now())
  rawDetail       Json // full SO snapshot for forensics

  history          IClassSoStatusHistory[]
  checklists       IClassSoChecklist[]
  materials        IClassSoMaterial[]
  equipmentEvents  IClassSoEquipmentEvent[]

  @@index([clusterName, closedAt])
  @@index([customerCode])
  @@index([iclassUpdatedAt])
  @@index([scheduledTaskId])
}

model IClassSoStatusHistory {
  id               String             @id @default(cuid())
  serviceOrderId   String
  serviceOrder     IClassServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  iclassOsStatusId BigInt             @unique
  occurredAt       DateTime
  statusCode       String
  statusDescription String
  durationMinutes  Int?
  teamLogin        String?
  commentary       String?            @db.Text

  @@index([serviceOrderId, occurredAt])
}

model IClassSoChecklist {
  id             String                    @id @default(cuid())
  serviceOrderId String
  serviceOrder   IClassServiceOrder        @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  iclassSurveyId BigInt                    @unique
  surveyAt       DateTime?
  answers        IClassSoChecklistAnswer[]
}

model IClassSoChecklistAnswer {
  id           String            @id @default(cuid())
  checklistId  String
  checklist    IClassSoChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  questionId   BigInt?
  questionText String            @db.Text
  questionType String // 'Texto' | 'Foto' | ...
  answerOrder  Int
  answerText   String?           @db.Text
  photoMissing Boolean           @default(false) // true for questionType=Foto (v2 returns no URL)

  @@index([checklistId, answerOrder])
}

model IClassSoMaterial {
  id                  String             @id @default(cuid())
  serviceOrderId      String
  serviceOrder        IClassServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  iclassOsMaterialId  BigInt             @unique
  materialCode        String?
  materialDescription String?
  qty                 Decimal            @db.Decimal(12, 4)
  unitValue           Decimal?           @db.Decimal(12, 2)
  totalValue          Decimal?           @db.Decimal(12, 2)
}

model IClassSoEquipmentEvent {
  id               String             @id @default(cuid())
  serviceOrderId   String
  serviceOrder     IClassServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  occurredAt       DateTime?
  type             String? // install | remove | move
  serialNumber     String?
  mac              String?
  patrimonialNo    String?
  modelDescription String?

  @@index([serviceOrderId])
}

model Project {
  id             String           @id @default(uuid())
  title          String
  description    String?
  typeId         String?
  type           ProjectType?     @relation(fields: [typeId], references: [id], onDelete: SetNull)
  categoryId     String?
  category       ProjectCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  workflowId     String?
  workflow       Workflow?        @relation(fields: [workflowId], references: [id], onDelete: SetNull)
  projectLeadId  String?
  projectLead    Admin?           @relation(fields: [projectLeadId], references: [id], onDelete: SetNull)
  visible        Boolean          @default(true)
  partners       ProjectPartner[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  tasks          ScheduledTask[]
  iclassSoTypeId String?
  iclassSoType   IClassSoType?    @relation(fields: [iclassSoTypeId], references: [id], onDelete: SetNull)

  // GR ingest config back-relations (fiber / wireless target project mappings)
  grIngestFiber    GestionRealIngestConfig[] @relation("GrIngestFiber")
  grIngestWireless GestionRealIngestConfig[] @relation("GrIngestWireless")

  @@index([title])
  @@index([categoryId])
  @@index([typeId])
  @@index([workflowId])
  @@index([projectLeadId])
  @@index([visible])
  @@index([iclassSoTypeId])
}

model ProjectPartner {
  projectId String
  partnerId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Restrict)

  @@id([projectId, partnerId])
  @@index([partnerId])
}

model ScheduledTask {
  id             String    @id @default(uuid())
  sequenceNumber Int       @unique @default(autoincrement())
  title          String
  description    String?
  stageId        String
  stage          Stage     @relation(fields: [stageId], references: [id], onDelete: Restrict)
  priority       String    @default("normal")
  estimatedHours Float     @default(1)
  address        String?
  lat            Float?
  lng            Float?
  category       String    @default("installation")
  notes          String?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  projectId      String?
  project        Project?  @relation(fields: [projectId], references: [id])

  // NEW — datetime envelope
  startDate DateTime?
  endDate   DateTime?

  // NEW — FK relations
  customerId String?
  customer   Client?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  serviceId  String?
  service    Service?  @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  partnerId  String?
  partnerRef Partner?  @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  reporterId String?
  reporter   RbacUser? @relation("TaskReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  assigneeId String?
  assignee   RbacUser? @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  // NEW — travel time (minutes)
  travelTimeTo   Int?
  travelTimeFrom Int?

  // NEW — watchers pivot back-relation
  watchers TaskWatcher[]

  // NEW — checklist back-relation
  checklist TaskChecklistItem[]

  // NEW — comments back-relation
  comments TaskComment[]

  // Flag: task is closed (soft-close, not deleted)
  isClosed Boolean @default(false)

  // RV — inventory team review flag
  reviewedByInventory Boolean @default(false)

  // IClass — service order code returned when the task is sent to IClass
  iclassOrderCode String?

  // Gestión Real — upstream service order id this task was ingested from.
  // Null for manually-created tasks. NULL-distinct unique = idempotency backstop.
  grOrdenId String? @unique

  // IClass closure loop — mirror of the closed SO, linked back by codigo↔sequenceNumber
  iclassClosedOrder IClassServiceOrder?

  @@index([stageId])
  @@index([projectId])
  @@index([startDate])
  @@index([endDate])
  @@index([customerId])
  @@index([serviceId])
  @@index([partnerId])
  @@index([assigneeId])
  @@index([reporterId])
}

model TaskWatcher {
  taskId  String
  adminId String
  task    ScheduledTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user    RbacUser      @relation("TaskWatcher", fields: [adminId], references: [id], onDelete: Cascade)

  @@id([taskId, adminId])
  @@index([adminId])
}

model TaskTemplate {
  id          String             @id @default(uuid())
  name        String             @unique
  description String?
  category    String             @default("other")
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  items       TaskTemplateItem[]
}

model TaskTemplateItem {
  id              String              @id @default(uuid())
  templateId      String
  template        TaskTemplate        @relation(fields: [templateId], references: [id], onDelete: Cascade)
  text            String
  order           Int
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  checklistCopies TaskChecklistItem[]

  @@index([templateId, order])
}

model TaskChecklistItem {
  id                 String            @id @default(uuid())
  taskId             String
  task               ScheduledTask     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  text               String
  done               Boolean           @default(false)
  order              Int
  fromTemplateItemId String?
  fromTemplateItem   TaskTemplateItem? @relation(fields: [fromTemplateItemId], references: [id], onDelete: SetNull)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([taskId, order])
}

model TaskComment {
  id          String                  @id @default(uuid())
  taskId      String
  task        ScheduledTask           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorName  String
  body        String
  createdAt   DateTime                @default(now())
  attachments TaskCommentAttachment[]

  @@index([taskId])
}

model TaskCommentAttachment {
  id        String      @id @default(uuid())
  commentId String
  comment   TaskComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  url       String
  filename  String
  mimeType  String?
  sizeBytes Int?

  @@index([commentId])
}

// =============================================
// VOIP DOMAIN
// =============================================

model VoipCategory {
  id             String @id @default(uuid())
  name           String
  prefix         String
  pricePerMinute Float
  freeMinutes    Int    @default(0)
  status         String @default("active")
}

model VoipCdr {
  id           String   @id @default(uuid())
  clientId     String
  clientName   String
  callerNumber String
  calledNumber String
  duration     Int
  categoryId   String?
  categoryName String?
  cost         Float    @default(0)
  status       String   @default("answered")
  startedAt    DateTime @default(now())

  @@index([clientId])
  @@index([startedAt])
}

model VoipPlan {
  id              String @id @default(uuid())
  name            String
  monthlyPrice    Float
  includedMinutes Int    @default(0)
  categories      Json
  status          String @default("active")
}

// =============================================
// NETWORK DOMAIN
// =============================================

model ServicePlan {
  id              String  @id @default(uuid())
  name            String
  type            String
  planSubtype     String?
  downloadSpeed   Int?
  uploadSpeed     Int?
  price           Float
  billingCycle    String  @default("monthly")
  status          String  @default("active")
  description     String?
  subscriberCount Int     @default(0)
}

model NetworkDevice {
  id         String    @id @default(uuid())
  name       String
  type       String
  ipAddress  String?
  macAddress String?
  location   String?
  status     String    @default("online")
  model      String?
  lastSeen   DateTime?
  createdAt  DateTime  @default(now())
}

model InventoryItem {
  id        String  @id @default(uuid())
  name      String
  category  String
  sku       String?
  quantity  Int     @default(0)
  minStock  Int     @default(0)
  unitPrice Float   @default(0)
  supplier  String?
  location  String?
  status    String  @default("in_stock")
}

model InventoryProduct {
  id          String          @id @default(uuid())
  name        String
  category    String
  sku         String?
  description String?
  unitPrice   Float
  supplier    String?
  totalStock  Int             @default(0)
  minStock    Int             @default(0)
  status      String          @default("in_stock")
  units       InventoryUnit[]
}

model InventoryUnit {
  id                 String           @id @default(uuid())
  productId          String
  product            InventoryProduct @relation(fields: [productId], references: [id])
  serialNumber       String?
  barcode            String?
  status             String           @default("available")
  location           String?
  purchaseDate       DateTime?
  purchasePrice      Float?
  assignedToClientId String?
  assignedAt         DateTime?
  notes              String?

  @@index([productId])
}

model IpNetwork {
  id          String   @id @default(uuid())
  name        String
  network     String
  status      String   @default("active")
  description String?
  gateway     String?
  dns1        String?
  dns2        String?
  pools       IpPool[]
  createdAt   DateTime @default(now())
}

model IpPool {
  id          String         @id @default(uuid())
  networkId   String
  network     IpNetwork      @relation(fields: [networkId], references: [id])
  name        String
  rangeStart  String
  rangeEnd    String
  status      String         @default("active")
  assignments IpAssignment[]

  @@index([networkId])
}

model IpAssignment {
  id         String    @id @default(uuid())
  poolId     String
  pool       IpPool    @relation(fields: [poolId], references: [id])
  ipAddress  String
  clientId   String?
  clientName String?
  assignedAt DateTime  @default(now())
  releasedAt DateTime?

  @@index([poolId])
  @@index([clientId])
}

model NetworkSite {
  id           String        @id @default(uuid())
  name         String
  address      String?
  city         String?
  lat          Float?
  lng          Float?
  type         String        @default("nodo")
  status       String        @default("active")
  deviceCount  Int           @default(0)
  clientCount  Int           @default(0)
  uplink       String?
  parentSiteId String?
  parent       NetworkSite?  @relation("SiteHierarchy", fields: [parentSiteId], references: [id])
  children     NetworkSite[] @relation("SiteHierarchy")
  description  String?
  createdAt    DateTime      @default(now())
}

model NasServer {
  id           String    @id @default(uuid())
  name         String
  type         String
  ipAddress    String
  radiusSecret String?
  nasIpAddress String?
  apiPort      Int?
  apiLogin     String?
  apiPassword  String?
  status       String    @default("active")
  lastSeen     DateTime?
  clientCount  Int       @default(0)
  description  String?
  createdAt    DateTime  @default(now())
}

model RadiusConfig {
  id                    String  @id @default("singleton")
  authPort              Int     @default(1812)
  acctPort              Int     @default(1813)
  coaPort               Int     @default(3799)
  sessionTimeout        Int     @default(86400)
  idleTimeout           Int     @default(3600)
  interimUpdateInterval Int     @default(300)
  nasType               String  @default("other")
  enableCoa             Boolean @default(true)
  enableAccounting      Boolean @default(true)
}

model RadiusSession {
  id            String   @id @default(uuid())
  sessionId     String   @unique
  clientId      String
  clientName    String
  nasId         String?
  nasName       String?
  ipAddress     String?
  macAddress    String?
  startedAt     DateTime @default(now())
  duration      Int      @default(0)
  downloadBytes BigInt   @default(0)
  uploadBytes   BigInt   @default(0)
  downloadMbps  Float    @default(0)
  uploadMbps    Float    @default(0)
  status        String   @default("active")
  username      String?

  @@index([clientId])
}

model CpeDevice {
  id              String    @id @default(uuid())
  serialNumber    String?
  model           String?
  manufacturer    String?
  type            String
  macAddress      String?
  ipAddress       String?
  status          String    @default("unconfigured")
  clientId        String?
  clientName      String?
  nasId           String?
  networkSiteId   String?
  firmwareVersion String?
  lastSeen        DateTime?
  signal          Float?
  connectedAt     DateTime?
  description     String?
  createdAt       DateTime  @default(now())

  @@index([clientId])
}

model OltDevice {
  id           String      @id @default(uuid())
  name         String
  ipAddress    String?
  model        String?
  manufacturer String?
  uplink       String?
  ponPorts     Int         @default(0)
  totalOnus    Int         @default(0)
  onlineOnus   Int         @default(0)
  status       String      @default("online")
  lastSeen     DateTime?
  onus         OnuDevice[]
  createdAt    DateTime    @default(now())
}

model OnuDevice {
  id              String    @id @default(uuid())
  serialNumber    String?
  model           String?
  oltId           String
  olt             OltDevice @relation(fields: [oltId], references: [id])
  ponPort         Int?
  onuId           Int?
  clientId        String?
  clientName      String?
  status          String    @default("unconfigured")
  rxPower         Float?
  txPower         Float?
  distance        Float?
  firmwareVersion String?
  lastSeen        DateTime?
  createdAt       DateTime  @default(now())

  @@index([oltId])
  @@index([clientId])
}

model Tr069Profile {
  id                String        @id @default(uuid())
  name              String
  manufacturerModel String?
  description       String?
  config            Json
  status            String        @default("active")
  devices           Tr069Device[]
}

model Tr069Device {
  id              String        @id @default(uuid())
  deviceId        String
  clientId        String?
  clientName      String?
  profileId       String?
  profile         Tr069Profile? @relation(fields: [profileId], references: [id])
  lastProvisioned DateTime?
  status          String        @default("unconfigured")
  createdAt       DateTime      @default(now())

  @@index([clientId])
}

model HardwareAsset {
  id            String    @id @default(uuid())
  name          String
  type          String
  manufacturer  String?
  model         String?
  serialNumber  String?
  purchaseDate  DateTime?
  purchasePrice Float?
  location      String?
  status        String    @default("in_use")
  warranty      String?
  assignedTo    String?
  notes         String?
  createdAt     DateTime  @default(now())
}

model Ubicacion {
  id          String      @id @default(uuid())
  name        String
  city        String?
  address     String?
  province    String?
  country     String      @default("Argentina")
  lat         Float?
  lng         Float?
  type        String?
  status      String      @default("active")
  managerName String?
  clientCount Int         @default(0)
  timezone    String?
  parentId    String?
  parent      Ubicacion?  @relation("UbicacionHierarchy", fields: [parentId], references: [id])
  children    Ubicacion[] @relation("UbicacionHierarchy")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model DashboardStat {
  id                  String   @id @default("singleton")
  newClientsThisMonth Int      @default(0)
  activeClients       Int      @default(0)
  openTickets         Int      @default(0)
  pendingTickets      Int      @default(0)
  unresponsiveDevices Int      @default(0)
  onlineDevices       Int      @default(0)
  revenueThisMonth    Float    @default(0)
  unpaidInvoices      Int      @default(0)
  overdueInvoices     Int      @default(0)
  cpuUsage            Float    @default(0)
  ramUsage            Float    @default(0)
  diskUsage           Float    @default(0)
  uptime              String   @default("0d 0h")
  updatedAt           DateTime @updatedAt
}

// =============================================
// IPV6 DOMAIN
// =============================================

model Ipv6Network {
  id          String   @id @default(uuid())
  name        String
  network     String
  type        String   @default("global")
  status      String   @default("active")
  description String?
  assignedTo  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// =============================================
// FINANCE SETTINGS
// =============================================

model FinanceSettings {
  id                   String   @id @default("singleton")
  invoiceDueDays       Int      @default(10)
  taxName              String   @default("IVA")
  taxRate              Float    @default(21)
  taxIncluded          Boolean  @default(false)
  autoGenerateInvoices Boolean  @default(true)
  invoiceDay           Int      @default(1)
  lateFeeEnabled       Boolean  @default(false)
  lateFeeAmount        Float    @default(0)
  lateFeeDays          Int      @default(30)
  reminderDays         Json     @default("[7, 3, 1]")
  currency             String   @default("ARS")
  currencySymbol       String   @default("$")
  updatedAt            DateTime @updatedAt
}

// =============================================
// MONITORING DOMAIN
// =============================================

model MonitoringDevice {
  id            String    @id @default(uuid())
  name          String
  ipAddress     String?
  type          String
  status        String    @default("online")
  lastSeen      DateTime?
  uptimePercent Float?
  location      String?
  createdAt     DateTime  @default(now())
}

model MonitoringAlert {
  id             String    @id @default(uuid())
  deviceId       String?
  type           String
  severity       String    @default("warning")
  message        String
  acknowledged   Boolean   @default(false)
  acknowledgedAt DateTime?
  acknowledgedBy String?
  createdAt      DateTime  @default(now())

  @@index([acknowledged])
}

/// Watermark/cursor store for incremental syncs (e.g. the Gestión Real mirror).
model SyncState {
  entity      String    @id
  cursor      String?
  lastRunAt   DateTime?
  lastResult  String?
  itemsSynced Int       @default(0)
  updatedAt   DateTime  @updatedAt
}

/// Editable, single-row config for the Gestión Real installation-order ingest.
/// Single row enforced via a constant id ("singleton").
model GestionRealIngestConfig {
  id                String   @id @default("singleton")
  intervalMs        Int      @default(180000)
  windowMonths      Int      @default(12)
  fiberProjectId    String?
  fiberProject      Project? @relation("GrIngestFiber", fields: [fiberProjectId], references: [id], onDelete: SetNull)
  wirelessProjectId String?
  wirelessProject   Project? @relation("GrIngestWireless", fields: [wirelessProjectId], references: [id], onDelete: SetNull)
  updatedAt         DateTime @updatedAt

  @@index([fiberProjectId])
  @@index([wirelessProjectId])
}

// =============================================
// SUPPORT DOMAIN
// =============================================

// Phase 2 complete: TicketStatus enum dropped; Ticket.status is now a FK → TicketStatusCatalog.
// The API still exposes status as a string (the catalog name) — see PrismaTicketRepository.
model TicketStatusCatalog {
  id        String   @id @default(uuid())
  name      String   @unique
  color     String
  weight    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tickets   Ticket[]

  @@map("TicketStatusCatalog")
}

enum TicketPriority {
  low
  medium
  high
}

model Ticket {
  id          String @id @default(uuid())
  subject     String
  description String

  // Phase 2: status is now a FK to TicketStatusCatalog.
  // The API still exposes `status` as the catalog name string (not the id).
  statusId String
  status   TicketStatusCatalog @relation(fields: [statusId], references: [id], onUpdate: Cascade, onDelete: Restrict)

  priority TicketPriority @default(medium)

  // FK al cliente — espejo de ScheduledTask.customerId
  customerId String?
  customer   Client? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  // Asignacion opcional a un RbacUser — espejo de ScheduledTask.assigneeId
  assigneeId String?
  assignee   RbacUser? @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  // Previsto para la futura integracion de "casos" de Gestion Real (out-of-scope)
  grCasoId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([statusId])
  @@index([assigneeId])
}

// =============================================
// RBAC DOMAIN
// =============================================

// RbacAction enum removed — action is now VARCHAR(64) to allow sub-actions without migrations.
// TS source-of-truth: KNOWN_ACTIONS in src/domain/entities/rbac.ts

model RbacModule {
  id          String           @id @default(uuid())
  code        String           @unique
  label       String
  createdAt   DateTime         @default(now())
  permissions RbacPermission[]
}

model RbacPermission {
  id       String               @id @default(uuid())
  moduleId String
  action   String               @db.VarChar(64)
  module   RbacModule           @relation(fields: [moduleId], references: [id], onDelete: Restrict)
  grants   RbacRolePermission[]

  @@unique([moduleId, action])
  @@index([moduleId])
}

model RbacRole {
  id          String               @id @default(uuid())
  code        String               @unique
  label       String
  description String?
  isSystem    Boolean              @default(false)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  users       RbacUserRole[]
  permissions RbacRolePermission[]
}

model RbacUser {
  id              String          @id @default(uuid())
  name            String
  email           String          @unique
  login           String          @unique
  passwordHash    String
  status          String          @default("active")
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  lastLoginAt     DateTime?
  roles           RbacUserRole[]
  tasksReported   ScheduledTask[] @relation("TaskReporter")
  tasksAssigned   ScheduledTask[] @relation("TaskAssignee")
  tasksWatching   TaskWatcher[]   @relation("TaskWatcher")
  assignedTickets Ticket[]        @relation("TicketAssignee")

  @@index([login])
}

model RbacUserRole {
  userId    String
  roleId    String
  createdAt DateTime @default(now())
  user      RbacUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      RbacRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model RbacRolePermission {
  roleId       String
  permissionId String
  createdAt    DateTime       @default(now())
  role         RbacRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   RbacPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}
